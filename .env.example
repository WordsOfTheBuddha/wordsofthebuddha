# Polar no-code checkout (production). Public URL — safe for the client.
# Also set these on Vercel for production deploys.
PUBLIC_POLAR_CHECKOUT_LINK=https://buy.polar.sh/polar_cl_6bQGBy5AKcGhw1gk9ug1j409wbNPwwbkdNmie3TtXYX

# Optional: override product preselect (Polar dashboard → product ⋮ → Copy Product ID).
# Defaults in src/data/support.ts match the production Donate / Donate Monthly products.
# PUBLIC_POLAR_PRODUCT_ID_ONCE=
# PUBLIC_POLAR_PRODUCT_ID_MONTHLY=

# Optional server token — not needed for checkout links.
# Required only for Checkout API, Customer Portal, or webhooks.
# POLAR_ACCESS_TOKEN=
# POLAR_SUCCESS_URL=https://www.wordsofthebuddha.org/success?checkout_id={CHECKOUT_ID}

# Vercel Web Analytics — server/build only (Support page reach sentence).
# Never prefix with PUBLIC_. On Vercel, also set VERCEL_TOKEN in project env.
# VERCEL_PROJECT_ID is injected automatically on Vercel builds.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# VERCEL_TEAM_SLUG=

# OpenRouter (server only). Never prefix the key with PUBLIC_.
# OPENROUTER_API_KEY=
# Optional override of the default free model (must end in :free).
# Used when the picker is hidden. Picker itself only lists curated models.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Show the curated free-model picker (1) or hide it everywhere (0 / false).
# PUBLIC_AI_SHOW_MODEL_PICKER=0
# Comma-separated emails allowed to view /admin/ask (Ask telemetry + feedback).
# ASK_ADMIN_EMAILS=you@example.com

# Gemini Developer API (server only). Used to re-rank Ask results, and as a
# rewrite fallback when OpenRouter rate-limits. Never prefix with PUBLIC_.
# Free-tier RPD varies by model/account (often ~500/day for Flash-Lite).
# When Gemini rerank hits quota, Ask falls back to OPENROUTER_MODEL.
# Check Google AI Studio for your project’s live quota.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RERANK_MODEL=gemini-3.5-flash-lite
