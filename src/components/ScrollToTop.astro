---
// ScrollToTop.astro - Button that appears when scrolling up and allows users to return to top
import ChevronUp from "../assets/chevron-up.svg?raw";
---

<button
	id="scroll-to-top"
	aria-label="Scroll to top"
	class="scroll-to-top-button fixed bottom-4 right-4 p-2 rounded-full opacity-0 invisible transition-all duration-300 z-50"
>
	<span class="icon-container" set:html={ChevronUp} />
</button>

<style>
	.scroll-to-top-button {
		background: var(--background-color);
	}

	.icon-container {
		display: block;
		width: 24px;
		height: 24px;
	}

	.icon-container :global(svg) {
		width: 100%;
		height: 100%;
		stroke: var(--primary-color);
		opacity: 0.8; /* 20% transparency (80% opacity) */
		filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
	}

	/* Special hover effect */
	.scroll-to-top-button:hover {
		transform: translateY(-3px);
	}
</style>

<script>
	const SCROLL_THRESHOLD_PX = 300;
	const scrollToTopButton = document.getElementById("scroll-to-top");
	let lastScrollPosition = window.scrollY;
	let ticking = false;

	function footerIsInView() {
		const footer = document.getElementById("site-footer");
		if (!footer) return false;
		const rect = footer.getBoundingClientRect();
		return rect.top < window.innerHeight && rect.bottom > 0;
	}

	function setButtonVisible(visible: boolean) {
		if (!scrollToTopButton) return;
		if (visible) {
			scrollToTopButton.classList.remove("opacity-0", "invisible");
			scrollToTopButton.classList.add("opacity-100", "visible");
		} else {
			scrollToTopButton.classList.add("opacity-0", "invisible");
			scrollToTopButton.classList.remove("opacity-100", "visible");
		}
	}

	function handleScroll() {
		const currentScrollPosition = window.scrollY;
		const isScrollingUp = lastScrollPosition > currentScrollPosition;

		// Show only after scrolling down, while scrolling up, and after the
		// footer has left the viewport so the arrow cannot cover Give.
		const shouldShow =
			currentScrollPosition > SCROLL_THRESHOLD_PX &&
			isScrollingUp &&
			!footerIsInView();

		setButtonVisible(shouldShow);

		lastScrollPosition = currentScrollPosition;
		ticking = false;
	}

	// Throttle scroll events
	function onScroll() {
		if (!ticking) {
			window.requestAnimationFrame(handleScroll);
			ticking = true;
		}
	}

	// Scroll to top when button is clicked
	scrollToTopButton?.addEventListener("click", () => {
		window.scrollTo({
			top: 0,
			behavior: "smooth",
		});
	});

	window.addEventListener("scroll", onScroll, { passive: true });
	window.addEventListener("resize", onScroll);
	handleScroll();
</script>
