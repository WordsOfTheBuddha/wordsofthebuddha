---
import CoverImage from "./CoverImage.astro";
import { getPublishedAnthologies } from "../utils/anthologies";

interface Props {
	/** Cap the number of cards (published anthologies, in `order`). */
	limit?: number;
}

const { limit } = Astro.props;

const published = await getPublishedAnthologies();
const anthologies = limit ? published.slice(0, limit) : published;
---

{
	anthologies.length > 0 && (
		<div class="anthology-grid">
			{anthologies.map((a) => (
				<a
					href={`/anthologies/${a.data.slug}`}
					class="anthology-card no-underline"
				>
					<span class="anthology-cover" aria-hidden="true">
						<CoverImage
							src={a.data.imagePath}
							alt=""
							variant="shelf"
							class="anthology-thumb"
							loading="lazy"
						/>
					</span>
					<span class="anthology-copy">
						<span class="anthology-title">{a.data.title}</span>
						{a.data.author && (
							<span class="anthology-author">{a.data.author}</span>
						)}
						{a.data.description && (
							<span class="anthology-desc">{a.data.description}</span>
						)}
					</span>
				</a>
			))}
		</div>
	)
}

<style>
	.anthology-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 0.75rem;
	}

	.anthology-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.875rem;
		border-radius: 0.75rem;
		border: 1px solid var(--surface-border);
		background: var(--surface-elevated);
		color: var(--text-color);
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.anthology-card:hover {
		box-shadow: 0 4px 12px color-mix(in srgb, #000 14%, transparent);
		transform: translateY(-1px);
	}

	@media (prefers-reduced-motion: reduce) {
		.anthology-card {
			transition: none;
		}
		.anthology-card:hover {
			transform: none;
		}
	}

	/* The cover sets the card's height; the text block is clamped to fit it. */
	.anthology-cover {
		flex-shrink: 0;
		display: block;
		width: 5.25rem;
		height: 7.5rem;
	}

	.anthology-cover :global(picture),
	.anthology-cover :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
		object-position: center top;
		border-radius: 0.2rem;
		box-shadow: 1px 2px 5px color-mix(in srgb, #000 18%, transparent);
	}

	.anthology-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
		min-width: 0;
		max-height: 7.5rem;
		overflow: hidden;
	}

	.anthology-title {
		font-family: "Spectral", serif;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.25;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.anthology-author {
		font-size: 0.75rem;
		line-height: 1.3;
		color: var(--text-muted);
	}

	.anthology-desc {
		font-size: 0.78rem;
		line-height: 1.35;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
