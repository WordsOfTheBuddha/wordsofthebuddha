---
import { getCollection, type CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
import { getGitTimestamps } from "../utils/getLastModified";
import { getPtsDisplay } from "../utils/ptsReferences";
import {
	buildRecentFeeds,
	collectionFromEnglishPath,
	DEFAULT_RECENT_FILTERS,
	filterRecentDiscourses,
	isEnglishDiscoursePath,
} from "../utils/recentDiscourses";

interface Props {
	n?: number;
}

const { n = 5 } = Astro.props;

const allDiscourses = await getCollection("all");
const records = allDiscourses
	.filter(
		(discourse: CollectionEntry<"all">) =>
			Boolean(discourse.filePath) &&
			isEnglishDiscoursePath(discourse.filePath ?? "") &&
			discourse.data.description,
	)
	.map((discourse: CollectionEntry<"all">) => {
		const { added, modified } = getGitTimestamps(discourse.filePath ?? "");
		return {
			slug: discourse.data.slug,
			title: discourse.data.title,
			description: discourse.data.description ?? "",
			collection: collectionFromEnglishPath(
				discourse.filePath ?? "",
				discourse.data.slug,
			),
			added,
			modified,
			volpage: getPtsDisplay(discourse.data.slug) || undefined,
		};
	});

const latestDiscourses = filterRecentDiscourses(
	buildRecentFeeds(records),
	DEFAULT_RECENT_FILTERS,
).slice(0, n);
---

<div class="px-2">
	{
		latestDiscourses.map((discourse) => (
			<PostCard
				title={discourse.title}
				description={discourse.description}
				id={discourse.slug}
				volpage={discourse.volpage}
				lastUpdated={discourse.added}
				badge="new"
			/>
		))
	}
</div>
