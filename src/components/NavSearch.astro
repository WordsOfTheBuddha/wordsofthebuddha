---
/**
 * Compact navbar search from tablet up. Same gateway as the homepage:
 * unique discourse ID navigates; otherwise /search.
 *
 * Collapsed: GitHub-style “Type / to search” sized to the hint.
 * Focused (or with a query): the field grows into the navbar gap.
 *
 * Choosing a suggestion fills the field and does not search. An Enter key
 * then appears inside the field until the query is submitted.
 */
import SearchIcon from "../assets/search.svg?raw";
import "../styles/search-gateway.css";
---

<form
	id="nav-search-form"
	class="nav-search search-gateway not-prose hidden md:block relative shrink-0"
	action="/search"
	method="get"
	role="search"
	data-nav-search
>
	<label class="sr-only" for="nav-search-input">Search the discourses</label>
	<div class="nav-search-shell relative">
		<input
			type="search"
			id="nav-search-input"
			name="q"
			value=""
			placeholder="Gradual training, mettā…"
			autocomplete="off"
			enterkeyhint="search"
			data-search-focus
			title="Search"
			aria-keyshortcuts="/"
			class="nav-search-input w-full h-9 py-1.5 pl-9 pr-3 text-sm rounded-md border focus:outline-none focus:ring-2 focus:ring-[var(--primary-color)]"
			style="background:var(--surface-elevated); color:var(--text-color); border-color:var(--surface-border);"
		/>
		<div class="nav-search-hint" aria-hidden="true">
			Type <kbd class="nav-search-kbd">/</kbd> to search
		</div>
		<div
			id="nav-search-suggestions"
			class="nav-search-suggestions search-suggestions text-left hidden absolute top-full z-50 mt-1"
			role="presentation"
		>
			<div
				id="nav-search-suggestions-list"
				class="nav-search-suggestions-list search-suggestions-list"
			>
			</div>
		</div>
		<div
			class="nav-search-icon absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none w-4 h-4"
			style="color:var(--text-muted);"
			aria-hidden="true"
		>
			<Fragment set:html={SearchIcon} />
		</div>
		<button
			type="submit"
			id="nav-search-enter"
			class="nav-search-enter"
			hidden
			aria-label="Search"
			title="Search"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 16 16"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M13 4.5v3.25A2.25 2.25 0 0 1 10.75 10H3.5m0 0 2.5-2.5M3.5 10l2.5 2.5"
				></path>
			</svg>
		</button>
	</div>
</form>

<style>
	.nav-search {
		--nav-search-expanded: 24rem;
		width: 12.25rem;
		transition: width 180ms ease;
	}

	/* Avoid :not(:placeholder-shown): Vite prefixes it as :not(:-moz-placeholder),
	   which Safari treats as always true and hides the idle hint in `astro dev`. */
	.nav-search:focus-within,
	.nav-search.is-filled {
		width: var(--nav-search-expanded);
	}

	.nav-search-input:focus {
		border-color: var(--primary-color);
	}

	.nav-search-input::placeholder {
		color: transparent;
	}

	.nav-search:focus-within .nav-search-input::placeholder {
		color: var(--text-muted);
	}

	.nav-search-hint {
		position: absolute;
		left: 2.25rem;
		right: 0.5rem;
		top: 50%;
		z-index: 1;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		gap: 0.3em;
		font-size: 0.8125rem;
		line-height: 1;
		color: var(--text-muted);
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
	}

	.nav-search:focus-within .nav-search-hint,
	.nav-search.is-filled .nav-search-hint {
		display: none;
	}

	.nav-search-kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.15em;
		padding: 0.12em 0.32em;
		border: 1px solid var(--surface-border);
		border-radius: 0.25rem;
		background: color-mix(in srgb, var(--text-color) 8%, var(--surface-elevated));
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.7rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.nav-search :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	/* Author display would otherwise beat the hidden attribute. */
	.nav-search-enter[hidden] {
		display: none;
	}

	.nav-search.is-pending .nav-search-input {
		padding-right: 2.4rem;
	}

	.nav-search-enter {
		position: absolute;
		right: 0.28rem;
		top: 50%;
		z-index: 2;
		transform: translateY(-50%);
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--primary-color) 55%, var(--surface-border));
		border-radius: 0.3rem;
		background: color-mix(in srgb, var(--primary-color) 16%, var(--surface-elevated));
		color: var(--primary-color);
		font-family: inherit;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1;
		cursor: pointer;
		user-select: none;
		box-shadow: 0 1px 0 color-mix(in srgb, var(--text-color) 18%, transparent);
	}

	.nav-search-enter:not([hidden]) {
		display: inline-flex;
		animation: nav-search-enter-in 140ms ease;
	}

	.nav-search-enter svg {
		width: 0.85rem;
		height: 0.85rem;
		flex: none;
	}

	.nav-search-enter:hover {
		background: color-mix(in srgb, var(--primary-color) 26%, var(--surface-elevated));
	}

	.nav-search-enter:active {
		transform: translateY(calc(-50% + 1px));
		box-shadow: none;
	}

	.nav-search-enter:focus-visible {
		outline: 2px solid var(--primary-color);
		outline-offset: 1px;
	}

	@keyframes nav-search-enter-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-search-enter:not([hidden]) {
			animation: none;
		}
	}

	.nav-search :global(.search-suggest-item) {
		font-size: 0.875rem;
	}

	.nav-search-input::-webkit-search-cancel-button,
	.nav-search-input::-webkit-search-decoration {
		-webkit-appearance: none;
	}
</style>

<script>
	import { attachSearchGateway } from "../utils/searchGatewayClient";

	const form = document.getElementById("nav-search-form") as HTMLFormElement | null;
	const input = document.getElementById("nav-search-input") as HTMLInputElement | null;
	const dropdown = document.getElementById("nav-search-suggestions");
	const list = document.getElementById("nav-search-suggestions-list");

	const enter = document.getElementById("nav-search-enter") as HTMLButtonElement | null;

	if (form && input && dropdown && list && enter) {
		const syncFilled = () => {
			form.classList.toggle("is-filled", input.value.trim().length > 0);
		};
		// Suggestion accept writes the value without an input event, then closes
		// the menu. Show Enter only once a term is sitting there unsearched.
		const syncPending = () => {
			const pending =
				input.value.trim().length > 0 && dropdown.classList.contains("hidden");
			form.classList.toggle("is-pending", pending);
			enter.hidden = !pending;
		};
		const schedulePending = () => {
			queueMicrotask(syncPending);
		};
		syncFilled();
		syncPending();
		input.addEventListener("input", () => {
			syncFilled();
			schedulePending();
		});
		input.addEventListener("change", () => {
			syncFilled();
			schedulePending();
		});
		new MutationObserver(syncPending).observe(dropdown, {
			attributes: true,
			attributeFilter: ["class"],
		});

		attachSearchGateway({
			form,
			input,
			dropdown,
			list,
			alignDropdown: "stretch",
		});
	}
</script>
