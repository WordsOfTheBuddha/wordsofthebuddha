---
import "../styles/siteDialog.css";

interface Props {
	id: string;
	title: string;
	body: string;
}

const { id, title, body } = Astro.props;
const titleId = `${id}-title`;
---

<div
	id={id}
	class="site-dialog"
	data-prompt
	hidden
	aria-hidden="true"
>
	<div
		class="site-dialog-sheet"
		role="dialog"
		aria-modal="true"
		aria-labelledby={titleId}
	>
		<button
			type="button"
			class="site-dialog-close close-prompt"
			aria-label="Close"
		>
			×
		</button>
		<h2 id={titleId} class="site-dialog-title">{title}</h2>
		<p class="site-dialog-body">{body}</p>
		<div class="site-dialog-actions">
			<a class="site-dialog-primary" data-auth-href="/register" href="/register">
				Create an account
			</a>
			<a class="site-dialog-secondary" data-auth-href="/signin" href="/signin">
				Sign in
			</a>
			<button type="button" class="site-dialog-tertiary close-prompt">
				Not now
			</button>
		</div>
	</div>
</div>

<script>
	import { installSignInPrompt } from "../utils/signInPrompt";

	document.querySelectorAll<HTMLElement>("[data-prompt]").forEach((prompt) => {
		installSignInPrompt(prompt);
	});
</script>
