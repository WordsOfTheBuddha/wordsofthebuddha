---
/**
 * Home hero search gateway: wide input + autosuggest, redirects to /search for results.
 */
import SearchIcon from "../assets/search.svg?raw";
import "../styles/search-gateway.css";
import "../styles/ai-mode.css";

const starterChips = [
	{ label: "MN 10", href: "/mn10" },
	{ label: "mettā", href: "/search?q=mettā" },
	{ label: "radical attention", href: "/search?q=radical%20attention" },
] as const;
---

<div class="home-search search-gateway not-prose text-left w-full max-w-[600px] mx-auto" data-home-search>
	<nav class="ai-mode-switch home-search-mode-switch" aria-label="Mode">
		<a href="/" class="is-active" aria-current="page">Search</a>
		<a href="/search?mode=ask">Ask</a>
	</nav>
	<form
		id="home-search-form"
		action="/search"
		method="get"
		role="search"
	>
		<label class="home-search-sr-only" for="home-search-input">Search the discourses</label>
		<div class="relative">
			<input
				type="search"
				id="home-search-input"
				name="q"
				value=""
				placeholder="MN 10, mettā, radical attention…"
				autocomplete="off"
				enterkeyhint="search"
				data-search-focus
				title="Press / to search"
				aria-keyshortcuts="/"
				class="home-search-input w-full p-4 pl-12 pr-4 text-base sm:text-lg rounded-lg border focus:outline-none focus:ring-2 focus:ring-[var(--primary-color)]"
				style="background:var(--surface-elevated); color:var(--text-color); border-color:var(--surface-border);"
			/>
			<div
				id="home-search-suggestions"
				class="home-search-suggestions search-suggestions text-left hidden absolute top-full z-30 mt-1 left-0 right-0 w-full"
				role="presentation"
			>
				<div
					id="home-search-suggestions-list"
					class="home-search-suggestions-list search-suggestions-list"
				></div>
			</div>
			<div
				class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none w-5 h-5"
				style="color:var(--text-muted);"
				aria-hidden="true"
			>
				<Fragment set:html={SearchIcon} />
			</div>
		</div>
		<p
			id="home-search-hint"
			class="home-search-hint home-search-sr-only mt-2 text-sm text-center"
			style="color:var(--text-muted);"
			aria-live="polite"
		>
			Type a discourse ID, topic, or Pāli term, then press Enter.
		</p>
	</form>

	<div class="home-search-chips flex flex-wrap justify-center gap-2 mt-3">
		{
			starterChips.map((chip) => (
				<a
					href={chip.href}
					class="home-search-chip no-underline inline-flex items-center px-2.5 py-1 rounded-md text-xs sm:text-sm border transition-colors"
					style="border-color:var(--surface-border); color:var(--text-muted); background:var(--surface-elevated);"
				>
					{chip.label}
				</a>
			))
		}
	</div>

	<div class="home-hero-actions">
		<a class="home-hero-action home-hero-action--primary" href="/discover">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" width="16" height="16" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
			</svg>
			Discover
		</a>
		<a class="home-hero-action home-hero-action--secondary" href="/random">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" width="16" height="16" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
			</svg>
			Random Reading
		</a>
	</div>
</div>

<style>
	.home-search-mode-switch {
		margin: 0 auto 0.85rem;
	}

	.home-search-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.home-search-input:focus {
		border-color: var(--primary-color);
	}

	.home-search.is-empty-shake .home-search-input {
		animation: home-search-shake 0.35s ease;
	}

	@keyframes home-search-shake {
		0%,
		100% {
			transform: translateX(0);
		}
		25% {
			transform: translateX(-4px);
		}
		75% {
			transform: translateX(4px);
		}
	}

	.home-search-hint.is-visible {
		position: static;
		width: auto;
		height: auto;
		margin: 0.5rem 0 0;
		overflow: visible;
		clip: auto;
		white-space: normal;
	}

	.home-search-chip:hover {
		color: var(--text-color);
		border-color: var(--primary-color);
	}

	.home-hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.15rem;
	}

	.home-hero-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-width: 10.25rem;
		padding: 0.62rem 1.15rem;
		border-radius: 0.375rem;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.15s ease;
	}

	.home-hero-action svg {
		flex-shrink: 0;
	}

	.home-hero-action--primary {
		background: var(--primary-color);
		color: #fff;
		border: 1px solid color-mix(in srgb, var(--primary-color) 80%, #000);
		box-shadow: 0 8px 20px color-mix(in srgb, var(--primary-color) 28%, transparent);
	}

	.home-hero-action--primary:hover {
		color: #fff;
		background: color-mix(in srgb, var(--primary-color) 88%, #fff);
		box-shadow: 0 10px 24px color-mix(in srgb, var(--primary-color) 36%, transparent);
	}

	.home-hero-action:focus-visible {
		outline: 2px solid var(--primary-color);
		outline-offset: 2px;
	}

	.home-hero-action--secondary {
		background: var(--surface-elevated);
		color: var(--text-color);
		border: 1px solid var(--surface-border);
	}

	.home-hero-action--secondary:hover {
		color: var(--text-color);
		border-color: color-mix(in srgb, var(--primary-color) 45%, var(--surface-border));
		background: color-mix(in srgb, var(--primary-color) 10%, var(--surface-elevated));
	}
</style>

<script>
	import { attachSearchGateway } from "../utils/searchGatewayClient";

	const root = document.querySelector("[data-home-search]") as HTMLElement | null;
	const form = document.getElementById("home-search-form") as HTMLFormElement | null;
	const input = document.getElementById(
		"home-search-input",
	) as HTMLInputElement | null;
	const dropdown = document.getElementById("home-search-suggestions");
	const list = document.getElementById("home-search-suggestions-list");
	const hint = document.getElementById("home-search-hint");

	if (root && form && input && dropdown && list) {
		function showEmptyHint() {
			if (!root || !input || !hint) return;
			hint.classList.add("is-visible");
			hint.classList.remove("home-search-sr-only");
			root.classList.remove("is-empty-shake");
			void root.offsetWidth;
			root.classList.add("is-empty-shake");
			input.focus();
			setTimeout(() => root.classList.remove("is-empty-shake"), 400);
		}

		attachSearchGateway({
			form,
			input,
			dropdown,
			list,
			onEmptyQuery: showEmptyHint,
		});
	}
</script>
