---
import ReadButton from "./ReadButton.astro";

interface Props {
	/** Public discourse slug for this page. */
	slug?: string;
	/** Discourse title for page-context labeling. */
	title?: string;
}

const props = Astro.props as Props;
const slug = (props.slug || Astro.url.pathname.replace(/^\/+/, "")).split("?")[0];
const title = props.title || "";
---

<div class="discourse-ask" data-discourse-ask data-slug={slug} data-title={title}>
	<div class="flex justify-between items-center gap-3">
		<button
			type="button"
			data-ask-toggle
			aria-expanded="false"
			aria-label="Ask about this discourse"
			class="inline-flex items-center gap-1 px-4 py-2 text-sm rounded-full transition-all duration-300 border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 shrink-0"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
			</svg>
			<span>Ask</span>
		</button>
		<ReadButton slug={slug} />
	</div>

	<div data-ask-panel hidden class="dask-panel">
		<div class="dask-thread" data-ask-thread aria-live="polite"></div>
		<form class="dask-form" data-ask-form>
			<div class="dask-box">
				<label class="dask-sr-only" for="dask-input">Ask about this discourse</label>
				<textarea
					id="dask-input"
					data-ask-input
					rows="2"
					maxlength="8000"
					placeholder="Ask about this discourse…"
					enterkeyhint="enter"
				></textarea>
				<div class="dask-box-bar">
					<span class="dask-box-spacer" aria-hidden="true"></span>
					<button
						type="submit"
						class="dask-send"
						aria-label="Ask"
						title="Send (⌘Enter or Ctrl+Enter)"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="18" height="18" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5 19.5 12 4.5 4.5 7.5 12l-3 7.5Z" />
						</svg>
					</button>
				</div>
			</div>
			<div class="dask-meta">
				<button type="button" class="dask-new" data-ask-new hidden>+ New Ask</button>
				<a class="dask-history" href="/search?mode=ask">Asks tab →</a>
				<span class="dask-meta-spacer" aria-hidden="true"></span>
				<p class="dask-meter" data-ask-meter aria-live="polite" hidden></p>
			</div>
		</form>

		<div class="dask-dialog" data-ask-dialog hidden>
			<div class="dask-sheet" role="dialog" aria-modal="false" aria-labelledby="dask-quota-title">
				<button type="button" class="dask-close" data-close aria-label="Close">×</button>
				<div data-panel="signin">
					<h2 id="dask-quota-title" class="dask-title">You’ve used today’s free Asks</h2>
					<p class="dask-body">Create a free account for more Asks today. You’ll also keep recent questions across devices.</p>
					<div class="dask-actions">
						<a class="dask-primary" href="/register">Create an account</a>
						<a class="dask-secondary" href="/signin">Sign in</a>
						<button type="button" class="dask-tertiary" data-close>Not now</button>
					</div>
				</div>
				<div data-panel="tomorrow" hidden>
					<h2 class="dask-title">You’ve used today’s Asks</h2>
					<p class="dask-body">Come back tomorrow for a fresh set of Asks.</p>
					<div class="dask-actions">
						<button type="button" class="dask-primary" data-close>OK</button>
					</div>
				</div>
				<div data-panel="verify" hidden>
					<h2 class="dask-title">Verify your email for more Asks</h2>
					<p class="dask-body">You’re signed in, but your email isn’t verified yet. Verified accounts get the full daily Ask allowance.</p>
					<div class="dask-actions">
						<button type="button" class="dask-primary" data-close>OK</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	// Zero-cost until first use: the full Ask client (session, history,
	// SSE handling) is code-split and fetched only when the reader opens
	// the composer, so discourse first paint pays nothing for it. The
	// dynamic import resolves in a microtask — strictly after the opening
	// click's dispatch finishes — so the handoff below is a fresh dispatch
	// with no double-toggle risk.
	document.querySelectorAll<HTMLElement>("[data-discourse-ask]").forEach((root) => {
		if (root.dataset.askBound) return;
		root.dataset.askBound = "1";
		const toggle = root.querySelector<HTMLButtonElement>("[data-ask-toggle]");
		if (!toggle) return;
		let loading = false;
		toggle.addEventListener("click", async () => {
			// Once attached, the full client owns this toggle.
			if (root.dataset.attached || loading) return;
			loading = true;
			try {
				const mod = await import("../utils/discourseAskClient");
				if (!root.dataset.attached) {
					root.dataset.attached = "1";
					mod.attachDiscourseAsk(root).open();
				}
			} finally {
				loading = false;
			}
		});
	});
</script>

{/* Styles live in src/styles/discourse-ask.css (imported by Layout),
    mirroring the Ask page composer. Component-scoped <style> is avoided
    here: Astro dev was inlining the template but dropping this
    component's style block from the served page. */}
