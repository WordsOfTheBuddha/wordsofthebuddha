---
export const prerender = true; // Allow use in static pages; we'll hydrate auth on the client
import { verifyUser } from "../middleware/auth";
import SearchIcon from "../assets/search.svg?raw"; // Add this import
import NavSearch from "./NavSearch.astro";

interface Props {
	/** `true` shows the user menu or a Sign in CTA. `"signed-in"` shows the menu only when authenticated. */
	showAuth?: boolean | "signed-in";
	showSearch?: boolean;
	showBrand?: boolean;
}

const { showAuth = false, showSearch = true, showBrand = true } = Astro.props;
const authEnabled = Boolean(showAuth);
const hideGuestAuth = showAuth === "signed-in";
/** Path + query so Ask (`/search?mode=ai`) survives sign-in / sign-out. */
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const pathOnly = Astro.url.pathname;
const isInReviewSection =
	pathOnly === "/review-room" || pathOnly === "/profile";

// Resolve the user only on per-request SSR. Prerendered HTML is shared (and
// home is CDN-cached), so personalizing it would leak the first visitor's name.
// If this pass did not produce a user, ship an empty slot — never a guest
// Register button. Client hydration via /api/auth/me paints the real control.
let user: any = null;
if (
	authEnabled &&
	!hideGuestAuth &&
	Astro.request.headers.get("x-astro-prerender") !== "1"
) {
	const sessionCookie = Astro.cookies.get("__session")?.value;
	if (sessionCookie) {
		try {
			user = await verifyUser(sessionCookie);
		} catch (e) {}
	}
}
const registerHref = `/register?returnTo=${encodeURIComponent(currentPath)}`;
---

<nav
	class:list={[
		"flex items-center py-3 text-[var(--surface-ink)] min-h-[4rem]",
		showBrand && "border-b border-[color:var(--surface-border)]",
		showBrand ? "justify-between" : "justify-end nav-minimal",
	]}
>
	{
		showBrand && (
			<div class="text-lg md:text-xl font-bold flex items-center min-h-[2.25rem] shrink-0">
				<a href="/" class="brand-link" aria-label="Words of the Buddha home">
					<span class="brand-text text-gradient-accent">Words of the Buddha</span>
				</a>
			</div>
		)
	}
	<div class="flex items-center gap-2 min-h-[2.25rem] z-50">
		{
			showSearch && (
				<>
					<a
						href="/search"
						class:list={[
							"nav-search-link md:hidden p-2 shrink-0",
							showBrand
								? "hover:text-[var(--link-hover-color)]"
								: "nav-search-link--subtle",
						]}
						title="Search"
						aria-label="Search"
					>
						<Fragment set:html={SearchIcon} />
					</a>
					<NavSearch />
				</>
			)
		}
		{
			authEnabled &&
				(user ? (
					<div
						class="relative"
						id="nav-auth-slot"
						data-state="signed-in"
						data-guest-cta={hideGuestAuth ? "hidden" : "shown"}
						data-register-href={registerHref}
					>
						<button
							type="button"
							id="user-menu-button"
							class="flex items-center gap-2 px-1 py-1 text-sm font-medium text-[var(--text-color)] hover:text-[var(--link-hover-color)] focus:outline-none"
						>
							<span>{user.displayName}</span>
							<svg
								class="w-4 h-4"
								viewBox="0 0 20 20"
								fill="currentColor"
							>
								<path
									fill-rule="evenodd"
									d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
									clip-rule="evenodd"
								/>
							</svg>
						</button>
						<div
							id="user-menu"
							class="hidden absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-[var(--auth-card-bg)] ring-1 ring-black ring-opacity-5"
						>
							<div class="py-1">
								<a
									href="/discover"
									class="block px-4 py-2 text-sm text-[var(--text-color)] hover:bg-[var(--auth-input-bg)]"
								>
									Discover
								</a>
								<a
									href="/review-room"
									class="block px-4 py-2 text-sm text-[var(--text-color)] hover:bg-[var(--auth-input-bg)]"
								>
									Review Room
								</a>
								<a
									href="/profile"
									class="block px-4 py-2 text-sm text-[var(--text-color)] hover:bg-[var(--auth-input-bg)]"
								>
									Profile
								</a>
								<form action="/api/auth/signout" method="post">
									<input
										type="hidden"
										name="returnTo"
										value={currentPath}
									/>
									<button
										type="submit"
										class="block w-full text-left px-4 py-2 text-sm text-[var(--text-color)] hover:bg-[var(--auth-input-bg)]"
									>
										Sign out
									</button>
								</form>
							</div>
						</div>
					</div>
				) : (
					<div
						id="nav-auth-slot"
						class="relative"
						data-state="pending"
						data-guest-cta={hideGuestAuth ? "hidden" : "shown"}
						data-register-href={registerHref}
						aria-busy="true"
					>
					</div>
				))
		}
	</div>
</nav>

<style>
	.brand-link {
		display: inline-flex;
		align-items: flex-end;
		gap: 0.6rem;
		line-height: 1;
	}

	.brand-link:hover .brand-text {
		text-decoration: none;
	}

	.brand-text {
		font-size: inherit;
		display: inline-block;
		line-height: 1;
	}

	.brand-link :global(.logo-mark) {
		transform: translateY(0.02em);
	}

	nav.nav-minimal :global(.nav-search-link--subtle) {
		color: var(--text-muted);
	}

	nav.nav-minimal :global(.nav-search-link--subtle:hover) {
		color: var(--text-color);
	}

	#nav-auth-slot[data-state="pending"] {
		min-width: 5.5rem;
		min-height: 2rem;
	}
</style>

<script>
	import { installSearchFocusShortcut } from "../utils/searchFocusShortcut";
	import {
		clearNavAuthCache,
		readNavAuthCache,
		renderNavAuthSlot,
		seedNavAuthCacheFromSlot,
		writeNavAuthCache,
		type NavAuthCache,
	} from "../utils/navAuthClient";

	installSearchFocusShortcut();

	function wireMenu() {
		const userMenuButton = document.getElementById("user-menu-button");
		const userMenu = document.getElementById("user-menu");
		if (!userMenuButton || !userMenu) return;
		if (userMenuButton.dataset.wired === "1") return;
		userMenuButton.dataset.wired = "1";
		let isMenuOpen = false;
		userMenuButton.addEventListener("click", (e) => {
			e.stopPropagation();
			isMenuOpen = !isMenuOpen;
			userMenu.classList.toggle("hidden");
		});
		document.addEventListener("click", (e) => {
			if (isMenuOpen && !userMenu.contains(e.target as Node)) {
				isMenuOpen = false;
				userMenu.classList.add("hidden");
			}
		});
	}

	function slotOptions(slot: HTMLElement) {
		return {
			registerHref: slot.getAttribute("data-register-href") || "/register",
			returnTo: `${location.pathname}${location.search}`,
			hideGuestCta: slot.getAttribute("data-guest-cta") === "hidden",
		};
	}

	function applyAuth(slot: HTMLElement, state: NavAuthCache) {
		renderNavAuthSlot(slot, state, slotOptions(slot));
		writeNavAuthCache(state);
		if (state.signedIn) wireMenu();
	}

	const slot = document.getElementById("nav-auth-slot");
	if (slot) {
		const alreadySignedIn = slot.getAttribute("data-state") === "signed-in";
		seedNavAuthCacheFromSlot(slot);
		slot.addEventListener("submit", (event) => {
			const form = event.target;
			if (
				form instanceof HTMLFormElement &&
				form.getAttribute("action") === "/api/auth/signout"
			) {
				clearNavAuthCache();
			}
		});

		if (alreadySignedIn) {
			wireMenu();
		} else {
			const cached = readNavAuthCache();
			// Only paint a cached signed-in menu before /api/auth/me. A cached
			// guest Register button would flash again right after sign-in.
			if (cached?.signedIn) applyAuth(slot, cached);

			(async () => {
				try {
					const res = await fetch("/api/auth/me", {
						credentials: "same-origin",
					});
					if (!res.ok) return;
					const data = await res.json();
					if (data?.signedIn && data.user?.displayName) {
						applyAuth(slot, {
							signedIn: true,
							displayName: data.user.displayName,
						});
						return;
					}
					applyAuth(slot, { signedIn: false });
				} catch {
					/* keep cache / empty pending slot */
				}
			})();
		}
	}
</script>
