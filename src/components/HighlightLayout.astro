---
import CopyButton from "./CopyButton.astro";
import Eraser from "../assets/eraser.svg?raw";
import "../styles/highlight.css";

// HighlightLayout.astro
const currentPath = Astro.url.pathname;

const COLOR_MAP = {
	yellow: "#FEF08A",
	pink: "#FBCFE8",
	green: "#BBF7D0",
	blue: "#BFDBFE",
} as const;

// Add blacklist for pages where highlighting should be disabled
const HIGHLIGHT_BLACKLIST = [
	"/review-room",
	"/search",
	"/support",
	"/profile",
	"/signin",
	"/register",
	"/about",
	"/topic",
	"/quality",
	"/simile",
	"/person",
	"/discover",
	"/recent",
	"/ai",
	"/ask",
	"/research",
	"/shared-ask",
	"/admin",
	"/on/",
	"/api/",
	"/anthologies/",
	"/offline",
	"/privacy",
	"/public-domain",
	"/buddha-quotes",
	"/design-system",
	"/design-system",
];

const isHome = currentPath === "/" || currentPath === "";
const isHighlightingDisabled =
	isHome ||
	HIGHLIGHT_BLACKLIST.some((path) => currentPath.startsWith(path));

// Never verify the session while rendering HTML. That was a Firebase
// revocation round-trip on SSR discourse TTFB. Client hydration sets this.
const isAuthenticated = false;

const { title, description } = Astro.props;
---

<div
	id="highlight-root"
	class:list={[
		"highlight-container",
		"flex min-h-[calc(100dvh-2rem)] flex-1 flex-col",
	]}
	data-authenticated={isAuthenticated}
	data-title={title}
	data-description={description}
	data-highlight-disabled={isHighlightingDisabled}
>
	<slot />

	{
		!isHighlightingDisabled && (
			<div id="highlight-menu" class="highlight-menu" style="display: none;">
				<div class="menu-items">
					<CopyButton />
					<button
						id="highlight-eraser"
						class="eraser-btn"
						style="display: none;"
					>
						<Fragment set:html={Eraser} />
					</button>
					{Object.entries(COLOR_MAP).map(([colorName, bgColor]) => (
						<button
							data-color={colorName}
							style={`background-color: ${bgColor}`}
							class="color-swatch"
						/>
					))}
					<button
						id="highlight-note"
						class="note-btn"
						type="button"
						aria-label="Add a note"
						style="display: none;"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M4.5 3.75h15A2.25 2.25 0 0 1 21.75 6v9a2.25 2.25 0 0 1-2.25 2.25H10.3l-4.4 3.52a.75.75 0 0 1-1.22-.59v-2.93h-.18A2.25 2.25 0 0 1 2.25 15V6A2.25 2.25 0 0 1 4.5 3.75z" />
						</svg>
					</button>
				</div>
			</div>
			<div id="note-card" class="note-card" hidden>
				<p class="note-card-text"></p>
				<textarea
					class="note-card-input"
					maxlength="2000"
					rows="4"
					placeholder="Write a note"
					aria-label="Note"
				></textarea>
				<div class="note-card-actions">
					<button type="button" data-note-action="save">
						Save
						<span class="note-save-hint" data-note-save-hint></span>
					</button>
					<button type="button" data-note-action="edit">Edit</button>
					<button type="button" data-note-action="delete">Del</button>
					<button type="button" data-note-action="cancel">Cancel</button>
				</div>
			</div>
		)
	}
</div>

<script>
	import { loadPageUserState } from "../utils/pageUserStateClient";
	import type { HighlightColor } from "../utils/stableHighlight";

	declare global {
		interface Window {
			selectionHandler: any;
			highlightService: any;
		}
	}

	let menu = document.getElementById("highlight-menu") as HTMLDivElement;
	let rootElement: HTMLElement | null = null;
	let outsideClickListener: ((e: MouseEvent) => void) | null = null;
	let restoreStarted = false;
	let repaintTimer: ReturnType<typeof setTimeout> | null = null;

	// Tapping a swatch can collapse the selection (mobile), so keep a copy.
	let savedRange: Range | null = null;
	/** Range a new note will be saved against. */
	let noteDraftRange: Range | null = null;
	let openNoteId: string | null = null;
	let noteCardMode: "view" | "edit" = "view";
	let hoveredNoteId: string | null = null;

	let selectionHandler: typeof import("../service/selectionHandler") | null =
		null;
	let highlightService: typeof import("../service/highlightService") | null =
		null;

	// Theme handling
	function updateDarkMode(): void {
		if (!rootElement)
			rootElement = document.getElementById("highlight-root");
		if (!rootElement) return;

		const isDark = document.documentElement.classList.contains("dark");
		rootElement.classList.toggle("dark-mode", isDark);
	}

	function updateTheme(): void {
		const isDark = document.documentElement.classList.contains("dark");
		if (menu) {
			menu.style.setProperty("--bg-color", isDark ? "#1f2937" : "#fff");
			menu.style.setProperty(
				"--border-color",
				isDark ? "#374151" : "#e5e7eb"
			);
		}
		updateDarkMode();
	}

	function scheduleRestore() {
		if (!rootElement || !highlightService || restoreStarted) return;
		if (rootElement.dataset.authenticated !== "true") return; // only restore for authed users
		restoreStarted = true;
		const run = async () => {
			try {
				const state = await loadPageUserState();
				if (state) {
					highlightService!.restoreHighlights(state);
				} else {
					await highlightService!.fetchAndRestoreHighlights();
				}
				rootElement!.dataset.highlightsLoaded = "true";
			} catch (e) {
				console.warn("[highlight] restore failed", e);
			}
		};
		if ("requestIdleCallback" in window) {
			(requestIdleCallback as any)(run, { timeout: 1500 });
		} else {
			setTimeout(run, 0);
		}
	}

	/** Every copy is painted already; this catches views rebuilt from scratch. */
	function scheduleRepaint() {
		if (rootElement?.dataset.highlightsLoaded !== "true") return;
		if (repaintTimer) clearTimeout(repaintTimer);
		closeNoteCard();
		repaintTimer = setTimeout(() => {
			highlightService?.repaintHighlights();
		}, 50);
	}

	// Hydrate auth state on client (mirrors navbar logic) so prerendered pages can enable highlights
	async function hydrateAuth() {
		try {
			if (!rootElement) return;
			if (rootElement.dataset.authenticated !== "true") {
				const data = await loadPageUserState();
				if (!data?.signedIn) return;
				rootElement.dataset.authenticated = "true";
				if (data.user?.emailVerified) {
					rootElement.dataset.emailVerified = "true";
				}
			}
			scheduleRestore();
		} catch (e) {
			/* ignore */
		}
	}

	function liveRange(): Range | null {
		const selection = window.getSelection();
		if (!selection || selection.isCollapsed || !selection.rangeCount) {
			return null;
		}
		return selection.getRangeAt(0);
	}

	/** The range a menu action applies to. */
	function actionRange(): Range | null {
		const live = liveRange();
		if (live && live.toString().trim()) return live;
		return savedRange;
	}

	function elementOf(node: Node): Element | null {
		return node.nodeType === Node.ELEMENT_NODE
			? (node as Element)
			: node.parentElement;
	}

	function handleSelection(e: MouseEvent | TouchEvent) {
		if (!menu || !selectionHandler || !rootElement) return;
		const target = e.target as HTMLElement;
		if (menu.contains(target) || target.closest?.("#note-card")) return;

		menu.style.display = "none";

		// SEARCH & FIND: Skip highlighting on components like Translation Memory popover
		if (target.closest?.(".tm-popover-overlay, .bottom-popover")) {
			return;
		}

		const selection = window.getSelection();
		if (!selectionHandler.isSelectionValid(selection)) return;
		const range = selection!.getRangeAt(0);

		const containerEl = elementOf(range.commonAncestorContainer);
		if (containerEl?.closest(".tm-popover-overlay, .bottom-popover")) {
			return;
		}
		if (!rootElement.contains(range.commonAncestorContainer)) return;

		if (checkPaliContext(target, selection!)) return;

		const intersectsCollapse = checkCollapseIntersection(range);

		// Visible before positioning: placement reads the menu's width.
		menu.style.display = "block";
		if (!selectionHandler.updateMenuPosition(range, menu, rootElement)) {
			menu.style.display = "none";
			return;
		}
		savedRange = range.cloneRange();
		closeNoteCard();

		const isAuthenticated = rootElement.dataset.authenticated === "true";
		if (!isAuthenticated) {
			// Non-authenticated users can only copy
			document.querySelectorAll<HTMLElement>(".color-swatch").forEach((swatch) => {
				swatch.style.display = "none";
			});
			const eraserBtn = document.getElementById("highlight-eraser");
			if (eraserBtn) eraserBtn.style.display = "none";
			const noteBtn = document.getElementById("highlight-note");
			if (noteBtn) noteBtn.style.display = "none";
		} else {
			updateHighlightingAvailability(intersectsCollapse, range);
		}

		setupOutsideClickListener();
	}

	function isWithinCollapseElement(element: Element | null): boolean {
		return Boolean(element?.closest(".collapse-toggle"));
	}

	function checkCollapseIntersection(range: Range): boolean {
		if (isWithinCollapseElement(elementOf(range.startContainer))) return true;
		if (isWithinCollapseElement(elementOf(range.endContainer))) return true;
		const ancestor = elementOf(range.commonAncestorContainer);
		if (!ancestor) return false;
		for (const collapseEl of ancestor.querySelectorAll(".collapse-toggle")) {
			if (range.intersectsNode(collapseEl)) return true;
		}
		return false;
	}

	function updateHighlightingAvailability(
		intersectsCollapse: boolean,
		range: Range,
	): void {
		document.querySelectorAll<HTMLElement>(".color-swatch").forEach((swatch) => {
			swatch.style.display = intersectsCollapse ? "none" : "block";
		});

		const eraserBtn = document.getElementById("highlight-eraser");
		if (eraserBtn) {
			const canErase =
				!intersectsCollapse &&
				Boolean(highlightService?.rangeHasHighlight(range));
			eraserBtn.style.display = canErase ? "flex" : "none";
		}

		const noteBtn = document.getElementById("highlight-note");
		if (noteBtn) {
			const canNote =
				!intersectsCollapse &&
				rootElement?.dataset.emailVerified === "true";
			noteBtn.style.display = canNote ? "flex" : "none";
		}
	}

	function checkPaliContext(target: HTMLElement, selection: Selection): boolean {
		const isPaliParagraph = target.closest?.(".pali-paragraph");
		const isPaliLookupEnabled =
			localStorage.getItem("paliLookup") === "true";
		const selectedText = selection.toString().trim();
		const isSingleWord = selectedText && !selectedText.includes(" ");
		return Boolean(isPaliLookupEnabled && isPaliParagraph && isSingleWord);
	}

	function setupOutsideClickListener() {
		if (outsideClickListener) {
			document.removeEventListener("mousedown", outsideClickListener);
		}
		outsideClickListener = (e: MouseEvent) => {
			const target = e.target as Node;
			if (!menu.contains(target)) {
				menu.style.display = "none";
				savedRange = null;
				window.getSelection()?.removeAllRanges();
				document.removeEventListener("mousedown", outsideClickListener!);
				outsideClickListener = null;
			}
		};
		document.addEventListener("mousedown", outsideClickListener);
	}

	function finishMenuAction(): void {
		menu.style.display = "none";
		savedRange = null;
		window.getSelection()?.removeAllRanges();
	}

	function applyHighlight(color: HighlightColor): void {
		const range = actionRange();
		if (!range || !highlightService) return;
		if (checkCollapseIntersection(range)) {
			console.warn(
				"Attempted to highlight selection that intersects with collapse elements"
			);
			return;
		}
		highlightService.highlightRange(range, color);
		finishMenuAction();
	}

	function handleClear(): void {
		const range = actionRange();
		if (!range || !highlightService) return;
		if (checkCollapseIntersection(range)) return;
		highlightService.eraseRange(range);
		finishMenuAction();
	}

	function noteCard(): HTMLElement | null {
		return document.getElementById("note-card");
	}

	function canWriteNotes(): boolean {
		return rootElement?.dataset.emailVerified === "true";
	}

	function setActiveNote(id: string | null): void {
		rootElement
			?.querySelectorAll(".note-range.is-active")
			.forEach((el) => el.classList.remove("is-active"));
		if (!id) return;
		rootElement
			?.querySelectorAll(`.note-range[data-note="${CSS.escape(id)}"]`)
			.forEach((el) => el.classList.add("is-active"));
	}

	function closeNoteCard(): void {
		const card = noteCard();
		if (card) card.hidden = true;
		noteDraftRange = null;
		openNoteId = null;
		setActiveNote(null);
	}

	function isShown(el: Element): boolean {
		return el.getClientRects().length > 0;
	}

	/** Where a note's card hangs: its visible marker, else its first visible range. */
	function noteAnchor(id: string): Element | null {
		const sel = CSS.escape(id);
		const cue = [
			...(rootElement?.querySelectorAll(`.note-cue[data-note="${sel}"]`) ?? []),
		].find(isShown);
		if (cue) return cue;
		return (
			[
				...(rootElement?.querySelectorAll(`.note-range[data-note="${sel}"]`) ??
					[]),
			].find(isShown) ?? null
		);
	}

	const NOTE_SIDE_GAP = 10;
	const NOTE_SIDE_MIN = 168;

	/** Left edge of the reading column, including a visible paragraph number. */
	function contentLeftEdge(startEl: Element | null): {
		edge: number;
		column: Element | null;
	} {
		const column = startEl?.closest(".md-content, article") ?? null;
		const block = startEl?.closest(
			"[data-hl-block], p, li, td, th, blockquote, pre",
		);
		const base = (column ?? block)?.getBoundingClientRect().left ?? 0;
		const num = block?.querySelector(".paragraph-num");
		const numRect = num?.getClientRects()[0];
		const edge = numRect ? Math.min(base, numRect.left) : base;
		return { edge, column };
	}

	/** Another reading column already occupies the left margin (split view). */
	function sideIsTaken(
		column: Element | null,
		left: number,
		right: number,
	): boolean {
		if (!rootElement) return false;
		for (const el of rootElement.querySelectorAll(".md-content")) {
			if (column && (el === column || column.contains(el))) continue;
			const rect = el.getBoundingClientRect();
			if (rect.width < 2 || rect.height < 2) continue;
			if (rect.right > left + 4 && rect.left < right - 4) return true;
		}
		return false;
	}

	/**
	 * Beside the reading column when the margin can hold the card.
	 * Otherwise above the selection, so the noted text stays visible.
	 */
	function placeNoteCard(target: Range | Element): void {
		const card = noteCard();
		if (!card || !rootElement) return;
		card.hidden = false;
		const lineRect =
			(target instanceof Range
				? target.getClientRects()[0]
				: target.getClientRects()[0]) ?? target.getBoundingClientRect();
		if (lineRect.width === 0 && lineRect.height === 0) return;
		const startNode =
			target instanceof Range ? target.startContainer : (target as Node);
		const startEl =
			startNode.nodeType === Node.ELEMENT_NODE
				? (startNode as Element)
				: startNode.parentElement;
		const rootRect = rootElement.getBoundingClientRect();
		const { edge, column } = contentLeftEdge(startEl);
		const maxWidth = Math.min(20 * 16, window.innerWidth - 32);
		const available = edge - 8 - NOTE_SIDE_GAP;

		if (available >= NOTE_SIDE_MIN) {
			const width = Math.min(maxWidth, available);
			const viewLeft = edge - NOTE_SIDE_GAP - width;
			if (!sideIsTaken(column, viewLeft, edge - NOTE_SIDE_GAP)) {
				card.style.width = `${width}px`;
				const height = card.offsetHeight;
				const minTop = 8 - rootRect.top;
				const maxTop = window.innerHeight - 8 - height - rootRect.top;
				const top = Math.min(
					Math.max(lineRect.top - rootRect.top, minTop),
					Math.max(minTop, maxTop),
				);
				card.style.left = `${viewLeft - rootRect.left}px`;
				card.style.top = `${top}px`;
				return;
			}
		}

		card.style.width = "";
		const width = card.offsetWidth;
		const minLeft = 8 - rootRect.left;
		const maxLeft = window.innerWidth - 8 - width - rootRect.left;
		const left = Math.min(
			Math.max(edge - rootRect.left, minLeft),
			Math.max(minLeft, maxLeft),
		);
		const minTop = 8 - rootRect.top;
		const top = Math.max(
			lineRect.top - rootRect.top - card.offsetHeight - NOTE_SIDE_GAP,
			minTop,
		);
		card.style.left = `${left}px`;
		card.style.top = `${top}px`;
	}

	function renderNoteCard(): void {
		const card = noteCard();
		if (!card) return;
		const textEl = card.querySelector<HTMLElement>(".note-card-text");
		const input = card.querySelector<HTMLTextAreaElement>(".note-card-input");
		const note = openNoteId
			? highlightService?.getDiscourseNotes().find((item) => item.id === openNoteId)
			: null;
		const writing = noteCardMode === "edit";
		card.classList.toggle("is-writing", writing);
		card.classList.remove("is-actions-open");
		if (textEl) {
			textEl.hidden = writing;
			textEl.textContent = note?.text ?? "";
		}
		if (input) {
			input.hidden = !writing;
			if (writing && document.activeElement !== input) {
				input.value = note?.text ?? "";
				input.focus();
			}
		}
		const show = (action: string, visible: boolean) => {
			const button = card.querySelector<HTMLButtonElement>(
				`[data-note-action="${action}"]`,
			);
			if (button) button.hidden = !visible;
		};
		const writable = canWriteNotes();
		show("save", writing && writable);
		const hint = card.querySelector<HTMLElement>("[data-note-save-hint]");
		if (hint) {
			hint.textContent = /Mac|iPhone|iPad|iPod/.test(navigator.platform)
				? "⌘↵"
				: "Ctrl+↵";
		}
		show("edit", !writing && writable && Boolean(note));
		show("delete", !writing && writable && Boolean(note));
		show("cancel", writing);
	}

	function openNoteViewer(id: string, fallback?: Range | Element): void {
		openNoteId = id;
		noteDraftRange = null;
		noteCardMode = "view";
		renderNoteCard();
		setActiveNote(id);
		const anchor = noteAnchor(id) ?? fallback;
		if (anchor) placeNoteCard(anchor);
	}

	function openNoteComposer(range: Range): void {
		openNoteId = null;
		noteDraftRange = range;
		noteCardMode = "edit";
		renderNoteCard();
		const input = noteCard()?.querySelector<HTMLTextAreaElement>(".note-card-input");
		if (input) input.value = "";
		placeNoteCard(range);
		input?.focus();
	}

	function handleAddNote(): void {
		const range = actionRange();
		if (!range || !highlightService || !canWriteNotes()) return;
		if (checkCollapseIntersection(range)) return;
		const kept = range.cloneRange();
		const existing = highlightService.noteForRange(range);
		finishMenuAction();
		if (existing) openNoteViewer(existing.id, kept);
		else openNoteComposer(kept);
	}

	function handleNoteCardAction(action: string): void {
		if (!highlightService) return;
		if (action === "cancel") {
			if (openNoteId) {
				noteCardMode = "view";
				renderNoteCard();
			} else {
				closeNoteCard();
			}
			return;
		}
		if (action === "edit" && openNoteId) {
			noteCardMode = "edit";
			renderNoteCard();
			return;
		}
		if (action === "delete" && openNoteId) {
			const id = openNoteId;
			highlightService.deleteNote(id);
			closeNoteCard();
			return;
		}
		if (action === "save") {
			const input = noteCard()?.querySelector<HTMLTextAreaElement>(".note-card-input");
			const text = input?.value ?? "";
			if (openNoteId) {
				if (!highlightService.updateNote(openNoteId, text)) return;
				noteCardMode = "view";
				renderNoteCard();
				return;
			}
			if (!noteDraftRange) return;
			const saved = highlightService.saveNote(noteDraftRange, text);
			if (!saved) return;
			openNoteViewer(saved.id);
		}
	}

	function setupEventListeners(): void {
		document.addEventListener("mouseup", handleSelection);
		document.addEventListener("touchend", handleSelection);
		document.addEventListener("selectionchange", () => {
			if (!liveRange()) menu.style.display = "none";
		});

		document
			.querySelectorAll<HTMLButtonElement>(".color-swatch")
			.forEach((swatch) => {
				const apply = () => {
					const color = swatch.dataset.color as HighlightColor;
					if (color) applyHighlight(color);
				};
				swatch.addEventListener("touchend", (e) => {
					e.preventDefault();
					apply();
				});
				swatch.addEventListener("click", apply);
			});

		const eraserBtn = document.getElementById("highlight-eraser");
		if (eraserBtn) {
			eraserBtn.addEventListener("touchend", (e) => {
				e.preventDefault();
				handleClear();
			});
			eraserBtn.addEventListener("click", handleClear);
		}

		const noteBtn = document.getElementById("highlight-note");
		if (noteBtn) {
			noteBtn.addEventListener("touchend", (e) => {
				e.preventDefault();
				handleAddNote();
			});
			noteBtn.addEventListener("click", handleAddNote);
		}

		noteCard()?.addEventListener("click", (e) => {
			const action = (e.target as HTMLElement).closest<HTMLButtonElement>(
				"[data-note-action]",
			)?.dataset.noteAction;
			if (action) {
				handleNoteCardAction(action);
				return;
			}
			const card = noteCard();
			if (!card || card.classList.contains("is-writing")) return;
			const hoverable = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
			if (hoverable) return;
			card.classList.toggle("is-actions-open");
		});

		function setHoveredNote(id: string | null): void {
			if (hoveredNoteId === id) return;
			rootElement
				?.querySelectorAll(".note-range.is-hovered")
				.forEach((el) => el.classList.remove("is-hovered"));
			hoveredNoteId = id;
			if (!id || !rootElement) return;
			rootElement
				.querySelectorAll(`.note-range[data-note="${CSS.escape(id)}"]`)
				.forEach((el) => el.classList.add("is-hovered"));
		}

		rootElement?.addEventListener("mouseover", (e) => {
			const target = e.target as HTMLElement;
			if (target.closest?.(".tooltip-text")) {
				setHoveredNote(null);
				return;
			}
			const mark = target.closest?.(".note-range[data-note]");
			setHoveredNote(mark?.getAttribute("data-note") ?? null);
		});
		rootElement?.addEventListener("mouseout", (e) => {
			const next = e.relatedTarget;
			if (next instanceof Node && rootElement?.contains(next)) return;
			setHoveredNote(null);
		});

		rootElement?.addEventListener("click", (e) => {
			const target = e.target as HTMLElement;
			const cue = target.closest?.(".note-cue");
			if (cue) {
				e.preventDefault();
				e.stopPropagation();
			}
			const host = (cue ?? target).closest?.("[data-note]");
			if (!host || host.closest("#note-card, #highlight-menu")) return;
			const id = host.getAttribute("data-note");
			if (!id) return;
			const selection = window.getSelection();
			if (selection && !selection.isCollapsed && selection.toString().trim()) return;
			e.preventDefault();
			if (openNoteId === id && !noteCard()?.hidden) {
				closeNoteCard();
				return;
			}
			openNoteViewer(id, host);
		});

		document.addEventListener("mousedown", (e) => {
			const card = noteCard();
			if (!card || card.hidden) return;
			const target = e.target as HTMLElement;
			if (card.contains(target) || target.closest?.("[data-note], #highlight-note")) return;
			closeNoteCard();
		});

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") closeNoteCard();
			if (e.key !== "Enter" || !(e.metaKey || e.ctrlKey)) return;
			const card = noteCard();
			const save = card?.querySelector<HTMLButtonElement>(
				'[data-note-action="save"]',
			);
			if (!card || card.hidden || !save || save.hidden) return;
			e.preventDefault();
			handleNoteCardAction("save");
		});

		window.addEventListener("resize", () => {
			const card = noteCard();
			if (!card || card.hidden) return;
			if (noteDraftRange) {
				placeNoteCard(noteDraftRange);
				return;
			}
			if (!openNoteId) return;
			const anchor = noteAnchor(openNoteId);
			if (anchor) placeNoteCard(anchor);
		});
	}

	async function init() {
		rootElement = document.getElementById("highlight-root");
		menu = document.getElementById("highlight-menu") as HTMLDivElement;
		if (!rootElement || rootElement.dataset.highlightDisabled === "true") return;
		void loadPageUserState();

		try {
			const [selectionHandlerModule, highlightServiceModule] =
				await Promise.all([
					import("../service/selectionHandler"),
					import("../service/highlightService"),
				]);

			selectionHandler = selectionHandlerModule;
			highlightService = highlightServiceModule;
			window.selectionHandler = selectionHandlerModule;
			window.highlightService = highlightServiceModule;

			updateDarkMode();
			updateTheme();
			window.addEventListener("themeToggled", updateDarkMode);
			document.addEventListener("themeChanged", updateTheme);
			document.addEventListener("layoutChanged", scheduleRepaint);
			document.addEventListener("paliModeChanged", scheduleRepaint);
			setupEventListeners();
			// Auth hydration schedules the restore without blocking interactivity
			hydrateAuth();
		} catch (error) {
			console.error("[highlight] Init error:", error);
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init);
	} else {
		init();
	}
</script>
