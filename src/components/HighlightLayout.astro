---
import CopyButton from "./CopyButton.astro";
import Eraser from "../assets/eraser.svg?raw";
import "../styles/highlight.css";

// HighlightLayout.astro
const currentPath = Astro.url.pathname;

const COLOR_MAP = {
	yellow: "#FEF08A",
	pink: "#FBCFE8",
	green: "#BBF7D0",
	blue: "#BFDBFE",
} as const;

// Add blacklist for pages where highlighting should be disabled
const HIGHLIGHT_BLACKLIST = [
	"/review-room",
	"/search",
	"/support",
	"/profile",
	"/signin",
	"/register",
	"/about",
	"/topic",
	"/quality",
	"/simile",
	"/person",
	"/discover",
	"/recent",
	"/ai",
	"/ask",
	"/research",
	"/shared-ask",
	"/admin",
	"/on/",
	"/api/",
	"/anthologies/",
	"/offline",
	"/privacy",
	"/public-domain",
	"/buddha-quotes",
	"/design-system",
	"/design-system",
];

const isHome = currentPath === "/" || currentPath === "";
const isHighlightingDisabled =
	isHome ||
	HIGHLIGHT_BLACKLIST.some((path) => currentPath.startsWith(path));

// Never verify the session while rendering HTML. That was a Firebase
// revocation round-trip on SSR discourse TTFB. Client hydration sets this.
const isAuthenticated = false;

const { title, description } = Astro.props;
---

<div
	id="highlight-root"
	class:list={[
		"highlight-container",
		"flex min-h-[calc(100dvh-2rem)] flex-1 flex-col",
	]}
	data-authenticated={isAuthenticated}
	data-title={title}
	data-description={description}
	data-highlight-disabled={isHighlightingDisabled}
>
	<slot />

	{
		!isHighlightingDisabled && (
			<div id="highlight-menu" class="highlight-menu" style="display: none;">
				<div class="menu-items">
					<CopyButton />
					{Object.entries(COLOR_MAP).map(([colorName, bgColor]) => (
						<button
							data-color={colorName}
							style={`background-color: ${bgColor}`}
							class="color-swatch"
						/>
					))}
					<button
						id="highlight-eraser"
						class="eraser-btn"
						style="display: none;"
					>
						<Fragment set:html={Eraser} />
					</button>
				</div>
			</div>
		)
	}
</div>

<script>
	import { loadPageUserState } from "../utils/pageUserStateClient";
	import type { HighlightColor } from "../utils/stableHighlight";

	declare global {
		interface Window {
			selectionHandler: any;
			highlightService: any;
		}
	}

	let menu = document.getElementById("highlight-menu") as HTMLDivElement;
	let rootElement: HTMLElement | null = null;
	let outsideClickListener: ((e: MouseEvent) => void) | null = null;
	let restoreStarted = false;
	let repaintTimer: ReturnType<typeof setTimeout> | null = null;

	// Tapping a swatch can collapse the selection (mobile), so keep a copy.
	let savedRange: Range | null = null;

	let selectionHandler: typeof import("../service/selectionHandler") | null =
		null;
	let highlightService: typeof import("../service/highlightService") | null =
		null;

	// Theme handling
	function updateDarkMode(): void {
		if (!rootElement)
			rootElement = document.getElementById("highlight-root");
		if (!rootElement) return;

		const isDark = document.documentElement.classList.contains("dark");
		rootElement.classList.toggle("dark-mode", isDark);
	}

	function updateTheme(): void {
		const isDark = document.documentElement.classList.contains("dark");
		if (menu) {
			menu.style.setProperty("--bg-color", isDark ? "#1f2937" : "#fff");
			menu.style.setProperty(
				"--border-color",
				isDark ? "#374151" : "#e5e7eb"
			);
		}
		updateDarkMode();
	}

	function scheduleRestore() {
		if (!rootElement || !highlightService || restoreStarted) return;
		if (rootElement.dataset.authenticated !== "true") return; // only restore for authed users
		restoreStarted = true;
		const run = async () => {
			try {
				const state = await loadPageUserState();
				if (state) {
					highlightService!.restoreHighlights(state);
				} else {
					await highlightService!.fetchAndRestoreHighlights();
				}
				rootElement!.dataset.highlightsLoaded = "true";
			} catch (e) {
				console.warn("[highlight] restore failed", e);
			}
		};
		if ("requestIdleCallback" in window) {
			(requestIdleCallback as any)(run, { timeout: 1500 });
		} else {
			setTimeout(run, 0);
		}
	}

	/** Every copy is painted already; this catches views rebuilt from scratch. */
	function scheduleRepaint() {
		if (rootElement?.dataset.highlightsLoaded !== "true") return;
		if (repaintTimer) clearTimeout(repaintTimer);
		repaintTimer = setTimeout(() => {
			highlightService?.repaintHighlights();
		}, 50);
	}

	// Hydrate auth state on client (mirrors navbar logic) so prerendered pages can enable highlights
	async function hydrateAuth() {
		try {
			if (!rootElement) return;
			if (rootElement.dataset.authenticated !== "true") {
				const data = await loadPageUserState();
				if (!data?.signedIn) return;
				rootElement.dataset.authenticated = "true";
			}
			scheduleRestore();
		} catch (e) {
			/* ignore */
		}
	}

	function liveRange(): Range | null {
		const selection = window.getSelection();
		if (!selection || selection.isCollapsed || !selection.rangeCount) {
			return null;
		}
		return selection.getRangeAt(0);
	}

	/** The range a menu action applies to. */
	function actionRange(): Range | null {
		const live = liveRange();
		if (live && live.toString().trim()) return live;
		return savedRange;
	}

	function elementOf(node: Node): Element | null {
		return node.nodeType === Node.ELEMENT_NODE
			? (node as Element)
			: node.parentElement;
	}

	function handleSelection(e: MouseEvent | TouchEvent) {
		if (!menu || !selectionHandler || !rootElement) return;
		const target = e.target as HTMLElement;
		if (menu.contains(target)) return;

		menu.style.display = "none";

		// SEARCH & FIND: Skip highlighting on components like Translation Memory popover
		if (target.closest?.(".tm-popover-overlay, .bottom-popover")) {
			return;
		}

		const selection = window.getSelection();
		if (!selectionHandler.isSelectionValid(selection)) return;
		const range = selection!.getRangeAt(0);

		const containerEl = elementOf(range.commonAncestorContainer);
		if (containerEl?.closest(".tm-popover-overlay, .bottom-popover")) {
			return;
		}
		if (!rootElement.contains(range.commonAncestorContainer)) return;

		if (checkPaliContext(target, selection!)) return;

		const intersectsCollapse = checkCollapseIntersection(range);

		// Visible before positioning: placement reads the menu's width.
		menu.style.display = "block";
		if (!selectionHandler.updateMenuPosition(range, menu, rootElement)) {
			menu.style.display = "none";
			return;
		}
		savedRange = range.cloneRange();

		const isAuthenticated = rootElement.dataset.authenticated === "true";
		if (!isAuthenticated) {
			// Non-authenticated users can only copy
			document.querySelectorAll<HTMLElement>(".color-swatch").forEach((swatch) => {
				swatch.style.display = "none";
			});
			const eraserBtn = document.getElementById("highlight-eraser");
			if (eraserBtn) eraserBtn.style.display = "none";
		} else {
			updateHighlightingAvailability(intersectsCollapse, range);
		}

		setupOutsideClickListener();
	}

	function isWithinCollapseElement(element: Element | null): boolean {
		return Boolean(element?.closest(".collapse-toggle"));
	}

	function checkCollapseIntersection(range: Range): boolean {
		if (isWithinCollapseElement(elementOf(range.startContainer))) return true;
		if (isWithinCollapseElement(elementOf(range.endContainer))) return true;
		const ancestor = elementOf(range.commonAncestorContainer);
		if (!ancestor) return false;
		for (const collapseEl of ancestor.querySelectorAll(".collapse-toggle")) {
			if (range.intersectsNode(collapseEl)) return true;
		}
		return false;
	}

	function updateHighlightingAvailability(
		intersectsCollapse: boolean,
		range: Range,
	): void {
		document.querySelectorAll<HTMLElement>(".color-swatch").forEach((swatch) => {
			swatch.style.display = intersectsCollapse ? "none" : "block";
		});

		const eraserBtn = document.getElementById("highlight-eraser");
		if (eraserBtn) {
			const canErase =
				!intersectsCollapse &&
				Boolean(highlightService?.rangeHasHighlight(range));
			eraserBtn.style.display = canErase ? "flex" : "none";
		}
	}

	function checkPaliContext(target: HTMLElement, selection: Selection): boolean {
		const isPaliParagraph = target.closest?.(".pali-paragraph");
		const isPaliLookupEnabled =
			localStorage.getItem("paliLookup") === "true";
		const selectedText = selection.toString().trim();
		const isSingleWord = selectedText && !selectedText.includes(" ");
		return Boolean(isPaliLookupEnabled && isPaliParagraph && isSingleWord);
	}

	function setupOutsideClickListener() {
		if (outsideClickListener) {
			document.removeEventListener("mousedown", outsideClickListener);
		}
		outsideClickListener = (e: MouseEvent) => {
			const target = e.target as Node;
			if (!menu.contains(target)) {
				menu.style.display = "none";
				savedRange = null;
				window.getSelection()?.removeAllRanges();
				document.removeEventListener("mousedown", outsideClickListener!);
				outsideClickListener = null;
			}
		};
		document.addEventListener("mousedown", outsideClickListener);
	}

	function finishMenuAction(): void {
		menu.style.display = "none";
		savedRange = null;
		window.getSelection()?.removeAllRanges();
	}

	function applyHighlight(color: HighlightColor): void {
		const range = actionRange();
		if (!range || !highlightService) return;
		if (checkCollapseIntersection(range)) {
			console.warn(
				"Attempted to highlight selection that intersects with collapse elements"
			);
			return;
		}
		highlightService.highlightRange(range, color);
		finishMenuAction();
	}

	function handleClear(): void {
		const range = actionRange();
		if (!range || !highlightService) return;
		if (checkCollapseIntersection(range)) return;
		highlightService.eraseRange(range);
		finishMenuAction();
	}

	function setupEventListeners(): void {
		document.addEventListener("mouseup", handleSelection);
		document.addEventListener("touchend", handleSelection);
		document.addEventListener("selectionchange", () => {
			if (!liveRange()) menu.style.display = "none";
		});

		document
			.querySelectorAll<HTMLButtonElement>(".color-swatch")
			.forEach((swatch) => {
				const apply = () => {
					const color = swatch.dataset.color as HighlightColor;
					if (color) applyHighlight(color);
				};
				swatch.addEventListener("touchend", (e) => {
					e.preventDefault();
					apply();
				});
				swatch.addEventListener("click", apply);
			});

		const eraserBtn = document.getElementById("highlight-eraser");
		if (eraserBtn) {
			eraserBtn.addEventListener("touchend", (e) => {
				e.preventDefault();
				handleClear();
			});
			eraserBtn.addEventListener("click", handleClear);
		}
	}

	async function init() {
		rootElement = document.getElementById("highlight-root");
		menu = document.getElementById("highlight-menu") as HTMLDivElement;
		if (!rootElement || rootElement.dataset.highlightDisabled === "true") return;
		void loadPageUserState();

		try {
			const [selectionHandlerModule, highlightServiceModule] =
				await Promise.all([
					import("../service/selectionHandler"),
					import("../service/highlightService"),
				]);

			selectionHandler = selectionHandlerModule;
			highlightService = highlightServiceModule;
			window.selectionHandler = selectionHandlerModule;
			window.highlightService = highlightServiceModule;

			updateDarkMode();
			updateTheme();
			window.addEventListener("themeToggled", updateDarkMode);
			document.addEventListener("themeChanged", updateTheme);
			document.addEventListener("layoutChanged", scheduleRepaint);
			document.addEventListener("paliModeChanged", scheduleRepaint);
			setupEventListeners();
			// Auth hydration schedules the restore without blocking interactivity
			hydrateAuth();
		} catch (error) {
			console.error("[highlight] Init error:", error);
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init);
	} else {
		init();
	}
</script>
