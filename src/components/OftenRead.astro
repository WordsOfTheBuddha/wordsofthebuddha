---
import { oftenRead } from "../utils/organicSearch";

interface Props {
	/** Hrefs already shown elsewhere on the page, such as Dhammapada on Discover. */
	omitHrefs?: string[];
}

const { omitHrefs = [] } = Astro.props;
const items = oftenRead.filter((item) => !omitHrefs.includes(item.href));
---

<section class="max-w-4xl mx-auto px-4 mb-14" aria-labelledby="often-read-heading">
	<h2 id="often-read-heading" class="text-2xl font-semibold mb-2">Often read</h2>
	<p class="mb-5 text-sm" style="color:var(--text-muted);">
		Discourses and teachings people come looking for, in parallel Pāli and English.
	</p>
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
		{
			items.map((item) => (
				<a
					href={item.href}
					class="block rounded-xl border px-4 py-3 no-underline transition-shadow hover:shadow-md"
					style="border-color:var(--surface-border); background:var(--surface-elevated); color:var(--text-color);"
				>
					<span class="block font-medium">{item.title}</span>
					<span class="block text-sm mt-0.5" style="color:var(--text-muted);">
						{item.detail}
					</span>
				</a>
			))
		}
	</div>
</section>
