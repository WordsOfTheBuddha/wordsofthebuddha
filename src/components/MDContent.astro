---
import { parseMarkdown } from "../utils/mdParser";
import { isViewFullTextFallbackOnly } from "../utils/contentParser";

interface Props {
	content: string;
	/**
	 * Whether the discourse has Pāli to show in a second column. The panels
	 * themselves are cloned from the interleaved article in the browser.
	 */
	splitAvailable?: boolean;
	/** Paragraph-level Pāli for reference-fallback pages (default view). */
	refPaliOnlyContent?: string;
	referenceFallback?: boolean;
}

const {
	content,
	splitAvailable = false,
	refPaliOnlyContent,
	referenceFallback = false,
} = Astro.props;
const parsedInterleaved = await parseMarkdown(content);
const parsedRefPaliOnly = refPaliOnlyContent
	? await parseMarkdown(refPaliOnlyContent)
	: null;
/** Subset URLs with no matched section/paragraphs: skip content-fade (nothing to align). */
const showFallbackImmediately = isViewFullTextFallbackOnly(content);
---

{
	referenceFallback && parsedRefPaliOnly ? (
		<div class="ref-pali-only-view">
			<article
				class="content-fade md-content prose prose-lg dark:prose-invert interleaved-article visible"
				set:html={parsedRefPaliOnly}
			/>
		</div>
	) : null
}
<div class:list={["ref-translation-view", !referenceFallback && "contents"]}>
	<!-- Interleaved article (default) -->
	<article
		class:list={[
			"md-content prose prose-lg dark:prose-invert interleaved-article",
			showFallbackImmediately
				? "subset-fallback"
				: "content-fade",
		]}
		aria-hidden="false"
		set:html={parsedInterleaved}
	/>

	<!-- Split wrapper: filled by splitViewClient.ts from the article above -->
	{splitAvailable && !showFallbackImmediately && (
		<div
			class:list={["content-fade split-wrapper"]}
			aria-hidden="true"
		>
			<article
				id="panel1"
				class="split-panel md-content prose prose-lg dark:prose-invert"
			/>
			<article
				id="panel2"
				class="split-panel md-content prose prose-lg dark:prose-invert"
			/>
		</div>
	)}
</div>

<style>
	.md-content :global(.pali-paragraph) {
		opacity: 0.8;
		margin-bottom: 0;
		color: var(--text-color);
		font-family: "Gentium Plus", serif;
	}
	/* Hide Pali paragraphs unless globally enabled */
	:global(html:not(.pali-on)) .md-content :global(.pali-paragraph) {
		display: none !important;
	}
	.md-content :global(.english-paragraph) {
		margin-top: 0.5rem;
	}
	:global(html.pali-on) .md-content :global(.pali-only-notice) {
		display: none;
	}
	/* Reference-fallback pages in Pali-only mode (default): render the full
	   page as Pali source text and hide the reference translation. */
	:global(html.ref-pali-only) .md-content :global(.pali-paragraph) {
		display: block !important;
		opacity: 1;
	}
	:global(html.ref-pali-only) .md-content :global(.english-paragraph) {
		display: none !important;
	}
	/* Pali-only always reads interleaved; ignore a remembered split layout */
	:global(html.ref-pali-only) .split-wrapper {
		display: none !important;
	}
	:global(html.ref-pali-only) .interleaved-article {
		display: block !important;
	}
	/* Reference-fallback: toggle between paragraph Pāli and segment-aligned translation */
	:global(html.ref-pali-only) .ref-translation-view {
		display: none !important;
	}
	:global(html:not(.ref-pali-only)) .ref-pali-only-view {
		display: none !important;
	}
	:global(.ref-pali-only-view) .md-content :global(.pali-paragraph) {
		display: block !important;
		opacity: 1;
	}
	.md-content :global(.reference-translation-credit) {
		font-size: 0.75rem;
		line-height: 1.4;
		opacity: 0.55;
		margin: 0 0 1rem;
		font-style: italic;
	}
	.pali-content {
		margin-bottom: 2rem;
		opacity: 0.8;
		font-style: italic;
	}

	.pali-content + .english-content {
		padding-top: 1rem;
		border-top: 1px solid rgba(156, 163, 175, 0.2);
	}

	/* Subset URLs with no matched section: always show interleaved fallback. */
	.subset-fallback {
		opacity: 1;
	}

	:global(html.split.pali-on) .subset-fallback {
		display: block !important;
	}

	.split-wrapper {
		display: none; /* hidden by default */
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		min-height: 100%;
		position: relative;
		opacity: 0;
		transition: opacity 0.3s ease-in;
	}

	/* Show split only when explicitly enabled and pali is on */
	:global(html.split.pali-on) .split-wrapper {
		display: grid;
	}

	/* Hide interleaved when split + pali-on (except subset fallback notices) */
	:global(html.split.pali-on) .interleaved-article:not(.subset-fallback) {
		display: none;
	}

	.split-wrapper.visible {
		opacity: 1;
	}

	.split-panel {
		padding: 0;
		width: 100%;
		min-width: 0;
		overflow-wrap: break-word;
		word-wrap: break-word;
	}

	.split-panel.prose {
		max-width: none;
	}

	/* Add styles for heading spacing in split mode */
	.split-wrapper h3,
	.split-wrapper h4 {
		margin-top: 2rem;
		padding-bottom: 1rem;
		position: relative;
	}

	/* Split pair gap (JS may raise --min-para-spacing to align columns).
	   Copy-break <br>s no longer add 2lh inside these boxes. */
	.split-wrapper [data-pair-id] {
		margin-bottom: var(--min-para-spacing, 1rem);
	}

	/* Ensure consistent base margins; flow-root prevents margin collapse between pairs */
	.split-panel [data-pair-id] {
		display: flow-root;
		margin-top: 8px; /* Match the English paragraph margin */
	}

	/* Empty EN slots in split view reserve vertical space via JS min-height */
	.split-panel .english-pair-spacer {
		margin-top: 8px;
		margin-bottom: 0;
		padding: 0;
		border: 0;
	}

	.split-panel .english-pair-spacer-inner {
		display: block;
		height: 0;
		overflow: hidden;
	}

	/* Common fade transition */
	.content-fade {
		opacity: 0;
		transition: opacity 0.3s ease-in;
	}

	.content-fade.visible {
		opacity: 1;
	}

	@media print {
		/* Ensure the visible container prints at full opacity and black text */
		.content-fade { opacity: 1 !important; }
		.interleaved-article, .split-wrapper { color: #000 !important; }
	}

	/* Responsive adjustments for split view */
	@media (min-width: 768px) {
		/* For medium and larger screens, set custom column widths */
		.split-wrapper {
			grid-template-columns: 52% 48%;
		}

		/* Give more space to English for medium and larger screens when verse content is present */
		.split-wrapper.has-verse {
			grid-template-columns: 55% 45%;
		}
	}

	@media (max-width: 767px) {
		.split-wrapper {
			grid-template-columns: 1fr; /* Stack vertically on mobile */
		}
	}

	/* After mobile stacking: print must not collapse split into one column of
	   English then Pāli. Pair rows are built in JS; keep them two-up. */
	@media print {
		:global(.paragraph-pair-grid) {
			display: grid !important;
			grid-template-columns: 1fr 1fr !important;
			column-gap: 1rem;
			align-items: start;
			page-break-inside: avoid;
			break-inside: avoid;
		}
	}
</style>

<script>
	import { ensureSplitPanels } from "../utils/splitViewClient";
	import { pairSplitWrapperForPrint } from "../utils/splitPrintLayout";

	function isSplitVisible() {
		const root = document.documentElement;
		if (!root.classList.contains("split") || !root.classList.contains("pali-on")) {
			return false;
		}
		const wrapper = document.querySelector(".split-wrapper");
		if (!wrapper) return false;
		const style = window.getComputedStyle(wrapper);
		return style.display !== "none" && style.visibility !== "hidden";
	}

	function showContent() {
		const contents = document.querySelectorAll(".content-fade");
		if (contents && contents.length) {
			requestAnimationFrame(() => {
				contents.forEach((el) => el.classList.add("visible"));
			});
		}
	}

	function updateA11yVisibility() {
		const interleaved = document.querySelector(
			".interleaved-article"
		) as HTMLElement | null;
		const split = document.querySelector(".split-wrapper") as
			| HTMLElement
			| null;
		const splitOn = isSplitVisible();
		if (interleaved) interleaved.setAttribute("aria-hidden", splitOn ? "true" : "false");
		if (split) split.setAttribute("aria-hidden", splitOn ? "false" : "true");
	}

	function waitForFontsReady(timeoutMs = 300) {
		return new Promise<void>((resolve) => {
			let done = false;
			const finish = () => {
				if (!done) {
					done = true;
					resolve();
				}
			};
			if ((document as any).fonts && (document as any).fonts.ready) {
				Promise.race([
					(document as any).fonts.ready,
					new Promise((r) => setTimeout(r, timeoutMs)),
				]).then(finish);
			} else {
				setTimeout(finish, 0);
			}
		});
	}

	function isHeadingEl(el: Element): boolean {
		return /^H[1-6]$/.test(el.tagName);
	}

	function pairInPanel(
		panelId: "#panel1" | "#panel2",
		pairId: string | null,
	): HTMLElement | null {
		if (!pairId) return null;
		return document.querySelector(
			`${panelId} [data-pair-id="${pairId}"]`,
		);
	}

	/**
	 * Headings live only in the English column. When the previous English
	 * paragraph is shorter than its Pāli pair, a heading can sit in that
	 * leftover gap — but document flow parks it under the previous paragraph.
	 * If it is closer to that previous end than to the next pair, slide it
	 * down by moving margin from the next English paragraph onto the heading
	 * so the pair tops stay put.
	 *
	 * Skip when there is no leftover beside taller Pāli: a wrapping heading
	 * is then taking real English space, not filling a gap, and stealing the
	 * next pair's margin leaves Pāli starting at the heading's first line.
	 */
	function nudgeHeadingsTowardNextPair(leftPanel: Element) {
		const children = Array.from(leftPanel.children);
		let i = 0;
		while (i < children.length) {
			if (!isHeadingEl(children[i])) {
				i++;
				continue;
			}
			const groupStart = i;
			while (i < children.length && isHeadingEl(children[i])) i++;
			const groupEnd = i - 1;

			let prevPair: HTMLElement | null = null;
			for (let j = groupStart - 1; j >= 0; j--) {
				if (children[j].hasAttribute("data-pair-id")) {
					prevPair = children[j] as HTMLElement;
					break;
				}
			}
			let nextPair: HTMLElement | null = null;
			for (let j = groupEnd + 1; j < children.length; j++) {
				if (children[j].hasAttribute("data-pair-id")) {
					nextPair = children[j] as HTMLElement;
					break;
				}
			}
			if (!prevPair || !nextPair) continue;

			const prevPali = pairInPanel(
				"#panel2",
				prevPair.getAttribute("data-pair-id"),
			);
			if (!prevPali) continue;

			const firstHeading = children[groupStart] as HTMLElement;
			const lastHeading = children[groupEnd] as HTMLElement;
			void firstHeading.offsetHeight;

			const prevEngBottom = prevPair.getBoundingClientRect().bottom;
			const leftover =
				prevPali.getBoundingClientRect().bottom - prevEngBottom;
			const headingHeight =
				lastHeading.getBoundingClientRect().bottom -
				firstHeading.getBoundingClientRect().top;
			if (leftover < headingHeight) continue;

			const distToPrev =
				firstHeading.getBoundingClientRect().top - prevEngBottom;
			const distToNext =
				nextPair.getBoundingClientRect().top -
				lastHeading.getBoundingClientRect().bottom;

			// Already overlapping the next pair, or already closer to it.
			if (distToNext <= 1 || distToPrev + 1 >= distToNext) continue;

			const shift = Math.min(
				distToNext,
				Math.max(0, parseFloat(getComputedStyle(nextPair).marginTop) || 0),
			);
			if (shift <= 1) continue;

			const headingMargin =
				parseFloat(getComputedStyle(firstHeading).marginTop) || 0;
			const nextTopBefore = nextPair.getBoundingClientRect().top;
			firstHeading.style.marginTop = `${headingMargin + shift}px`;
			void nextPair.offsetHeight;
			const drift =
				nextPair.getBoundingClientRect().top - nextTopBefore;
			const nextMargin =
				parseFloat(getComputedStyle(nextPair).marginTop) || 0;
			nextPair.style.marginTop = `${Math.max(0, nextMargin - drift)}px`;
		}
	}

	/** Keep pair tops aligned after heading margin moves English without Pāli. */
	function resyncPairTops(paraIds: (string | null)[]) {
		const threshold = 0.5;
		const maxPasses = 4;
		for (let pass = 0; pass < maxPasses; pass++) {
			let moved = false;
			for (const id of paraIds) {
				const eng = pairInPanel("#panel1", id);
				const pali = pairInPanel("#panel2", id);
				if (!eng || !pali) continue;
				void eng.offsetHeight;
				const engTop = eng.getBoundingClientRect().top;
				const paliTop = pali.getBoundingClientRect().top;
				const diff = engTop - paliTop;
				if (Math.abs(diff) <= threshold) continue;
				moved = true;
				// Always push the higher box down so earlier pairs are not pulled up.
				if (diff > 0) {
					const margin = parseFloat(getComputedStyle(pali).marginTop) || 0;
					pali.style.marginTop = `${margin + diff}px`;
				} else {
					const margin = parseFloat(getComputedStyle(eng).marginTop) || 0;
					eng.style.marginTop = `${margin - diff}px`;
				}
			}
			if (!moved) break;
		}
	}

	async function adjustParagraphAlignment() {
		// Only attempt when split is active and visible
		if (!isSplitVisible()) {
			return;
		}

		// Panels must exist before anything is measured.
		ensureSplitPanels();

		await waitForFontsReady();
		await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
		const splitWrapper = document.querySelector(".split-wrapper");

		if (splitWrapper) {
			// Check if there are any verse elements in the English content
			const verseElements = document.querySelectorAll("#panel1 .verse");
			if (verseElements.length > 0) {
				splitWrapper.classList.add("has-verse");
			} else {
				splitWrapper.classList.remove("has-verse");
			}

			const leftPanel = document.querySelector("#panel1");
			const rightPanel = document.querySelector("#panel2");

			if (!leftPanel || !rightPanel) return;

			// Reset margins and spacer heights to base value
			document
				.querySelectorAll(
					"#panel1 [data-pair-id], #panel2 [data-pair-id]"
				)
				.forEach((el) => {
					const node = el as HTMLElement;
					node.style.marginTop = "8px";
					if (node.classList.contains("english-pair-spacer")) {
						node.style.minHeight = "";
					}
				});
			leftPanel
				.querySelectorAll("h1, h2, h3, h4, h5, h6")
				.forEach((el) => {
					(el as HTMLElement).style.marginTop = "";
				});

			// Get all paragraph pairs
			const engParas = document.querySelectorAll(
				"#panel1 [data-pair-id]"
			);
			const paraIds = Array.from(engParas).map((p) =>
				p.getAttribute("data-pair-id")
			);

			// Empty English rows must match paired Pāli height so the left column
			// doesn't collapse when Sujato skips peyyāla segments.
			paraIds.forEach((id) => {
				const eng = document.querySelector(
					`#panel1 [data-pair-id="${id}"]`
				);
				const pali = document.querySelector(
					`#panel2 [data-pair-id="${id}"]`
				);
				if (!eng || !pali) return;

				const engText = (eng.textContent || "")
					.replace(/\u200B/g, "")
					.replace(/\s+/g, "")
					.trim();
				if (!engText) {
					const paliHeight = (pali as HTMLElement).getBoundingClientRect()
						.height;
					if (paliHeight > 0) {
						(eng as HTMLElement).style.minHeight = `${paliHeight}px`;
					}
				}
			});

			// First align the tops of each paragraph pair
			paraIds.forEach((id) => {
				const eng = document.querySelector(
					`#panel1 [data-pair-id="${id}"]`
				);
				const pali = document.querySelector(
					`#panel2 [data-pair-id="${id}"]`
				);

				if (eng && pali) {
					void (eng as HTMLElement).offsetHeight;
					void (pali as HTMLElement).offsetHeight;

					const engRect = eng.getBoundingClientRect();
					const paliRect = pali.getBoundingClientRect();

					const topDiff = engRect.top - paliRect.top;
					if (Math.abs(topDiff) > 1) {
						if (topDiff > 0) {
							(pali as HTMLElement).style.marginTop =
								`${8 + topDiff}px`;
						} else {
							(eng as HTMLElement).style.marginTop =
								`${8 - topDiff}px`;
						}
					}
				}
			});

			// Add consistent spacing between paragraph pairs
			const PARAGRAPH_SPACING = 24; // Constant spacing between paragraph blocks

			for (let i = 0; i < paraIds.length - 1; i++) {
				const currentId = paraIds[i];
				const nextId = paraIds[i + 1];

				const currentEng = document.querySelector(
					`#panel1 [data-pair-id="${currentId}"]`
				);
				const currentPali = document.querySelector(
					`#panel2 [data-pair-id="${currentId}"]`
				);
				const nextEng = document.querySelector(
					`#panel1 [data-pair-id="${nextId}"]`
				);
				const nextPali = document.querySelector(
					`#panel2 [data-pair-id="${nextId}"]`
				);

				if (currentEng && currentPali && nextEng && nextPali) {
					// Force reflow for accurate measurements
					void (currentEng as HTMLElement).offsetHeight;
					void (currentPali as HTMLElement).offsetHeight;

					const engRect = currentEng.getBoundingClientRect();
					const paliRect = currentPali.getBoundingClientRect();

					// Find the bottom of the tallest paragraph in current pair
					const maxBottom = Math.max(engRect.bottom, paliRect.bottom);

					// Set consistent spacing from tallest paragraph
					const nextEngRect = nextEng.getBoundingClientRect();
					const nextPaliRect = nextPali.getBoundingClientRect();

					// Calculate how much additional margin is needed
					const engMarginNeeded =
						maxBottom + PARAGRAPH_SPACING - nextEngRect.top;
					const paliMarginNeeded =
						maxBottom + PARAGRAPH_SPACING - nextPaliRect.top;

					if (engMarginNeeded > 0) {
						const currentMargin =
							parseFloat(getComputedStyle(nextEng).marginTop) || 8;
						(nextEng as HTMLElement).style.marginTop =
							`${currentMargin + engMarginNeeded}px`;
					}

					if (paliMarginNeeded > 0) {
						const currentMargin =
							parseFloat(getComputedStyle(nextPali).marginTop) || 8;
						(nextPali as HTMLElement).style.marginTop =
							`${currentMargin + paliMarginNeeded}px`;
					}
				}
			}

			nudgeHeadingsTowardNextPair(leftPanel);
			resyncPairTops(paraIds);
		}

		showContent();
	}

	// Split view must measure paragraph pairs before it is shown, so it stays
	// gated on alignment. The default interleaved view has nothing to align and
	// must not wait for window.load, which trails every image and script.
	function revealInitialContent() {
		updateA11yVisibility();
		if (isSplitVisible()) {
			adjustParagraphAlignment();
		} else {
			showContent();
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", revealInitialContent);
	} else {
		revealInitialContent();
	}

	// Re-align once fonts and images settle, without gating visibility on it.
	window.addEventListener("load", () => {
		setTimeout(() => {
			updateA11yVisibility();
			adjustParagraphAlignment();
			showContent();
		}, 50);
	});

	// Add resize listener to handle window size changes
	window.addEventListener("resize", () => {
		// Debounce resize events
		if (window.resizeTimer) clearTimeout(window.resizeTimer);
		window.resizeTimer = setTimeout(() => {
			adjustParagraphAlignment();
		}, 100);
	});

	// When layout toggles, ensure visibility state is applied and alignment recalculated
	document.addEventListener("layoutChanged", () => {
		updateA11yVisibility();
		showContent();
		if (isSplitVisible()) {
			setTimeout(() => {
				adjustParagraphAlignment();
			}, 10);
		}
	});

	// Also respond to Pāli mode changes (when user toggles Pāli on/off)
	document.addEventListener("paliModeChanged", () => {
		updateA11yVisibility();
		showContent();
		if (isSplitVisible()) {
			setTimeout(() => {
				adjustParagraphAlignment();
			}, 10);
		}
	});

	function applyPrintGridLayout() {
		const contentArea = document.querySelector(".print-formatted");
		if (!contentArea || !contentArea.classList.contains("split-wrapper")) {
			return;
		}
		pairSplitWrapperForPrint(contentArea);
	}

	function restoreSplitLayout() {
		const splitWrapper = document.querySelector(
			".split-wrapper",
		) as HTMLElement | null;
		if (!splitWrapper) return;
		splitWrapper.style.display = "";
		if (splitWrapper.querySelector(".paragraph-pair-grid")) {
			delete splitWrapper.dataset.splitBuilt;
			ensureSplitPanels();
		}
		setTimeout(() => {
			adjustParagraphAlignment();
		}, 50);
	}

	// Listen for print formatting completion from PrintFormatter
	window.addEventListener("print-formatting-complete", () => {
		applyPrintGridLayout();
	});

	window.addEventListener("afterprint", restoreSplitLayout);
</script>

<script>
	declare global {
		interface Window {
			resizeTimer?: ReturnType<typeof setTimeout>;
		}
	}
</script>
