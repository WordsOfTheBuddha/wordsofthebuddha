---
export const prerender = false;
import "../styles/bottomDrawer.css";
---

<!-- this is a client-only script component -->
<script>
	import { cleanPaliWordForLookup } from "../utils/cleanPaliWord";
	import { replaceGlossMarkup } from "../utils/glossDisplay";

	// The ms-dpd dictionary chunk is ~1.5MB; import it on first lookup rather than
	// as a static dependency of every page load.
	let lookupSingleWord:
		| typeof import("../utils/paliLookup").lookupSingleWord
		| undefined;
	async function loadPaliLookup() {
		if (!lookupSingleWord) {
			({ lookupSingleWord } = await import("../utils/paliLookup"));
		}
		return lookupSingleWord;
	}

	let lookupPedHeadword:
		| typeof import("../utils/pedLookup").lookupPedHeadword
		| undefined;
	let linkifyPedHtml:
		| typeof import("../utils/pedCitationLinks").linkifyPedHtml
		| undefined;
	async function loadPedLookup() {
		if (!lookupPedHeadword) {
			({ lookupPedHeadword } = await import("../utils/pedLookup"));
		}
		if (!linkifyPedHtml) {
			({ linkifyPedHtml } = await import("../utils/pedCitationLinks"));
		}
		return { lookupPedHeadword, linkifyPedHtml };
	}

	// Helper function to parse Markdown-style links
	function parseMarkdownLinks(text: string) {
		return text.replace(
			/\[([^\]]+)\]\(([^)]+)\)/g,
			'<a href="$2" class="tooltip-link">$1</a>',
		);
	}

	// Helper to properly escape HTML for attribute values
	function escapeHtml(text: string) {
		return text
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#039;");
	}

	// Bottom popover manager
	class BottomPopover {
		private popover: HTMLElement | null = null;
		private isVisible: boolean = false;

		constructor() {
			this.createPopover();
		}

		private createPopover() {
			this.popover = document.createElement("div");
			this.popover.className = "bottom-popover";
			this.popover.innerHTML = `
				<div class="popover-content">
					<button class="close-btn" aria-label="Close">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.75.75 0 1 1 1.06 1.06L9.06 8l3.22 3.22a.75.75 0 1 1-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 0 1-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06z"/>
						</svg>
					</button>
					<div class="popover-body"></div>
				</div>
			`;

			// Add close button event
			const closeBtn = this.popover.querySelector(".close-btn");
			closeBtn?.addEventListener("click", () => this.hide());

			document.body.appendChild(this.popover);
		}

		show(
			content: string,
			contentType: "markdown" | "dictionary",
			primaryText?: string,
		) {
			if (!this.popover) return;

			const contentEl = this.popover.querySelector(".popover-body");
			if (!contentEl) return;

			if (contentType === "markdown") {
				// For |text::tooltip| content - show primary word/phrase
				// Extract bracketed text (Pali term) from content
				const bracketMatch = content.match(/\[([^\]]+)\]$/);
				const paliTerm = bracketMatch ? bracketMatch[1] : null;
				const cleanContent = paliTerm
					? content.replace(/\s*\[([^\]]+)\]$/, "")
					: content;

				contentEl.innerHTML = `
					<div class="tooltip-content markdown-content">
						${
							primaryText
								? `
							<div class="title">
								<span class="title-text">${primaryText}</span>
								${paliTerm ? `<span class="pali-term">[${paliTerm}]</span>` : ""}
							</div>
						`
								: ""
						}
						<div class="definition">${cleanContent}</div>
					</div>
				`;

				// Remove any existing navigation controls for markdown content
				this.removeNavigationControls();
			} else {
				// For Pali dictionary content
				contentEl.innerHTML = content;
			}

			this.popover.classList.add("visible");
			this.isVisible = true;

			// Handle link clicks within popover
			this.setupLinkHandlers();
		}

		hide() {
			if (!this.popover) return;
			this.popover.classList.remove("visible");
			this.isVisible = false;
			dictionaryLookupStack.length = 0;
			currentDictionaryWord = "";
			preferredDictPanel = "dpd";
			preferredPedPartIndex = 0;
		}

		private setupLinkHandlers() {
			const links = this.popover?.querySelectorAll(".tooltip-link, a");
			links?.forEach((link) => {
				link.addEventListener("click", (e) => {
					if (!(link instanceof HTMLAnchorElement)) return;
					const href = link.getAttribute("href") || "";
					if (!href) return;

					// PED citation links: new tab, keep drawer open for reading
					const opensNewTab =
						link.classList.contains("ped-ref-link") ||
						link.target === "_blank";
					if (opensNewTab) {
						e.preventDefault();
						window.open(href, "_blank", "noopener,noreferrer");
						return;
					}

					e.preventDefault();
					window.location.href = href;
					this.hide();
				});
			});

			// Top-row sandhi: on PED → switch headword; on DPD → nested lookup
			const lookupTargets = this.popover?.querySelectorAll(
				"[data-lookup-word]",
			);
			lookupTargets?.forEach((el) => {
				el.addEventListener("click", (e) => {
					e.preventDefault();
					e.stopPropagation();
					const pedIdx = el.getAttribute("data-ped-part");
					const shell = this.popover?.querySelector(".dict-shell");
					if (
						preferredDictPanel === "ped" &&
						pedIdx != null &&
						shell?.querySelector(`[data-ped-part-body="${pedIdx}"]`)
					) {
						preferredPedPartIndex = Number(pedIdx) || 0;
						applyPedPartPreference(shell, pedIdx);
						return;
					}
					const raw = el.getAttribute("data-lookup-word") || "";
					const word = cleanPaliWordForLookup(raw);
					if (word) showDictionaryPopover(word, false, { nested: true });
				});
			});

			const backBtn = this.popover?.querySelector("[data-dict-back]");
			backBtn?.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				goBackDictionaryLookup();
			});

			// DPD / PED panel switcher (chrome stays fixed; only bodies toggle)
			const tabs = this.popover?.querySelectorAll("[data-dict-panel]");
			tabs?.forEach((tab) => {
				tab.addEventListener("click", (e) => {
					e.preventDefault();
					e.stopPropagation();
					const panel = tab.getAttribute("data-dict-panel");
					if (panel !== "dpd" && panel !== "ped") return;
					preferredDictPanel = panel;
					applyDictPanelPreference(
						this.popover?.querySelector(".dict-shell"),
						panel,
						true,
					);
				});
			});

			// Fallback PED chips (only when construction cannot cover all entries)
			const pedChips = this.popover?.querySelectorAll(
				".ped-part-chips [data-ped-part]",
			);
			pedChips?.forEach((chip) => {
				chip.addEventListener("click", (e) => {
					e.preventDefault();
					e.stopPropagation();
					const idx = chip.getAttribute("data-ped-part");
					if (idx == null) return;
					preferredPedPartIndex = Number(idx) || 0;
					applyPedPartPreference(
						this.popover?.querySelector(".dict-shell"),
						idx,
					);
				});
			});
		}

		isOpen() {
			return this.isVisible;
		}

		// Helper methods for navigation
		getPopoverElement() {
			return this.popover;
		}

		addNavigationControls(html: string) {
			const popoverContent =
				this.popover?.querySelector(".popover-content");
			if (popoverContent) {
				// Remove existing navigation controls
				const existingNav = popoverContent.querySelector(
					".navigation-controls",
				);
				if (existingNav) existingNav.remove();

				// Add new navigation controls
				popoverContent.insertAdjacentHTML("beforeend", html);
			}
		}

		removeNavigationControls() {
			const navControls = this.popover?.querySelector(
				".navigation-controls",
			);
			if (navControls) {
				navControls.remove();
			}
		}
	}

	// Global popover instance
	let bottomPopover: BottomPopover;

	// Navigation state
	let currentWords: HTMLElement[] = [];
	let currentWordIndex: number = -1;
	let isNavigationMode: boolean = false;

	function replaceTooltips(element: HTMLElement) {
		for (let node of element.childNodes) {
			if (node.nodeType === Node.TEXT_NODE) {
				// Skip if we're already inside a pali-word span
				if (node.parentElement?.closest(".pali-word")) {
					continue;
				}

				let text = node.textContent || "";
				// Only process if the text contains tooltip pattern
				if (!/\|.+?::.+?\|/.test(text)) {
					continue; // No tooltip pattern, leave text node as-is
				}
				// Replace |text::tooltip| and |text::tooltip::tts-override| patterns.
				// Four-colon vocatives with empty/punctuation TTS are omitted
				// (same rule as listen-mode). Other empty-tooltip forms stay plain text.
				text = replaceGlossMarkup(text, (textPart, tooltip) => {
					const parsedTooltip = parseMarkdownLinks(tooltip);
					return `<span class="tooltip-text" data-tooltip-content="${escapeHtml(parsedTooltip)}">${textPart}</span>`;
				});
				const span = document.createElement("span");
				span.innerHTML = text;
				if (node.parentNode) {
					node.parentNode.replaceChild(span, node);
				}
			} else if (
				node.nodeType === Node.ELEMENT_NODE &&
				node instanceof HTMLElement
			) {
				replaceTooltips(node);
			}
		}
	}

	// Navigation functions
	function enableWordNavigation(clickedWord: HTMLElement) {
		isNavigationMode = true;

		// Check if the clicked word is inside a TM popover - scope navigation to popover only
		const tmPopover = clickedWord.closest(".tm-popover");

		let allWords: HTMLElement[];
		if (tmPopover) {
			// Only get pali words within the TM popover
			allWords = Array.from(
				tmPopover.querySelectorAll(".pali-word"),
			) as HTMLElement[];
		} else {
			// Get ALL pali words from page EXCEPT those inside TM popovers
			allWords = (
				Array.from(
					document.querySelectorAll(".pali-word"),
				) as HTMLElement[]
			).filter((word) => !word.closest(".tm-popover"));
		}

		// Filter out words that are not visible (e.g., in hidden split panel or interleaved view)
		currentWords = allWords.filter((el) => {
			// Check if element or any ancestor is hidden via aria-hidden
			if (el.closest('[aria-hidden="true"]')) {
				return false;
			}
			// Check if element has no offset parent (detached or display:none ancestor)
			if (el.offsetParent === null) {
				// Exception: fixed/sticky positioned elements have null offsetParent but are visible
				const style = window.getComputedStyle(el);
				if (style.position !== "fixed" && style.position !== "sticky") {
					return false;
				}
			}
			// Check computed visibility
			const style = window.getComputedStyle(el);
			if (style.display === "none" || style.visibility === "hidden") {
				return false;
			}
			// Check if parent article/container is hidden
			const parentArticle = el.closest(
				"article, .split-wrapper, .interleaved-article",
			);
			if (parentArticle) {
				const parentStyle = window.getComputedStyle(parentArticle);
				if (
					parentStyle.display === "none" ||
					parentStyle.visibility === "hidden"
				) {
					return false;
				}
			}
			return true;
		});

		currentWordIndex = currentWords.indexOf(clickedWord);
		highlightCurrentWord();
	}

	function enableTooltipNavigation(clickedTooltip: HTMLElement) {
		isNavigationMode = true;

		// Get ALL tooltip elements from the page and filter out invalid ones
		const allTooltips = Array.from(
			document.querySelectorAll(".tooltip-text"),
		) as HTMLElement[];
		currentWords = allTooltips.filter((el) => {
			const text = el.textContent?.trim();
			const content = el.getAttribute("data-tooltip-content");
			// Filter out tooltips with template variables or empty content
			if (
				!text ||
				!content ||
				text.includes("${") ||
				content.includes("${") ||
				text === "${textPart}"
			) {
				return false;
			}
			// Filter out tooltips that are not visible (e.g., in hidden split panel)
			// Check if element or any ancestor is hidden
			const isVisible =
				el.offsetParent !== null ||
				el.closest('[aria-hidden="true"]') === null;
			if (!isVisible) {
				return false;
			}
			// Also check computed visibility
			const style = window.getComputedStyle(el);
			if (style.display === "none" || style.visibility === "hidden") {
				return false;
			}
			// Check if parent article/container is hidden
			const parentArticle = el.closest(
				"article, .split-wrapper, .interleaved-article",
			);
			if (parentArticle) {
				const parentStyle = window.getComputedStyle(parentArticle);
				if (
					parentStyle.display === "none" ||
					parentStyle.visibility === "hidden"
				) {
					return false;
				}
			}
			return true;
		});

		// Find the index - try direct reference first
		currentWordIndex = currentWords.indexOf(clickedTooltip);

		// If not found (element reference mismatch), find by matching text content
		if (currentWordIndex === -1) {
			const clickedText = clickedTooltip.textContent?.trim();
			const clickedContent = clickedTooltip.getAttribute(
				"data-tooltip-content",
			);
			currentWordIndex = currentWords.findIndex(
				(el) =>
					el.textContent?.trim() === clickedText &&
					el.getAttribute("data-tooltip-content") === clickedContent,
			);
		}

		highlightCurrentWord();
	}

	function disableWordNavigation() {
		isNavigationMode = false;
		currentWordIndex = -1;
		currentWords = [];
		clearWordHighlights();
		bottomPopover.removeNavigationControls();
	}

	function navigateToNextWord() {
		if (currentWordIndex < currentWords.length - 1) {
			currentWordIndex++;
			highlightCurrentWord();
			showCurrentWordDefinition();
			updateNavigationButtons();
		}
	}

	function navigateToPreviousWord() {
		if (currentWordIndex > 0) {
			currentWordIndex--;
			highlightCurrentWord();
			showCurrentWordDefinition();
			updateNavigationButtons();
		}
	}

	function navigateVertically(direction: "up" | "down") {
		const currentWord = currentWords[currentWordIndex];
		if (!currentWord) return;

		const targetWord = findWordVertically(currentWord, direction);
		if (targetWord) {
			const targetIndex = currentWords.indexOf(targetWord);
			if (targetIndex >= 0) {
				currentWordIndex = targetIndex;
				highlightCurrentWord();
				showCurrentWordDefinition();
				updateNavigationButtons();
			}
		}
	}

	// Spatial navigation function
	function findWordVertically(
		currentWord: HTMLElement,
		direction: "up" | "down",
	): HTMLElement | null {
		const currentRect = currentWord.getBoundingClientRect();
		const currentCenter = {
			x: currentRect.left + currentRect.width / 2,
			y: currentRect.top + currentRect.height / 2,
		};

		let bestMatch: HTMLElement | null = null;
		let bestDistance = Infinity;

		currentWords.forEach((word) => {
			if (word === currentWord) return;

			const wordRect = word.getBoundingClientRect();
			const wordCenter = {
				x: wordRect.left + wordRect.width / 2,
				y: wordRect.top + wordRect.height / 2,
			};

			// Check if word is in the right vertical direction
			const isInDirection =
				direction === "up"
					? wordCenter.y < currentCenter.y - 5 // 5px threshold to avoid same-line words
					: wordCenter.y > currentCenter.y + 5;

			if (!isInDirection) return;

			// Calculate weighted distance (prioritize vertical proximity, then horizontal)
			const verticalDistance = Math.abs(wordCenter.y - currentCenter.y);
			const horizontalDistance = Math.abs(wordCenter.x - currentCenter.x);

			// Weight vertical movement as primary, horizontal as secondary
			const totalDistance = verticalDistance + horizontalDistance * 0.2;

			if (totalDistance < bestDistance) {
				bestDistance = totalDistance;
				bestMatch = word;
			}
		});

		return bestMatch;
	}

	function updateNavigationButtons() {
		const popover = bottomPopover.getPopoverElement();
		const prevBtn = popover?.querySelector(
			".nav-prev",
		) as HTMLButtonElement;
		const nextBtn = popover?.querySelector(
			".nav-next",
		) as HTMLButtonElement;

		if (prevBtn) {
			prevBtn.disabled = currentWordIndex <= 0;
		}
		if (nextBtn) {
			nextBtn.disabled = currentWordIndex >= currentWords.length - 1;
		}
	}

	function highlightCurrentWord() {
		clearWordHighlights();

		if (currentWordIndex >= 0 && currentWordIndex < currentWords.length) {
			const currentWord = currentWords[currentWordIndex];
			// Use different highlight classes for different types
			if (currentWord.classList.contains("pali-word")) {
				currentWord.classList.add("pali-word-highlighted");
			} else if (currentWord.classList.contains("tooltip-text")) {
				currentWord.classList.add("tooltip-text-highlighted");
			}

			// Only scroll into view if NOT inside a TM popover
			// (TM popover has its own scrollable container)
			const isInPopover = currentWord.closest(".tm-popover");
			if (!isInPopover) {
				currentWord.scrollIntoView({
					behavior: "smooth",
					block: "center",
					inline: "center",
				});
			}
		}
	}

	function clearWordHighlights() {
		document
			.querySelectorAll(
				".pali-word-highlighted, .tooltip-text-highlighted",
			)
			.forEach((word) => {
				word.classList.remove(
					"pali-word-highlighted",
					"tooltip-text-highlighted",
				);
			});
	}

	async function showCurrentWordDefinition() {
		if (currentWordIndex >= 0 && currentWordIndex < currentWords.length) {
			const word = currentWords[currentWordIndex];

			// Check if it's a Pali word or English tooltip
			if (word.classList.contains("pali-word")) {
				const cleanWord = cleanPaliWordForLookup(
					word.textContent || "",
				);
				// Prev/Next (mouse or keyboard) keep DPD/PED choice when the next word has PED
				await showDictionaryPopover(cleanWord, true, {
					preservePanel: true,
				});
			} else if (word.classList.contains("tooltip-text")) {
				const content = word.getAttribute("data-tooltip-content") || "";
				const primaryText = word.textContent || "";
				bottomPopover.show(content, "markdown", primaryText);
				addNavigationControls(); // Add navigation controls for English tooltips
			}
		}
	}

	function addNavigationControls() {
		if (!isNavigationMode) return;

		const navigationHtml = `
			<div class="navigation-controls">
				<button class="nav-btn nav-prev" ${currentWordIndex <= 0 ? "disabled" : ""}>
					<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
						<path d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
					</svg>
					Previous
				</button>
				<button class="nav-btn nav-next" ${currentWordIndex >= currentWords.length - 1 ? "disabled" : ""}>
					Next
					<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
						<path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
					</svg>
				</button>
			</div>
		`;

		bottomPopover.addNavigationControls(navigationHtml);
		setupNavigationEventListeners();
		// Ensure button states are correctly set after DOM update
		updateNavigationButtons();
	}

	function setupNavigationEventListeners() {
		const popover = bottomPopover.getPopoverElement();
		const prevBtn = popover?.querySelector(".nav-prev");
		const nextBtn = popover?.querySelector(".nav-next");

		prevBtn?.addEventListener("click", navigateToPreviousWord);
		nextBtn?.addEventListener("click", navigateToNextWord);
	}

	/** Nested sandhi drill-down history (Back restores the previous word). */
	const dictionaryLookupStack: string[] = [];
	let currentDictionaryWord = "";
	/** Remember DPD vs PED across nested lookups and async PED upgrades. */
	let preferredDictPanel: "dpd" | "ped" = "dpd";
	/** Which PED headword body is active when multiple entries exist. */
	let preferredPedPartIndex = 0;
	/** Bumped on every dictionary open so late PED responses cannot clobber newer lookups. */
	let dictionaryLookupGeneration = 0;

	type DictView = {
		word: string;
		headerHtml: string;
		dpdBodyHtml: string;
		/** Lexical sandhi parts only (no root √ analyses / single-letter suffixes). */
		constructionParts: string[];
		lemmas: string[];
		construction?: string;
		pos?: string;
	};

	const DPD_ATTRIBUTION_HTML = `<div class="dict-attribution">Digital Pāḷi Dictionary · CC BY-NC-SA 4.0</div>`;

	/** Short / morphological bits from DPD constructions that must not drive PED. */
	const PED_PART_BLOCKLIST = new Set([
		"a",
		"ā",
		"i",
		"ī",
		"u",
		"ū",
		"e",
		"o",
		"ti",
		"si",
		"mi",
		"anti",
		"enti",
		"ati",
		"ave",
		"esi",
		"etha",
		"antu",
		"ahi",
		"oma",
		"omi",
	]);

	function extractLemmaCandidates(word: string, data: any): string[] {
		const lemmas: string[] = [];
		const seen = new Set<string>();
		const add = (raw: string | undefined) => {
			if (!raw) return;
			const base = raw.replace(/ \d+(\.\d+)*$/, "").trim();
			const key = base.toLowerCase();
			if (!base || seen.has(key)) return;
			seen.add(key);
			lemmas.push(base);
		};
		for (const def of data.definitions || []) {
			add(def.lemma);
		}
		add(word);
		return lemmas;
	}

	/** Prefer lexical sandhi lines (e.g. bhikkhu+ave) over root analyses (√bhikkh+u+ave). */
	function pickLexicalConstruction(raw: string | undefined): string | undefined {
		if (!raw || typeof raw !== "string") return undefined;
		const lines = raw
			.split(/\n/)
			.map((l) => l.trim())
			.filter(Boolean);
		const lexical = lines.find((l) => !l.includes("√") && l.includes("+"));
		if (lexical) return lexical;
		const anyPlus = lines.find((l) => l.includes("+"));
		return anyPlus || lines[0];
	}

	function isUsefulPedPart(part: string): boolean {
		const p = part.replace(/^√/u, "").trim();
		if (p.length < 3) return false;
		if (PED_PART_BLOCKLIST.has(p.toLowerCase())) return false;
		if (/[;,]/.test(p)) return false;
		return true;
	}

	function extractConstructionParts(data: any): string[] {
		const line = pickLexicalConstruction(
			data?.definitions?.[0]?.construction,
		);
		if (!line || !line.includes("+")) return [];
		return line
			.split(/\s*\+\s*/)
			.map((p: string) => p.replace(/^√/u, "").trim())
			.filter(isUsefulPedPart);
	}

	type PedPanelHtml = {
		/**
		 * Fallback chips only when the sticky construction row cannot cover
		 * all PED headwords. Prefer reusing āhāra + nirodha as switchers.
		 */
		chipsHtml: string;
		bodyHtml: string;
		/** Construction parts drive PED switching (no extra chip row). */
		usesConstructionSwitcher: boolean;
	};

	async function mapConstructionPartsToPedIndices(
		parts: string[],
		entries: Array<{ word: string; html: string }>,
		pedHeadword: typeof import("../utils/pedLookup").lookupPedHeadword,
	): Promise<Map<string, number>> {
		const map = new Map<string, number>();
		for (const part of parts) {
			const hit = await pedHeadword(part);
			if (!hit) continue;
			const idx = entries.findIndex((e) => e.word === hit.word);
			if (idx >= 0) map.set(part, idx);
		}
		return map;
	}

	function createPedPanelHtml(
		entries: Array<{ word: string; html: string }>,
		linkify: (html: string) => string,
		opts: { useConstructionSwitcher: boolean; activeIndex: number },
	): PedPanelHtml {
		const multi = entries.length >= 2;
		const activeIndex = Math.min(
			Math.max(0, opts.activeIndex),
			Math.max(0, entries.length - 1),
		);
		// Fallback chips only when construction cannot act as the switcher
		const chipsHtml =
			multi && !opts.useConstructionSwitcher
				? `<div class="ped-part-chips" role="tablist" aria-label="PED headwords">
					${entries
						.map(
							(entry, i) => `
						<button type="button"
							class="ped-part-chip${i === activeIndex ? " active" : ""}"
							role="tab"
							aria-selected="${i === activeIndex ? "true" : "false"}"
							data-ped-part="${i}"
							title="${escapeHtml(entry.word)}"
						>${escapeHtml(entry.word)}</button>`,
						)
						.join("")}
				</div>`
				: "";

		const blocks = entries
			.map(
				(entry, i) => `
			<div class="ped-entry-block${i === activeIndex ? "" : " hidden"}" data-ped-part-body="${i}">
				${
					multi && opts.useConstructionSwitcher
						? ""
						: `<div class="ped-entry-headword">${escapeHtml(entry.word)}</div>`
				}
				<div class="ped-entry">${linkify(entry.html)}</div>
			</div>
		`,
			)
			.join("");

		return {
			chipsHtml,
			usesConstructionSwitcher: opts.useConstructionSwitcher,
			bodyHtml: `
			<div class="ped-content">
				${blocks}
				<div class="dict-attribution">Pali-English Dictionary (Rhys Davids &amp; Stede), PTS · CC BY-NC 3.0</div>
			</div>
		`,
		};
	}

	function applyPedPartPreference(
		root: Element | null | undefined,
		partIndex: string,
	) {
		if (!root) return;
		root.querySelectorAll("[data-ped-part]").forEach((chip) => {
			const on = chip.getAttribute("data-ped-part") === partIndex;
			chip.classList.toggle("active", on);
			chip.setAttribute("aria-selected", on ? "true" : "false");
		});
		root.querySelectorAll("[data-ped-part-body]").forEach((body) => {
			body.classList.toggle(
				"hidden",
				body.getAttribute("data-ped-part-body") !== partIndex,
			);
		});
		root.querySelector(".dict-scroll")?.scrollTo?.({ top: 0 });
	}

	function applyDictPanelPreference(
		root: Element | null | undefined,
		panel: "dpd" | "ped",
		hasPed: boolean,
	) {
		if (!root) return;
		const active = hasPed && panel === "ped" ? "ped" : "dpd";
		root.setAttribute("data-dict-active", active);
		root.querySelectorAll("[data-dict-panel]").forEach((t) => {
			const on = t.getAttribute("data-dict-panel") === active;
			t.classList.toggle("active", on);
			t.setAttribute("aria-selected", on ? "true" : "false");
		});
		root.querySelectorAll("[data-dict-panel-body]").forEach((body) =>
			body.classList.toggle(
				"hidden",
				body.getAttribute("data-dict-panel-body") !== active,
			),
		);
		const chipsRow = root.querySelector(".dict-chrome-parts");
		if (chipsRow) {
			chipsRow.classList.toggle("hidden", active !== "ped");
		}
		if (active === "ped") {
			const bodies = [
				...root.querySelectorAll("[data-ped-part-body]"),
			];
			const max = Math.max(0, bodies.length - 1);
			const idx = String(
				Math.min(Math.max(0, preferredPedPartIndex), max),
			);
			applyPedPartPreference(root, idx);
		} else {
			// DPD: construction parts are nested-lookup links, not PED chips
			root.querySelectorAll(
				".construction [data-ped-part]",
			).forEach((el) => {
				el.classList.remove("active");
				el.setAttribute("aria-selected", "false");
			});
		}
	}

	function wrapDictShell(
		headerHtml: string,
		dpdBodyHtml: string,
		pedPanel: PedPanelHtml | null,
	): string {
		const showBack = dictionaryLookupStack.length > 0;
		const hasPed = !!pedPanel;
		const activePanel =
			hasPed && preferredDictPanel === "ped" ? "ped" : "dpd";
		const pedTab = hasPed
			? `<button type="button" class="dict-panel-tab${activePanel === "ped" ? " active" : ""}" role="tab" aria-selected="${activePanel === "ped" ? "true" : "false"}" data-dict-panel="ped">PED</button>`
			: "";
		const pedBody = hasPed
			? `<div class="dict-panel-body${activePanel === "ped" ? "" : " hidden"}" data-dict-panel-body="ped" role="tabpanel">${pedPanel!.bodyHtml}</div>`
			: "";
		const chipsRow =
			hasPed && pedPanel!.chipsHtml
				? `<div class="dict-chrome-parts${activePanel === "ped" ? "" : " hidden"}">${pedPanel!.chipsHtml}</div>`
				: "";
		const backBtn = showBack
			? `<button type="button" class="dict-back-btn" data-dict-back aria-label="Back to previous word" title="Back to previous word">
					<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M9.78 3.22a.75.75 0 0 1 0 1.06L6.06 8l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0z"/>
					</svg>
				</button>`
			: "";
		return `
			<div class="dict-shell" data-dict-active="${activePanel}">
				<div class="dict-chrome">
					<div class="dict-chrome-top">
						<div class="dict-panel-tabs" role="tablist" aria-label="Dictionary">
							<button type="button" class="dict-panel-tab${activePanel === "dpd" ? " active" : ""}" role="tab" aria-selected="${activePanel === "dpd" ? "true" : "false"}" data-dict-panel="dpd">DPD</button>
							${pedTab}
						</div>
						<div class="dict-chrome-main">
							${backBtn}
							${headerHtml}
						</div>
					</div>
					${chipsRow}
				</div>
				<div class="dict-scroll">
					<div class="dict-panel-body${activePanel === "dpd" ? "" : " hidden"}" data-dict-panel-body="dpd" role="tabpanel">${dpdBodyHtml}</div>
					${pedBody}
				</div>
			</div>
		`;
	}

	function goBackDictionaryLookup() {
		const prev = dictionaryLookupStack.pop();
		if (!prev) return;
		// Nested restore — do not push current onto the stack again; keep preferredDictPanel
		showDictionaryPopover(prev, false, { nested: false, restoring: true });
	}

	async function resolvePedEntries(
		view: DictView,
		pedHeadword: typeof import("../utils/pedLookup").lookupPedHeadword,
	): Promise<Array<{ word: string; html: string }>> {
		const pedEntries: Array<{ word: string; html: string }> = [];
		const seen = new Set<string>();
		const add = (hit: { word: string; html: string } | null) => {
			if (!hit || seen.has(hit.word)) return;
			// Reject single-letter / blocked PED headwords even if looked up
			if (!isUsefulPedPart(hit.word) && hit.word.length < 3) return;
			if (PED_PART_BLOCKLIST.has(hit.word.toLowerCase())) return;
			seen.add(hit.word);
			pedEntries.push(hit);
		};

		// Compounds: show each lexical part in construction order (atthaṁ + gama → both)
		if (view.constructionParts.length >= 2) {
			for (const part of view.constructionParts) {
				add(await pedHeadword(part));
			}
		}

		// DPD lemmas (covers simplex words and any extra senses)
		for (const lemma of view.lemmas) {
			add(await pedHeadword(lemma));
		}

		// Fallback: single useful construction part when lemmas missed
		if (pedEntries.length === 0) {
			for (const part of view.constructionParts) {
				add(await pedHeadword(part));
			}
		}

		return pedEntries;
	}

	async function showDictionaryPopover(
		word: string,
		enableNavigation: boolean = false,
		opts: {
			nested?: boolean;
			restoring?: boolean;
			/** Keep DPD/PED choice (Prev/Next). Falls back to DPD if PED is missing. */
			preservePanel?: boolean;
		} = {},
	) {
		if (!bottomPopover) return;
		const lookupGeneration = ++dictionaryLookupGeneration;

		if (opts.nested && currentDictionaryWord) {
			dictionaryLookupStack.push(currentDictionaryWord);
		} else if (enableNavigation && !opts.restoring) {
			// Clear sandhi drill-down; reset panel only for a fresh page click
			dictionaryLookupStack.length = 0;
			if (!opts.preservePanel) {
				preferredDictPanel = "dpd";
				preferredPedPartIndex = 0;
			}
		}
		currentDictionaryWord = word;

		bottomPopover.show(
			`
			<div class="loading-spinner">
				<svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
				<span class="ml-2">Loading definition...</span>
			</div>
		`,
			"dictionary",
		);

		try {
			const lookup = await loadPaliLookup();
			const data = await lookup(word);

			if (data && data.definitions && data.definitions.length > 0) {
				const view = buildDictView(word, data);
				bottomPopover.show(
					wrapDictShell(view.headerHtml, view.dpdBodyHtml, null),
					"dictionary",
				);
				if (enableNavigation) addNavigationControls();

				void (async () => {
					try {
						const {
							lookupPedHeadword: pedHeadword,
							linkifyPedHtml: linkify,
						} = await loadPedLookup();

						const pedEntries = await resolvePedEntries(
							view,
							pedHeadword,
						);

						if (
							pedEntries.length === 0 ||
							!bottomPopover.isOpen() ||
							lookupGeneration !== dictionaryLookupGeneration
						) {
							return;
						}

						const pedPartMap = await mapConstructionPartsToPedIndices(
							view.constructionParts,
							pedEntries,
							pedHeadword,
						);
						const mappedIndices = new Set(pedPartMap.values());
						// Reuse sticky āhāra + nirodha when it covers every PED entry
						const useConstructionSwitcher =
							pedEntries.length >= 2 &&
							mappedIndices.size >= 2 &&
							mappedIndices.size === pedEntries.length;

						const headerHtml = buildSharedHeaderHtml(
							view.word,
							view.construction,
							view.pos,
							useConstructionSwitcher ? pedPartMap : undefined,
						);
						const pedPanel = createPedPanelHtml(pedEntries, linkify, {
							useConstructionSwitcher,
							activeIndex: preferredPedPartIndex,
						});

						bottomPopover.show(
							wrapDictShell(
								headerHtml,
								view.dpdBodyHtml,
								pedPanel,
							),
							"dictionary",
						);
						applyDictPanelPreference(
							bottomPopover
								.getPopoverElement()
								?.querySelector(".dict-shell"),
							preferredDictPanel,
							true,
						);
						if (enableNavigation) addNavigationControls();
					} catch (pedError) {
						console.warn("PED lookup skipped:", pedError);
					}
				})();
			} else {
				bottomPopover.show(
					`<div><span style="font-family: 'Gentium Plus', serif;">${escapeHtml(word)}</span>: No definition found</div>`,
					"dictionary",
				);
			}
		} catch (error) {
			console.error("Failed to load definition:", error);
			bottomPopover.show("Failed to load definition", "dictionary");
		}
	}

	function buildDictView(word: string, data: any): DictView {
		const { definitions } = data;
		const isCompound = definitions.some(
			(def: any) =>
				def.meaning && /^[^\s]+\s+\d+\.\s/.test(def.meaning),
		);
		if (isCompound) {
			return buildCompoundDictView(word, data);
		}
		return buildUnifiedDictView(word, data);
	}

	function buildSharedHeaderHtml(
		word: string,
		construction: string | undefined,
		pos: string | undefined,
		pedPartMap?: Map<string, number>,
	): string {
		const displayConstruction = pickLexicalConstruction(construction);
		return `
			<div class="title dict-shared-title">
				<span class="dict-headword">${escapeHtml(word)}</span>
				${
					displayConstruction
						? `<span>${formatConstructionLinks(displayConstruction, word, pedPartMap)}</span>`
						: ""
				}
				${pos ? `<span><span class="grammar">${escapeHtml(pos)}</span></span>` : ""}
			</div>
		`;
	}

	function buildUnifiedDictView(word: string, data: any): DictView {
		const { definitions } = data;

		const groupMap = new Map<string, any[]>();
		definitions.forEach((def: any) => {
			const baseLemma = def.lemma
				? def.lemma.replace(/ \d+(\.\d+)*$/, "")
				: word;
			if (!groupMap.has(baseLemma)) groupMap.set(baseLemma, []);
			groupMap.get(baseLemma)!.push(def);
		});

		const normalize = (s: string) => s.toLowerCase().normalize("NFC");
		const stripDiacritics = (s: string) =>
			s
				.normalize("NFD")
				.replace(/[\u0300-\u036f]/g, "")
				.toLowerCase();
		const commonPrefixLen = (a: string, b: string) => {
			let i = 0;
			while (i < a.length && i < b.length && a[i] === b[i]) i++;
			return i;
		};
		const normWord = normalize(word);
		const strippedWord = stripDiacritics(word);

		const sortedGroups = Array.from(groupMap.entries()).sort(([a], [b]) => {
			const strippedA = commonPrefixLen(stripDiacritics(a), strippedWord);
			const strippedB = commonPrefixLen(stripDiacritics(b), strippedWord);
			if (strippedB !== strippedA) return strippedB - strippedA;
			return (
				commonPrefixLen(normalize(b), normWord) -
				commonPrefixLen(normalize(a), normWord)
			);
		});

		const primary: [string, any[]][] = [];
		const secondary: [string, any[]][] = [];
		for (const [lemma, defs] of sortedGroups) {
			const prefixLen = commonPrefixLen(
				stripDiacritics(lemma),
				strippedWord,
			);
			const matchRatio =
				strippedWord.length > 0 ? prefixLen / strippedWord.length : 1;
			if (matchRatio >= 0.6 || primary.length === 0) {
				primary.push([lemma, defs]);
			} else {
				secondary.push([lemma, defs]);
			}
		}

		const isSingleGroup = primary.length === 1 && secondary.length === 0;
		const topDef = (primary[0] ?? secondary[0])[1][0];
		const showPos = !isSingleGroup;

		const renderGroup = (
			[lemma, defs]: [string, any[]],
			showGroupPos: boolean,
		) => `
			<div class="constituent-group">
				<div class="constituent-header">
					${escapeHtml(lemma)}${defs[0].pos && showGroupPos ? `<span class="constituent-pos"> ${escapeHtml(defs[0].pos)}</span>` : ""}:
				</div>
				<div class="constituent-meanings">
					${defs
						.map(
							(def: any, idx: number) => `
						<div class="meaning-item">${idx + 1}. ${def.meaning}${def.meaning_lit ? `; <em>lit. ${def.meaning_lit}</em>` : ""}</div>
					`,
						)
						.join("")}
				</div>
			</div>
		`;

		const construction =
			isSingleGroup && topDef.construction
				? topDef.construction
				: undefined;
		const pos =
			isSingleGroup && topDef.pos ? topDef.pos : undefined;

		return {
			word,
			headerHtml: buildSharedHeaderHtml(word, construction, pos),
			dpdBodyHtml: `
				<div class="dpd-content lemma-groups">
					${primary.map((g) => renderGroup(g, showPos)).join("")}
					${
						secondary.length > 0
							? `
					<details class="also-matched">
						<summary>Also matched</summary>
						${secondary.map((g) => renderGroup(g, true)).join("")}
					</details>
					`
							: ""
					}
					${DPD_ATTRIBUTION_HTML}
				</div>
			`,
			constructionParts: extractConstructionParts(data),
			lemmas: extractLemmaCandidates(word, data),
			construction,
			pos,
		};
	}

	/** True when a construction part is essentially the looked-up word (no nested lookup). */
	function isNearLookupWord(part: string, word: string): boolean {
		const strip = (s: string) =>
			s
				.normalize("NFD")
				.replace(/[\u0300-\u036f]/g, "")
				.toLowerCase();
		const a = strip(part);
		const b = strip(word);
		if (!a || !b) return true;
		if (a === b) return true;
		const n = Math.min(a.length, b.length);
		let i = 0;
		while (i < n && a[i] === b[i]) i++;
		return i / Math.max(a.length, b.length) >= 0.85;
	}

	/**
	 * Top-row sandhi only: split "buddha+sāsana" / "imaṃ + atthaṁ" into tappable
	 * parts. On PED, parts with data-ped-part switch headwords in-place; on DPD
	 * they nested-lookup. Lemma/constituent headers in the body stay plain text.
	 */
	function formatConstructionLinks(
		construction: string,
		lookupWord: string,
		pedPartMap?: Map<string, number>,
	): string {
		const flat = construction.replace(/\n/g, " ; ").trim();
		if (!flat.includes("+")) {
			return `<span class="construction">${escapeHtml(flat)}</span>`;
		}
		const parts = flat
			.split(/\s*\+\s*/)
			.map((p) => p.trim())
			.filter(Boolean);
		if (parts.length < 2) {
			return `<span class="construction">${escapeHtml(flat)}</span>`;
		}
		const usePedSwitcher = !!pedPartMap && pedPartMap.size >= 2;
		const linked = parts
			.map((part) => {
				const clean = part.replace(/^√/u, "").trim();
				if (
					!isUsefulPedPart(clean) ||
					isNearLookupWord(clean, lookupWord)
				) {
					return `<span class="construction-part">${escapeHtml(clean || part)}</span>`;
				}
				const pedIdx = pedPartMap?.get(clean);
				const pedAttrs =
					usePedSwitcher && pedIdx != null
						? ` data-ped-part="${pedIdx}" aria-selected="false"`
						: "";
				const pedClass =
					usePedSwitcher && pedIdx != null
						? " construction-part--ped"
						: "";
				// No title on PED switcher chips — the label is enough; a dual-mode
				// tooltip ("PED switch / DPD look up") was more confusing than helpful.
				const titleAttr =
					usePedSwitcher && pedIdx != null
						? ""
						: ` title="Look up ${escapeHtml(clean)}"`;
				return `<button type="button" class="construction-part lookup-word-btn${pedClass}" data-lookup-word="${escapeHtml(clean)}"${pedAttrs}${titleAttr}>${escapeHtml(clean)}</button>`;
			})
			.join('<span class="construction-sep"> + </span>');
		return `<span class="construction${usePedSwitcher ? " construction--ped-switcher" : ""}">${linked}</span>`;
	}

	function buildCompoundDictView(word: string, data: any): DictView {
		const { definitions } = data;
		const constituents = new Map();

		definitions.forEach((def: any) => {
			if (def.meaning) {
				const match = def.meaning.match(/^([^\s]+)\s+(\d+)\.\s(.+)$/);
				if (match) {
					const [, constituent, num, meaning] = match;
					if (!constituents.has(constituent)) {
						constituents.set(constituent, []);
					}
					constituents.get(constituent).push(`${num}. ${meaning}`);
				}
			}
		});

		const construction = definitions[0]?.construction;
		const pos = definitions[0]?.pos;

		return {
			word,
			headerHtml: buildSharedHeaderHtml(word, construction, pos),
			dpdBodyHtml: `
				<div class="dpd-content compound-content">
					${Array.from(constituents.entries())
						.map(
							([constituent, meanings]) => `
						<div class="constituent-group">
							<div class="constituent-header">${escapeHtml(constituent)}:</div>
							<div class="constituent-meanings">
								${meanings
									.map(
										(meaning: string) => `
									<div class="meaning-item">${meaning}</div>
								`,
									)
									.join("")}
							</div>
						</div>
					`,
						)
						.join("")}
					${DPD_ATTRIBUTION_HTML}
				</div>
			`,
			constructionParts: extractConstructionParts(data),
			lemmas: extractLemmaCandidates(word, data),
			construction,
			pos,
		};
	}

	document.addEventListener("DOMContentLoaded", () => {
		replaceTooltips(document.body);
		bottomPopover = new BottomPopover();

		// Handle |text::tooltip| clicks
		document.addEventListener("click", (e) => {
			const tooltipElement = (e.target as HTMLElement).closest(
				".tooltip-text",
			);
			if (tooltipElement) {
				e.preventDefault();
				const content =
					tooltipElement.getAttribute("data-tooltip-content") || "";
				const primaryText = tooltipElement.textContent || "";
				// Enable navigation for English tooltips
				enableTooltipNavigation(tooltipElement as HTMLElement);
				bottomPopover.show(content, "markdown", primaryText);
				// Add navigation controls for English tooltips
				addNavigationControls();
				return;
			}

			// Handle Pali word clicks
			const paliWord = (e.target as HTMLElement).closest(".pali-word");
			if (paliWord && localStorage.getItem("paliLookup") === "true") {
				e.preventDefault();
				const word = cleanPaliWordForLookup(
					paliWord.textContent || "",
				);
				enableWordNavigation(paliWord as HTMLElement);
				// Pali dictionary content gets navigation - pass true for enableNavigation
				showDictionaryPopover(word, true);
				return;
			}
		});

		// Handle Pali word lookup if enabled
		if (localStorage.getItem("paliLookup") === "true") {
			// Desktop: double-click handler
			if (!("ontouchstart" in window)) {
				document.addEventListener("dblclick", (e) => {
					const target = e.target as HTMLElement;
					if (!target.closest(".pali-paragraph")) return;

					const selection = window.getSelection();
					const text = selection?.toString().trim();
					if (!text || /\s/.test(text)) return;

					showDictionaryPopover(cleanPaliWordForLookup(text));
				});
			}

			// Mobile: touch handler
			if ("ontouchstart" in window) {
				let startTouch: Touch | null = null;

				document.addEventListener("contextmenu", (e) => {
					const target = e.target as HTMLElement;
					if (target.closest(".pali-paragraph")) {
						e.preventDefault();
					}
				});

				document.addEventListener(
					"touchstart",
					(e) => {
						const target = e.target as HTMLElement;
						if (!target.closest(".pali-paragraph")) return;
						startTouch = e.touches[0];
					},
					{ passive: true },
				);

				document.addEventListener(
					"touchend",
					(e) => {
						if (!startTouch) return;

						const selection = window.getSelection();
						const text = selection?.toString().trim();

						if (text && !text.includes(" ")) {
							showDictionaryPopover(
								cleanPaliWordForLookup(text),
							);
						}
						startTouch = null;
					},
					{ passive: true },
				);
			}
		}

		// Override popover hide to disable navigation mode
		const originalHide = bottomPopover.hide.bind(bottomPopover);
		bottomPopover.hide = function () {
			disableWordNavigation();
			originalHide();
		};

		// Keyboard navigation
		document.addEventListener(
			"keydown",
			(e) => {
				// Handle escape key for any open drawer
				if (e.key === "Escape" && bottomPopover?.isOpen()) {
					e.preventDefault();
					e.stopPropagation();
					e.stopImmediatePropagation();
					if (isNavigationMode) {
						disableWordNavigation();
					}
					bottomPopover.hide();
					return;
				}

				// Only handle other keyboard shortcuts when navigation mode is active and drawer is open
				if (!isNavigationMode || !bottomPopover?.isOpen()) return;

				// Check if this is a navigation key we want to handle
				const isNavigationKey = [
					"ArrowLeft",
					"ArrowRight",
					"ArrowUp",
					"ArrowDown",
				].includes(e.key);

				if (isNavigationKey) {
					// Stop all event propagation to prevent browser extension interference
					e.preventDefault();
					e.stopPropagation();
					e.stopImmediatePropagation();

					switch (e.key) {
						case "ArrowLeft":
							navigateToPreviousWord();
							break;

						case "ArrowRight":
							navigateToNextWord();
							break;

						case "ArrowUp":
							// For Pali words, use vertical navigation; for English tooltips, use sequential
							if (
								currentWords.length > 0 &&
								currentWords[
									currentWordIndex
								]?.classList.contains("pali-word")
							) {
								navigateVertically("up");
							} else {
								navigateToPreviousWord();
							}
							break;

						case "ArrowDown":
							// For Pali words, use vertical navigation; for English tooltips, use sequential
							if (
								currentWords.length > 0 &&
								currentWords[
									currentWordIndex
								]?.classList.contains("pali-word")
							) {
								navigateVertically("down");
							} else {
								navigateToNextWord();
							}
							break;
					}
				}
			},
			true,
		); // Use capture phase to handle before other listeners
	});
</script>
