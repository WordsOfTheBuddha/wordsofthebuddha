---
/**
 * Collection / topic export preview (modal). Opened via [data-open-collection-pdf-modal].
 * One instance per collection or /on page. Format (PDF or EPUB) is chosen here.
 */
import type { CollectionPdfPreviewChapter } from "../utils/collectionPdfPreviewMeta";
import type { PdfExportSelectionTree } from "../utils/collectionPdfExportTree";
import { transformId } from "../utils/transformId";
import "../styles/collection-pdf-export.css";

/** True when two labels are the same ignoring case / hyphen vs space. */
function labelsEquivalent(a: string, b: string): boolean {
	const norm = (s: string) =>
		s
			.toLowerCase()
			.replace(/[-_]+/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	return norm(a) === norm(b);
}

interface Props {
	collectionSlug: string;
	/** Override export API path (default `/api/export/{collectionSlug}`). */
	exportApiPath?: string;
	previewTitle: string;
	previewScopeSummary: string;
	/** MDX source files in export scope (for “large export” note). */
	previewTotalTextFiles: number;
	previewHasChapters: boolean;
	previewChapters: CollectionPdfPreviewChapter[];
	/** At least one discourse in this export has an SVG diagram. */
	previewHasSvgViz: boolean;
	/** When set, modal shows a checkbox tree and uses POST JSON for subset export. */
	exportSelectionTree?: PdfExportSelectionTree | null;
}

const {
	collectionSlug,
	exportApiPath,
	previewTitle,
	previewScopeSummary,
	previewTotalTextFiles,
	previewHasChapters,
	previewChapters,
	previewHasSvgViz,
	exportSelectionTree = null,
} = Astro.props;

const showLargeExportNote = previewTotalTextFiles > 100;

const hasExportTree =
	!!exportSelectionTree &&
	exportSelectionTree.chapters.length > 0 &&
	exportSelectionTree.chapters.some((ch) => ch.discourses.length > 0);

const exportTreeDiscourseTotal = hasExportTree
	? exportSelectionTree!.totalDiscourseCount
	: 0;

const exportTreeReferenceCount = hasExportTree
	? exportSelectionTree!.referenceDiscourseCount
	: 0;

const exportTreeReferencePercent = hasExportTree
	? exportSelectionTree!.referencePercent
	: 0;

const hasReferenceDiscourses = exportTreeReferenceCount > 0;

const exportTreeCuratedCount = exportTreeDiscourseTotal - exportTreeReferenceCount;
---

<dialog
	id="collection-pdf-export-dialog"
	class="collection-pdf-dialog"
	aria-labelledby="collection-pdf-export-title"
>
	<div class="collection-pdf-dialog-inner">
		<header class="collection-pdf-dialog-header">
			<h2 id="collection-pdf-export-title" class="collection-pdf-dialog-title">
				<span class="collection-pdf-dialog-action">Download</span>
				<span class="collection-pdf-dialog-subject">{previewTitle}</span>
			</h2>
			<button
				type="button"
				class="collection-pdf-dialog-close"
				aria-label="Close"
				data-collection-pdf-close
			>
				&times;
			</button>
		</header>

		<div class="collection-pdf-dialog-body">
			<div class="collection-pdf-main">
			{
				hasExportTree ? (
					<section
						id="collection-pdf-contents"
						class="collection-pdf-contents-select"
						aria-label="Choose discourses"
					>
						<div class="collection-pdf-contents-head">
							<h3 class="collection-pdf-section-label">Discourses to include</h3>
							<div class="collection-pdf-contents-toolbar">
								<span
									class="collection-pdf-selection-count"
									id="pdf-selection-count"
									data-curated-total={exportTreeCuratedCount}
									data-reference-total={exportTreeReferenceCount}
									data-full-total={exportTreeDiscourseTotal}
								>
									{exportTreeCuratedCount} of {exportTreeCuratedCount} selected
								</span>
								<button
									type="button"
									class="collection-pdf-btn-tertiary"
									id="pdf-select-all"
								>
									Select all
								</button>
								<button
									type="button"
									class="collection-pdf-btn-tertiary"
									id="pdf-clear-all"
								>
									Clear all
								</button>
							</div>
						</div>
						<div
							class="collection-pdf-tree-scroll"
							id="collection-pdf-tree-scroll"
							tabindex="0"
						>
							{exportSelectionTree!.chapters.map((ch) => (
								<div class="pdf-tree-chapter" data-chapter-id={ch.id}>
									<div class="pdf-tree-chapter-row">
										<label class="pdf-tree-chapter-label">
											<input type="checkbox" class="pdf-chapter-cb" checked />
											<span class="pdf-tree-chapter-title">
												{(() => {
													const chapterLabel = transformId(ch.id);
													const title = ch.title?.trim() ?? "";
													const titleRedundant =
														!title ||
														labelsEquivalent(title, ch.id) ||
														labelsEquivalent(title, chapterLabel);
													if (titleRedundant) {
														return <span>{title || chapterLabel}</span>;
													}
													return (
														<>
															<span class="pdf-tree-id">{chapterLabel}</span>
															{" "}
															<span>{title}</span>
														</>
													);
												})()}
											</span>
										</label>
									</div>
									<ul class="pdf-tree-discourses">
										{ch.discourses.map((d) => (
											<li
												class:list={[
													d.isReference && "pdf-tree-discourse--reference",
												]}
												data-is-reference={d.isReference ? "true" : undefined}
												hidden={d.isReference ? true : undefined}
											>
												<label
													class:list={[
														"pdf-tree-discourse-label",
														d.isReference &&
															"pdf-tree-discourse-label--reference",
													]}
												>
													<input
														type="checkbox"
														class="pdf-discourse-cb"
														data-slug={d.slug}
														data-is-reference={d.isReference ? "true" : "false"}
														checked={!d.isReference}
														disabled={d.isReference ? true : undefined}
													/>
													<span class="pdf-tree-discourse-title">
														<span class="pdf-tree-id">{transformId(d.slug)}</span>
														{d.title && d.title.trim() !== d.slug ? (
															<>
																{" "}
																<span>{d.title}</span>
															</>
														) : null}
														{d.isReference ? (
															<span class="pdf-tree-ref-badge">Ref.</span>
														) : null}
													</span>
												</label>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
						{showLargeExportNote && (
							<p class="collection-pdf-large-export-note">
								Large exports may take a minute or two.
							</p>
						)}
					</section>
				) : (
					<section class="collection-pdf-scope" aria-label="Export scope">
						<h3 class="collection-pdf-section-label">
							{previewHasChapters && previewChapters.length > 0
								? "Contents"
								: "Scope"}
						</h3>
						<p class="collection-pdf-count">{previewScopeSummary}</p>
						{previewHasChapters && previewChapters.length > 0 && (
							<div class="collection-pdf-toc-wrap">
								<ul class="collection-pdf-chapter-list">
									{previewChapters.map((ch) => (
										<li data-chapter-slug={ch.slug}>
											<span class="collection-pdf-chapter-title">{ch.title}</span>
											<span class="collection-pdf-chapter-count">
												{ch.count} discourse{ch.count === 1 ? "" : "s"}
											</span>
										</li>
									))}
								</ul>
							</div>
						)}
						{showLargeExportNote && (
							<p class="collection-pdf-large-export-note">
								Large exports may take a minute or two.
							</p>
						)}
					</section>
				)
			}

			<p class="collection-pdf-hint">
				These choices apply only to this download. They do not change how you read on the site.
			</p>
			</div>

			<div class="collection-pdf-settings">

			<section
				class="collection-pdf-format-block"
				aria-label="File format"
			>
				<h3 class="collection-pdf-section-label">Format</h3>
				<fieldset class="collection-pdf-format" id="export-format-fieldset">
					<legend class="sr-only">File format</legend>
					<label class="collection-pdf-format-option">
						<input type="radio" name="export-format" value="pdf" checked />
						<span>
							<strong>PDF</strong>
							<span class="collection-pdf-format-desc">Print layout, A4 pages</span>
						</span>
					</label>
					<label class="collection-pdf-format-option">
						<input type="radio" name="export-format" value="epub" />
						<span>
							<strong>EPUB</strong>
							<span class="collection-pdf-format-desc">Reflowable, for e-readers</span>
						</span>
					</label>
				</fieldset>
				<p
					id="export-epub-note"
					class="collection-pdf-epub-note"
					hidden
				>
					EPUB uses interleaved Pāli (when included). Split-column layout and thermal print colors are PDF-only. Diagrams default to an e-ink paper profile.
				</p>
			</section>

			<section
				id="collection-pdf-options"
				class="collection-pdf-options"
				aria-label="Download options"
			>
				<h3 class="collection-pdf-section-label">Options</h3>
				<div class="collection-pdf-option-stack">
					{
						hasReferenceDiscourses && (
							<label class="collection-pdf-field" id="pdf-opt-ref-wrap">
								<input
									type="checkbox"
									id="pdf-opt-ref"
									name="includeRef"
								/>
								<span id="pdf-opt-ref-label">
									Include Ref. Translations ({exportTreeReferenceCount}{" "}
									{exportTreeReferenceCount === 1 ? "discourse" : "discourses"},{" "}
									{exportTreeReferencePercent}%)
								</span>
							</label>
						)
					}

					<div class="collection-pdf-option-group">
						<label class="collection-pdf-field">
							<input type="checkbox" id="pdf-opt-pli" name="pli" />
							<span>Include Pāli text</span>
						</label>
						<fieldset class="collection-pdf-fieldset" id="pdf-fieldset-layout" disabled>
							<legend class="sr-only">Pāli layout</legend>
							<label>
								<input type="radio" name="layout" value="interleaved" checked />
								Interleaved (Pāli then English per paragraph)
							</label>
							<label>
								<input type="radio" name="layout" value="split" />
								Split columns (English left, Pāli right)
							</label>
						</fieldset>
					</div>

					{
						previewHasSvgViz && (
							<div
								class="collection-pdf-option-group collection-pdf-viz-group"
								id="pdf-opt-viz-group"
							>
								<label class="collection-pdf-field">
									<input
										type="checkbox"
										id="pdf-opt-viz-show"
										name="vizShow"
									/>
									<span>Include discourse images</span>
								</label>
								<fieldset
									class="collection-pdf-fieldset"
									id="pdf-fieldset-viz-colors"
									disabled
								>
									<legend class="sr-only">Diagram colors</legend>
									<label data-viz-mode-option="light">
										<input
											type="radio"
											name="viz-mode"
											value="light"
											checked
										/>
										Light
									</label>
									<label data-viz-mode-option="eink" hidden>
										<input type="radio" name="viz-mode" value="eink" />
										E-ink
									</label>
									<label>
										<input type="radio" name="viz-mode" value="dark" />
										Dark
									</label>
									<label data-viz-mode-option="thermal">
										<input type="radio" name="viz-mode" value="thermal" />
										Thermal
									</label>
								</fieldset>
							</div>
						)
					}

					<label class="collection-pdf-field">
						<input type="checkbox" id="pdf-opt-keyterms" name="keyterms" checked />
						<span>Include Key Terms glossary at the end of each discourse</span>
					</label>
				</div>
			</section>
			</div>
		</div>

		<footer class="collection-pdf-dialog-footer">
			<button type="button" class="collection-pdf-btn-secondary" data-collection-pdf-close>
				Cancel
			</button>
			<button
				type="button"
				class="collection-pdf-btn-primary"
				id="collection-pdf-generate"
				data-collection-slug={collectionSlug}
				data-export-api-path={exportApiPath}
				data-label-pdf="Print PDF"
				data-label-epub="Download EPUB"
			>
				Print PDF
			</button>
		</footer>
	</div>
</dialog>

<div class="collection-pdf-toast export-toast" role="alert" aria-live="assertive">
	<span class="toast-msg"></span>
	<button type="button" class="toast-close" aria-label="Dismiss">&times;</button>
</div>



<script>
	import { resolveRefMode } from "../utils/refModeClient";

	let toastTimer: ReturnType<typeof setTimeout>;
	let keydownHandlerWired = false;

	function refsIncluded(dlg: HTMLDialogElement): boolean {
		const refOpt = dlg.querySelector(
			"#pdf-opt-ref",
		) as HTMLInputElement | null;
		return !refOpt || refOpt.checked;
	}

	function getActiveDiscourseCheckboxes(
		dlg: HTMLDialogElement,
	): HTMLInputElement[] {
		const includeRefs = refsIncluded(dlg);
		return Array.from(
			dlg.querySelectorAll<HTMLInputElement>(".pdf-discourse-cb"),
		).filter((cb) => includeRefs || cb.dataset.isReference !== "true");
	}

	function setReferenceDiscoursesVisible(
		dlg: HTMLDialogElement,
		visible: boolean,
	) {
		dlg
			.querySelectorAll<HTMLElement>("li[data-is-reference='true']")
			.forEach((li) => {
				if (visible) li.removeAttribute("hidden");
				else li.setAttribute("hidden", "");
			});
		dlg
			.querySelectorAll<HTMLInputElement>(
				".pdf-discourse-cb[data-is-reference='true']",
			)
			.forEach((cb) => {
				cb.disabled = !visible;
				if (!visible) cb.checked = false;
			});
		dlg.querySelectorAll(".pdf-tree-chapter").forEach((ch) => {
			syncChapterFromChildren(ch);
		});
		updateExportTreeSelectionUi(dlg);
	}

	function getCollectionPdfDialogs(): HTMLDialogElement[] {
		return Array.from(
			document.querySelectorAll<HTMLDialogElement>(
				"#collection-pdf-export-dialog",
			),
		);
	}

	function getTargetCollectionPdfDialog(): HTMLDialogElement | null {
		const all = getCollectionPdfDialogs();
		for (let i = all.length - 1; i >= 0; i--) {
			if (all[i].open) return all[i];
		}
		return all.length ? all[all.length - 1] : null;
	}

	function dedupeCollectionPdfDialogs(): HTMLDialogElement | null {
		let all = getCollectionPdfDialogs();
		while (all.length > 1) {
			all[0].remove();
			all = getCollectionPdfDialogs();
		}
		return all[0] ?? null;
	}

	function closeCollectionPdfDialogs(): void {
		const before = getCollectionPdfDialogs();
		for (const d of before) {
			if (d.open) {
				try {
					d.close();
				} catch (err) {
					console.error("[collection-pdf-modal] close() threw", err);
				}
			}
		}
	}

	function showToast(msg: string) {
		const toast = document.querySelector<HTMLElement>(".collection-pdf-toast");
		const toastMsg = toast?.querySelector<HTMLElement>(".toast-msg");
		if (!toast || !toastMsg) return;
		clearTimeout(toastTimer);
		toastMsg.textContent = msg;
		toast.classList.add("visible");
		toastTimer = setTimeout(() => toast.classList.remove("visible"), 8000);
	}

	function getSelectedFormat(dlg: HTMLDialogElement): "pdf" | "epub" {
		const input = dlg.querySelector<HTMLInputElement>(
			'input[name="export-format"]:checked',
		);
		return input?.value === "epub" ? "epub" : "pdf";
	}

	function generateButtonLabel(
		dlg: HTMLDialogElement,
		format: "pdf" | "epub",
	): string {
		const gen = dlg.querySelector<HTMLButtonElement>(
			"#collection-pdf-generate",
		);
		if (format === "epub") {
			return gen?.dataset.labelEpub || "Download EPUB";
		}
		return gen?.dataset.labelPdf || "Print PDF";
	}

	function applyFormatDependentUi(dlg: HTMLDialogElement) {
		const format = getSelectedFormat(dlg);
		const isEpub = format === "epub";
		const layoutFs = dlg.querySelector<HTMLFieldSetElement>(
			"#pdf-fieldset-layout",
		);
		const vizColors = dlg.querySelector<HTMLFieldSetElement>(
			"#pdf-fieldset-viz-colors",
		);
		const epubNote = dlg.querySelector<HTMLElement>("#export-epub-note");
		const gen = dlg.querySelector<HTMLButtonElement>(
			"#collection-pdf-generate",
		);
		const pliInput = dlg.querySelector<HTMLInputElement>("#pdf-opt-pli");
		const vizShow = dlg.querySelector<HTMLInputElement>("#pdf-opt-viz-show");

		if (layoutFs) {
			layoutFs.hidden = isEpub;
			if (!isEpub) {
				layoutFs.disabled = !pliInput?.checked;
			}
		}
		if (vizColors) {
			vizColors.hidden = false;
			vizColors.disabled = !vizShow?.checked;
			const lightOpt = vizColors.querySelector<HTMLElement>(
				"[data-viz-mode-option='light']",
			);
			const einkOpt = vizColors.querySelector<HTMLElement>(
				"[data-viz-mode-option='eink']",
			);
			const thermalOpt = vizColors.querySelector<HTMLElement>(
				"[data-viz-mode-option='thermal']",
			);
			if (lightOpt) lightOpt.hidden = isEpub;
			if (einkOpt) einkOpt.hidden = !isEpub;
			if (thermalOpt) thermalOpt.hidden = isEpub;
			const lightR = vizColors.querySelector<HTMLInputElement>(
				'input[name="viz-mode"][value="light"]',
			);
			const einkR = vizColors.querySelector<HTMLInputElement>(
				'input[name="viz-mode"][value="eink"]',
			);
			const darkR = vizColors.querySelector<HTMLInputElement>(
				'input[name="viz-mode"][value="dark"]',
			);
			if (isEpub) {
				if (!darkR?.checked && einkR) einkR.checked = true;
			} else if (einkR?.checked && lightR) {
				lightR.checked = true;
			}
		}
		if (epubNote) epubNote.hidden = !isEpub;
		if (gen && gen.textContent !== "Printing…" && gen.textContent !== "Building EPUB…") {
			gen.textContent = generateButtonLabel(dlg, format);
		}
	}

	function applyDefaultsFromPage(dlg: HTMLDialogElement) {
		const pliInput = dlg.querySelector(
			"#pdf-opt-pli",
		) as HTMLInputElement | null;
		const layoutFieldset = dlg.querySelector(
			"#pdf-fieldset-layout",
		) as HTMLFieldSetElement | null;
		const vizShowInput = dlg.querySelector(
			"#pdf-opt-viz-show",
		) as HTMLInputElement | null;
		const vizColorsFieldset = dlg.querySelector(
			"#pdf-fieldset-viz-colors",
		) as HTMLFieldSetElement | null;
		const keyTermsInput = dlg.querySelector(
			"#pdf-opt-keyterms",
		) as HTMLInputElement | null;

		if (!pliInput || !layoutFieldset || !keyTermsInput) {
			resetExportTreeToAll(dlg);
			applyFormatDependentUi(dlg);
			return;
		}

		const hasVizControls = !!(vizShowInput && vizColorsFieldset);

		try {
			const params = new URLSearchParams(window.location.search);
			const showPali =
				document.documentElement.classList.contains("pali-on") ||
				localStorage.getItem("paliMode") === "true" ||
				params.get("pli") === "true";
			pliInput.checked = showPali;
			const split =
				document.documentElement.classList.contains("split") ||
				localStorage.getItem("layout") === "split";
			const interleaved = dlg.querySelector<HTMLInputElement>(
				'input[name="layout"][value="interleaved"]',
			);
			const splitR = dlg.querySelector<HTMLInputElement>(
				'input[name="layout"][value="split"]',
			);
			if (splitR && interleaved) {
				if (split) {
					splitR.checked = true;
				} else {
					interleaved.checked = true;
				}
			}
			layoutFieldset.disabled = !showPali;

			if (hasVizControls) {
				const imgStored = localStorage.getItem("showDiscourseImages");
				const showImg = imgStored === null || imgStored === "true";
				vizShowInput.checked = showImg;
				vizColorsFieldset.disabled = !showImg;

				let v = localStorage.getItem("vizImageMode");
				if (v === "print") v = "thermal";
				const lightR = dlg.querySelector<HTMLInputElement>(
					'input[name="viz-mode"][value="light"]',
				);
				const darkR = dlg.querySelector<HTMLInputElement>(
					'input[name="viz-mode"][value="dark"]',
				);
				const thermalR = dlg.querySelector<HTMLInputElement>(
					'input[name="viz-mode"][value="thermal"]',
				);
				if (v === "light" && lightR) lightR.checked = true;
				else if (v === "dark" && darkR) darkR.checked = true;
				else if (v === "thermal" && thermalR) thermalR.checked = true;
				else if (lightR) lightR.checked = true;
			}

			keyTermsInput.checked = true;

			const refOpt = dlg.querySelector(
				"#pdf-opt-ref",
			) as HTMLInputElement | null;
			if (refOpt) {
				refOpt.checked = resolveRefMode();
				setReferenceDiscoursesVisible(dlg, refOpt.checked);
			}

			const savedFormat = localStorage.getItem("exportFormat");
			const epubR = dlg.querySelector<HTMLInputElement>(
				'input[name="export-format"][value="epub"]',
			);
			const pdfR = dlg.querySelector<HTMLInputElement>(
				'input[name="export-format"][value="pdf"]',
			);
			if (savedFormat === "epub" && epubR) epubR.checked = true;
			else if (pdfR) pdfR.checked = true;
		} catch {
			pliInput.checked = false;
			layoutFieldset.disabled = true;
			if (hasVizControls) {
				vizShowInput!.checked = false;
				vizColorsFieldset!.disabled = true;
			}
		}

		resetExportTreeToAll(dlg);
		applyFormatDependentUi(dlg);
	}

	function updateExportTreeSelectionUi(dlg: HTMLDialogElement) {
		const active = getActiveDiscourseCheckboxes(dlg);
		const total = active.length;
		if (total === 0) return;
		const sel = active.filter((cb) => cb.checked).length;
		const countEl = dlg.querySelector("#pdf-selection-count");
		if (countEl) countEl.textContent = `${sel} of ${total} selected`;
		const gen = dlg.querySelector(
			"#collection-pdf-generate",
		) as HTMLButtonElement | null;
		if (gen) gen.disabled = sel === 0;
	}

	function syncChapterFromChildren(chapterEl: Element) {
		const chapterCb = chapterEl.querySelector(
			".pdf-chapter-cb",
		) as HTMLInputElement | null;
		const discs = Array.from(
			chapterEl.querySelectorAll<HTMLInputElement>(".pdf-discourse-cb"),
		).filter((d) => !d.disabled);
		if (!chapterCb) return;
		let n = 0;
		let c = 0;
		discs.forEach((d) => {
			n++;
			if (d.checked) c++;
		});
		chapterCb.checked = c === n && n > 0;
		chapterCb.indeterminate = c > 0 && c < n;
	}

	function applyChapterToDiscourses(chapterCb: HTMLInputElement) {
		const chapterEl = chapterCb.closest(".pdf-tree-chapter");
		if (!chapterEl) return;
		chapterEl
			.querySelectorAll<HTMLInputElement>(".pdf-discourse-cb")
			.forEach((d) => {
				if (!d.disabled) d.checked = chapterCb.checked;
			});
		chapterCb.indeterminate = false;
	}

	function resetExportTreeToAll(dlg: HTMLDialogElement) {
		const active = getActiveDiscourseCheckboxes(dlg);
		if (active.length === 0) return;
		active.forEach((d) => {
			d.checked = true;
		});
		dlg.querySelectorAll(".pdf-tree-chapter").forEach((ch) => {
			const cb = ch.querySelector(".pdf-chapter-cb") as HTMLInputElement | null;
			if (cb) {
				cb.checked = true;
				cb.indeterminate = false;
			}
		});
		updateExportTreeSelectionUi(dlg);
	}

	function clearAllDiscourses(dlg: HTMLDialogElement) {
		getActiveDiscourseCheckboxes(dlg).forEach((d) => {
			d.checked = false;
		});
		dlg.querySelectorAll(".pdf-tree-chapter").forEach((ch) => {
			const cb = ch.querySelector(".pdf-chapter-cb") as HTMLInputElement | null;
			if (cb) {
				cb.checked = false;
				cb.indeterminate = false;
			}
		});
		updateExportTreeSelectionUi(dlg);
	}

	async function handleGenerate() {
		const dlg = getTargetCollectionPdfDialog();
		if (!dlg?.open) return;

		const generateBtn = dlg.querySelector(
			"#collection-pdf-generate",
		) as HTMLButtonElement | null;
		if (!generateBtn || generateBtn.disabled) return;

		const slug = generateBtn.dataset.collectionSlug;
		if (!slug) return;
		const exportBase =
			generateBtn.dataset.exportApiPath?.trim() ||
			`/api/export/${slug}`;

		const pliInput = dlg.querySelector(
			"#pdf-opt-pli",
		) as HTMLInputElement | null;
		const keyTermsInput = dlg.querySelector(
			"#pdf-opt-keyterms",
		) as HTMLInputElement | null;
		const vizShowInput = dlg.querySelector(
			"#pdf-opt-viz-show",
		) as HTMLInputElement | null;
		const vizColorsFieldset = dlg.querySelector(
			"#pdf-fieldset-viz-colors",
		) as HTMLFieldSetElement | null;

		if (!pliInput || !keyTermsInput) return;

		const format = getSelectedFormat(dlg);
		const hasVizControls = !!(vizShowInput && vizColorsFieldset);

		generateBtn.disabled = true;
		generateBtn.textContent =
			format === "epub" ? "Building EPUB…" : "Printing…";

		try {
			const d = new Date();
			const day = d.getDate();
			const suffix = [11, 12, 13].includes(day)
				? "th"
				: day % 10 === 1
					? "st"
					: day % 10 === 2
						? "nd"
						: day % 10 === 3
							? "rd"
							: "th";
			const month = d.toLocaleDateString("en-GB", { month: "long" });
			const year = d.getFullYear();
			const date = `${day}<sup>${suffix}</sup> ${month} ${year}`;

			const includeImages =
				hasVizControls && vizShowInput!.checked;
			const layoutEl = dlg.querySelector<HTMLInputElement>(
				'input[name="layout"]:checked',
			);
			const lay =
				format === "epub"
					? "interleaved"
					: layoutEl?.value === "split"
						? "split"
						: "interleaved";

			const qs = new URLSearchParams();
			qs.set("date", date);
			qs.set("format", format);
			qs.set("images", includeImages ? "svgPrimaryOnly" : "none");

			if (includeImages) {
				const mode = dlg.querySelector<HTMLInputElement>(
					'input[name="viz-mode"]:checked',
				);
				const vz = mode?.value;
				if (format === "epub") {
					qs.set("viz", vz === "dark" ? "dark" : "eink");
				} else if (
					vz === "light" ||
					vz === "dark" ||
					vz === "thermal"
				) {
					qs.set("viz", vz);
				}
			}

			if (pliInput.checked) {
				qs.set("pli", "true");
				qs.set("layout", lay);
			}

			if (!keyTermsInput.checked) {
				qs.set("keyTerms", "0");
			}

			const usePostExport = !!dlg.querySelector(".pdf-discourse-cb");
			let response: Response;
			if (usePostExport) {
				const selectedDiscourseSlugs = getActiveDiscourseCheckboxes(dlg)
					.filter((el) => el.checked)
					.map((el) => el.dataset.slug)
					.filter((s): s is string => !!s && s.length > 0);
				if (selectedDiscourseSlugs.length === 0) {
					showToast("Select at least one discourse.");
					return;
				}
				const postBody: Record<string, unknown> = {
					selectedDiscourseSlugs,
					date,
					format,
					images: includeImages ? "svgPrimaryOnly" : "none",
					pli: pliInput.checked,
					layout: lay,
					keyTerms: keyTermsInput.checked,
				};
				if (includeImages) {
					const mode = dlg.querySelector<HTMLInputElement>(
						'input[name="viz-mode"]:checked',
					);
					const vz = mode?.value;
					if (format === "epub") {
						postBody.viz = vz === "dark" ? "dark" : "eink";
					} else if (
						vz === "light" ||
						vz === "dark" ||
						vz === "thermal"
					) {
						postBody.viz = vz;
					}
				}
				response = await fetch(exportBase, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(postBody),
				});
			} else {
				response = await fetch(`${exportBase}?${qs.toString()}`);
			}

			if (!response.ok) {
				let detail = response.statusText;
				try {
					const body = await response.json();
					detail = (body as { error?: string }).error ?? detail;
				} catch {}
				if (response.status === 504) {
					detail =
						"The export took too long on the server. Try selecting fewer discourses, or try again in a moment.";
				}
				throw new Error(detail);
			}

			const blob = await response.blob();
			const objectUrl = URL.createObjectURL(blob);
			const disposition = response.headers.get("Content-Disposition") ?? "";
			const nameMatch = /filename="([^"]+)"/.exec(disposition);
			const filename =
				nameMatch?.[1] ?? `${slug}.${format === "epub" ? "epub" : "pdf"}`;

			const anchor = document.createElement("a");
			anchor.href = objectUrl;
			anchor.download = filename;
			document.body.appendChild(anchor);
			anchor.click();
			document.body.removeChild(anchor);
			setTimeout(() => URL.revokeObjectURL(objectUrl), 5000);
			closeCollectionPdfDialogs();
		} catch (err) {
			const msg = err instanceof Error ? err.message : String(err);
			const kind = format === "epub" ? "EPUB" : "PDF";
			showToast(`${kind} generation failed: ${msg}`);
		} finally {
			generateBtn.textContent = generateButtonLabel(dlg, format);
			if (dlg.querySelector(".pdf-discourse-cb")) {
				updateExportTreeSelectionUi(dlg);
			} else {
				generateBtn.disabled = false;
			}
		}
	}

	/** Rebind listeners directly on the live nodes after each navigation. */
	function wirePdfModalUi() {
		const dlg = dedupeCollectionPdfDialogs();
		if (!dlg) {
			return;
		}

		dlg.querySelectorAll("[data-collection-pdf-close]").forEach((btn) => {
			(btn as HTMLElement).onclick = (e) => {
				e.preventDefault();
				try {
					// Close every matching dialog — duplicate IDs can leave a second
					// `<dialog>` still open while the wired `dlg` reference is already closed.
					closeCollectionPdfDialogs();
				} catch (err) {
					console.error("[collection-pdf-modal] close threw", err);
				}
			};
		});

		dlg.onclick = (e) => {
			if (e.target === dlg) {
				closeCollectionPdfDialogs();
			}
		};

		const gen = dlg.querySelector("#collection-pdf-generate");
		if (gen) {
			(gen as HTMLElement).onclick = (e) => {
				e.preventDefault();
				void handleGenerate();
			};
		}

		const selAllBtn = dlg.querySelector("#pdf-select-all");
		if (selAllBtn) {
			(selAllBtn as HTMLElement).onclick = (e) => {
				e.preventDefault();
				resetExportTreeToAll(dlg);
			};
		}
		const clrBtn = dlg.querySelector("#pdf-clear-all");
		if (clrBtn) {
			(clrBtn as HTMLElement).onclick = (e) => {
				e.preventDefault();
				clearAllDiscourses(dlg);
			};
		}

		dlg.onchange = (e) => {
			const el = e.target as HTMLElement | null;
			if (!el) return;
			if (el.classList.contains("pdf-chapter-cb")) {
				applyChapterToDiscourses(el as HTMLInputElement);
				updateExportTreeSelectionUi(dlg);
				return;
			}
			if (el.classList.contains("pdf-discourse-cb")) {
				const ch = el.closest(".pdf-tree-chapter");
				if (ch) syncChapterFromChildren(ch);
				updateExportTreeSelectionUi(dlg);
				return;
			}
			if (el.id === "pdf-opt-pli" || el.id === "pdf-opt-viz-show") {
				applyFormatDependentUi(dlg);
			}
			if ((el as HTMLInputElement).name === "export-format") {
				applyFormatDependentUi(dlg);
				try {
					localStorage.setItem("exportFormat", getSelectedFormat(dlg));
				} catch {}
			}
			if (el.id === "pdf-opt-ref") {
				const includeRef = (el as HTMLInputElement).checked;
				setReferenceDiscoursesVisible(dlg, includeRef);
				if (includeRef) {
					dlg
						.querySelectorAll<HTMLInputElement>(
							".pdf-discourse-cb[data-is-reference='true']",
						)
						.forEach((cb) => {
							cb.checked = true;
						});
					dlg.querySelectorAll(".pdf-tree-chapter").forEach((ch) => {
						syncChapterFromChildren(ch);
					});
					updateExportTreeSelectionUi(dlg);
				}
			}
		};

		const openTriggers = document.querySelectorAll(
			"[data-open-collection-pdf-modal]",
		);
		openTriggers.forEach((btn) => {
			(btn as HTMLElement).onclick = (e) => {
				e.preventDefault();
				const d = dedupeCollectionPdfDialogs();
				if (!d) return;
				applyDefaultsFromPage(d);
				d.showModal();
			};
		});

		if (!keydownHandlerWired) {
			keydownHandlerWired = true;
			window.addEventListener(
				"keydown",
				(e) => {
					if (e.key !== "Escape") return;
					if (!getCollectionPdfDialogs().some((d) => d.open)) return;
					closeCollectionPdfDialogs();
					e.preventDefault();
				},
				true,
			);
		}
	}

	function bindToastDismissOnce() {
		if (document.documentElement.dataset.pdfModalToastDismiss === "1") return;
		document.documentElement.dataset.pdfModalToastDismiss = "1";
		document.addEventListener(
			"click",
			(e) => {
				const t = e.target as HTMLElement | null;
				if (!t) return;
				if (!t.closest(".collection-pdf-toast .toast-close")) return;
				e.preventDefault();
				clearTimeout(toastTimer);
				document
					.querySelector(".collection-pdf-toast")
					?.classList.remove("visible");
			},
			true,
		);
	}

	function initCollectionPdfModal() {
		bindToastDismissOnce();
		// Defer one tick so Astro’s DOM swap has committed (avoids dlg === null races).
		queueMicrotask(() => {
			wirePdfModalUi();
		});
	}

	document.addEventListener("DOMContentLoaded", initCollectionPdfModal);
	document.addEventListener("astro:page-load", initCollectionPdfModal);
	initCollectionPdfModal();
</script>
