---
import AiModeApp from "./AiModeApp.astro";
import type { AiAskShareSnapshot } from "../utils/aiAskShare";
import { askShareViewChrome } from "../utils/aiAskShare";
import { searchAskHref, searchResearchHref } from "../utils/aiAskHref";
import { isAskResearchEnabled } from "../utils/aiAskResearchUi";
import "../styles/ai-mode.css";

interface Props {
	share: AiAskShareSnapshot;
}

const { share } = Astro.props;
const chrome = askShareViewChrome(share, {
	researchEnabled: isAskResearchEnabled(),
});
---

<main class="container mx-auto px-3 sm:px-4 pt-2">
	<header class="search-ask-top">
		<h1 class="ai-title text-gradient-accent">{chrome.title}</h1>
		<nav class="ai-mode-switch" aria-label="Mode">
			<a href="/search">Search</a>
			<a
				class:list={[{ "is-active": !chrome.researchShare }]}
				href={searchAskHref()}
				aria-current={chrome.researchShare ? undefined : "page"}
			>
				Ask
			</a>
			{
				chrome.showResearchMode && (
					<a
						class:list={[{ "is-active": chrome.researchShare }]}
						href={searchResearchHref()}
						aria-current={chrome.researchShare ? "page" : undefined}
					>
						Research
					</a>
				)
			}
		</nav>
		<p class="ai-share-banner">
			{chrome.researchShare ? (
				<>
					Shared Research Report
					<span data-ai-share-register>
						{" · "}
						<a href={chrome.registerHref}>
							Create an account to generate your own
						</a>
					</span>
				</>
			) : (
				<>
					Shared Ask
					{" · "}
					<a href={searchAskHref()}>Ask your own question</a>
				</>
			)}
		</p>
	</header>
	<AiModeApp
		showTitle={false}
		shareMode={true}
		shareSnapshot={JSON.stringify(share)}
	/>
</main>

<script>
	import { readNavAuthCache } from "../utils/navAuthClient";
	import { loadPageUserState } from "../utils/pageUserStateClient";
	import { syncShareRegisterCta } from "../utils/aiAskShare";

	const cached = readNavAuthCache();
	if (cached) syncShareRegisterCta(document, cached.signedIn);
	if (document.querySelector("[data-ai-share-register]")) {
		void loadPageUserState()
			.then((data) => {
				if (!data) return;
				syncShareRegisterCta(document, data.signedIn === true);
			})
			.catch(() => {
				/* keep the SSR banner */
			});
	}
</script>
