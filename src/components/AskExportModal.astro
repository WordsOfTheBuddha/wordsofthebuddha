---
/**
 * Research PDF/EPUB download modal. Opened from the report action row via
 * `ask-export-open`. Ask answers are copy/share only.
 */
import "../styles/collection-pdf-export.css";
---

<dialog
	id="ask-pdf-export-dialog"
	class="collection-pdf-dialog"
	aria-labelledby="ask-pdf-export-title"
>
	<div class="collection-pdf-dialog-inner">
		<header class="collection-pdf-dialog-header">
			<h2 id="ask-pdf-export-title" class="collection-pdf-dialog-title">
				<span class="collection-pdf-dialog-action">Download</span>
				<span class="collection-pdf-dialog-subject" data-ask-export-subject>Ask</span>
			</h2>
			<button
				type="button"
				class="collection-pdf-dialog-close"
				aria-label="Close"
				data-ask-pdf-close
			>
				&times;
			</button>
		</header>

		<div class="collection-pdf-dialog-body">
			<div class="collection-pdf-main">
				<section
					id="ask-pdf-research-contents"
					class="collection-pdf-contents-select"
					aria-label="Choose what to include"
					hidden
				>
					<h3 class="collection-pdf-section-label">Contents</h3>
					<fieldset
						class="collection-pdf-format collection-pdf-format--stack"
						id="ask-export-contents-fieldset"
					>
						<legend class="sr-only">What to include</legend>
						<label class="collection-pdf-format-option">
							<input type="radio" name="ask-export-contents" value="report" />
							<span>
								<strong>Report only</strong>
								<span class="collection-pdf-format-desc">
									The write-up, no full discourses
								</span>
							</span>
						</label>
						<label
							class="collection-pdf-format-option"
							data-contents-option="cited"
						>
							<input
								type="radio"
								name="ask-export-contents"
								value="cited"
								checked
							/>
							<span>
								<strong>Report and cited discourses</strong>
								<span
									class="collection-pdf-format-desc"
									data-contents-cited-desc
								></span>
							</span>
						</label>
						<label
							class="collection-pdf-format-option"
							data-contents-option="all"
						>
							<input type="radio" name="ask-export-contents" value="all" />
							<span>
								<strong>Report and all sources</strong>
								<span
									class="collection-pdf-format-desc"
									data-contents-all-desc
								></span>
							</span>
						</label>
					</fieldset>
					<p
						class="collection-pdf-large-export-note"
						id="ask-pdf-large-export-note"
						hidden
					>
						Large exports may take a minute or two.
					</p>
				</section>
				<section
					id="ask-pdf-contents"
					class="collection-pdf-contents-select"
					aria-label="Choose questions and discourses"
				>
					<div class="collection-pdf-contents-head">
						<h3 class="collection-pdf-section-label">Discourses to include</h3>
						<div class="collection-pdf-contents-toolbar">
							<span class="collection-pdf-selection-count" id="ask-pdf-selection-count">
								0 of 0 selected
							</span>
							<button type="button" class="collection-pdf-btn-tertiary" id="ask-pdf-select-all">
								Select all
							</button>
							<button type="button" class="collection-pdf-btn-tertiary" id="ask-pdf-clear-all">
								Clear all
							</button>
						</div>
					</div>
					<div class="collection-pdf-tree-scroll" id="ask-pdf-tree-scroll" tabindex="0"></div>
				</section>
				<p class="collection-pdf-hint">
					These choices apply only to this download. They do not change how you read on the site.
				</p>
			</div>

			<div class="collection-pdf-settings">
				<section class="collection-pdf-format-block" aria-label="File format">
					<h3 class="collection-pdf-section-label">Format</h3>
					<fieldset class="collection-pdf-format" id="ask-export-format-fieldset">
						<legend class="sr-only">File format</legend>
						<label class="collection-pdf-format-option">
							<input type="radio" name="ask-export-format" value="pdf" checked />
							<span>
								<strong>PDF</strong>
								<span class="collection-pdf-format-desc">Print layout, A4 pages</span>
							</span>
						</label>
						<label class="collection-pdf-format-option">
							<input type="radio" name="ask-export-format" value="epub" />
							<span>
								<strong>EPUB</strong>
								<span class="collection-pdf-format-desc">Reflowable, for e-readers</span>
							</span>
						</label>
					</fieldset>
					<p id="ask-export-epub-note" class="collection-pdf-epub-note" hidden>
						EPUB uses interleaved Pāli (when included). Split-column layout and thermal print colors are PDF-only. Diagrams default to an e-ink paper profile.
					</p>
				</section>

				<section id="ask-pdf-options" class="collection-pdf-options" aria-label="Download options">
					<h3 class="collection-pdf-section-label">Options</h3>
					<div class="collection-pdf-option-stack">
						<div class="collection-pdf-option-group">
							<label class="collection-pdf-field">
								<input type="checkbox" id="ask-pdf-opt-pli" name="pli" />
								<span>Include Pāli text</span>
							</label>
							<fieldset class="collection-pdf-fieldset" id="ask-pdf-fieldset-layout" disabled>
								<legend class="sr-only">Pāli layout</legend>
								<label>
									<input type="radio" name="ask-layout" value="interleaved" checked />
									Interleaved (Pāli then English per paragraph)
								</label>
								<label>
									<input type="radio" name="ask-layout" value="split" />
									Split columns (English left, Pāli right)
								</label>
							</fieldset>
						</div>

						<div class="collection-pdf-option-group collection-pdf-viz-group" id="ask-pdf-opt-viz-group">
							<label class="collection-pdf-field">
								<input type="checkbox" id="ask-pdf-opt-viz-show" name="vizShow" />
								<span>Include discourse images</span>
							</label>
							<fieldset class="collection-pdf-fieldset" id="ask-pdf-fieldset-viz-colors" disabled>
								<legend class="sr-only">Diagram colors</legend>
								<label data-viz-mode-option="light">
									<input type="radio" name="ask-viz-mode" value="light" checked />
									Light
								</label>
								<label data-viz-mode-option="eink" hidden>
									<input type="radio" name="ask-viz-mode" value="eink" />
									E-ink
								</label>
								<label>
									<input type="radio" name="ask-viz-mode" value="dark" />
									Dark
								</label>
								<label data-viz-mode-option="thermal">
									<input type="radio" name="ask-viz-mode" value="thermal" />
									Thermal
								</label>
							</fieldset>
						</div>

						<label class="collection-pdf-field">
							<input type="checkbox" id="ask-pdf-opt-keyterms" name="keyterms" checked />
							<span>Include Key Terms glossary at the end of each discourse</span>
						</label>
					</div>
				</section>
			</div>
		</div>

		<footer class="collection-pdf-dialog-footer">
			<button type="button" class="collection-pdf-btn-secondary" data-ask-pdf-close>
				Cancel
			</button>
			<button
				type="button"
				class="collection-pdf-btn-primary"
				id="ask-pdf-generate"
				data-label-pdf="Print PDF"
				data-label-epub="Download EPUB"
			>
				Print PDF
			</button>
		</footer>
	</div>
</dialog>

<div class="collection-pdf-toast ask-pdf-toast" role="alert" aria-live="assertive">
	<span class="toast-msg"></span>
	<button type="button" class="toast-close" aria-label="Dismiss">&times;</button>
</div>

