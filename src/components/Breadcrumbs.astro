---
import { hideBreadcrumbsForPath } from "../utils/breadcrumbVisibility";
import { buildBreadcrumbTrail } from "../utils/breadcrumbTrail";

const { path } = Astro.props;

const hideBreadcrumbs = hideBreadcrumbsForPath(path);

const segments = path.split("/").filter(Boolean);
const lastSegment = segments[segments.length - 1];
const breadcrumbs = buildBreadcrumbTrail(path, Astro.url.pathname);
---

{
	!hideBreadcrumbs && (
		<div
			id="breadcrumbs-strip"
			class="breadcrumbs text-sm py-2 text-[var(--text-color)] border-b border-[var(--border-color)] overflow-x-auto scrollbar-hide"
		>
			<div class="flex items-center whitespace-nowrap min-w-max">
				{breadcrumbs.map((item, index) => (
					<>
						{index > 0 && (
							<svg
								class="w-4 h-4 mx-2 text-gray-400 dark:text-gray-500 flex-shrink-0"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 5l7 7-7 7"
								/>
							</svg>
						)}
						{index === breadcrumbs.length - 1 &&
						path.split("/")[1] === lastSegment ? (
							<span
								class="text-[var(--text-muted)] flex-shrink-0"
								title={item.title}
								aria-current="page"
							>
								{item.label}
							</span>
						) : (
							<a
								href={item.path}
								class="text-[var(--text-color)] hover:text-[var(--link-hover-color)] transition-colors duration-200 flex-shrink-0"
								title={item.title}
								aria-label={`Go to ${item.label}`}
								aria-keyshortcuts={
									index === breadcrumbs.length - 2
										? "Meta+ArrowUp Alt+ArrowUp"
										: undefined
								}
								data-nav-up={
									index === breadcrumbs.length - 2
										? ""
										: undefined
								}
							>
								{item.label}
								{index === breadcrumbs.length - 2 && (
									<kbd
										class="parent-nav-kbd"
										data-parent-nav-kbd
										aria-hidden="true"
									></kbd>
								)}
							</a>
						)}
					</>
				))}
			</div>
		</div>
	)
}

<style>
	.scrollbar-hide {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.scrollbar-hide::-webkit-scrollbar {
		display: none;
	}

	.parent-nav-kbd {
		display: none;
		margin-left: 0.4em;
		padding: 1px 4px;
		border: 1px solid var(--border-color);
		border-bottom-width: 2px;
		border-radius: 4px;
		background: var(--background-color);
		color: var(--text-muted);
		font:
			600 10px/1.4 system-ui,
			-apple-system,
			Segoe UI,
			Roboto,
			sans-serif;
		vertical-align: 0.1em;
	}

	@media (hover: hover) and (pointer: fine) {
		[data-nav-up]:hover .parent-nav-kbd,
		[data-nav-up]:focus-visible .parent-nav-kbd {
			display: inline-block;
		}
	}

	@media print {
		.parent-nav-kbd {
			display: none !important;
		}
	}
</style>

<script>
	import { installParentNavShortcut } from "../utils/parentNavShortcut";

	installParentNavShortcut();
</script>
