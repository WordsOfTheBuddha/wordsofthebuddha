---
// Sujato reference view (rewritten from /:slug/en/sujato by middleware).
// Canonicalises to the bare /:slug so this translation and the site's own do not
// compete for the same discourse query.
export const prerender = false;
import { buildReferenceDiscoursePage } from "../../utils/referenceDiscoursePage";
import Layout from "../../layouts/Layout.astro";
import MDContent from "../../components/MDContent.astro";

const { id } = Astro.params as { id?: string };

if (!id) {
	return new Response(null, { status: 404 });
}

const refPage = await buildReferenceDiscoursePage(id, {
	sujatoRoute: true,
	refMode: true,
});
if (!refPage) {
	return new Response(null, { status: 404 });
}

const {
	mainContent,
	splitAvailable,
	refPaliOnlyContent,
	referenceFallbackPage,
	suttaProps,
} = refPage;
---

<Layout {...suttaProps} canonicalPath={`/${id}`}>
	<MDContent
		content={mainContent}
		splitAvailable={splitAvailable}
		refPaliOnlyContent={refPaliOnlyContent}
		referenceFallback={referenceFallbackPage}
	/>
</Layout>
