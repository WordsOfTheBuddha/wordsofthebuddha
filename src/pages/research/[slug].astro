---
/**
 * Public /research/:slug entry. Middleware also rewrites here → /shared-ask/:slug
 * so styles load even when the catch-all would otherwise win.
 */
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import AskShareView from "../../components/AskShareView.astro";
import { loadAskShare } from "../../utils/aiAskShareServer";
import {
	askSharePageRedirect,
	askSharePath,
	askShareSeo,
	normalizeAskShareSlug,
} from "../../utils/aiAskShare";
import "../../styles/global.css";
import "../../styles/ai-mode.css";
import "../../styles/content.css";

const rawSlug = Astro.params.slug || "";
const slug = normalizeAskShareSlug(rawSlug);
const share = slug ? await loadAskShare(slug) : null;
const bounce = askSharePageRedirect(Astro.url.pathname, share);
if (bounce) {
	return Astro.redirect(bounce);
}
if (!share) {
	return Astro.redirect("/search?mode=research");
}

const seo = askShareSeo(share);
const seoTitle = seo.title;
const seoDescription = seo.description;
const canonicalPath = askSharePath(share.slug, {
	research: share.research === true,
});
---

<Layout
	title=""
	seoTitle={seoTitle}
	seoDescription={seoDescription}
	canonicalPath={canonicalPath}
	showAuth={true}
	showSearch={false}
>
	<AskShareView share={share} />
</Layout>
