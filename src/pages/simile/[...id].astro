---
export const prerender = false;
import simileMappings from "../../data/simileMappings.json";
import {
	canonicalOnSlug,
	createSlugVariants,
	matchesSlugValue,
} from "../../utils/discover-data";

interface SimileMap {
	[letter: string]: {
		[simile: string]: unknown;
	};
}

const typedSimileMappings = simileMappings as unknown as SimileMap;

const { id } = Astro.params;
if (!id) {
	return Astro.redirect("/simile");
}

const slugVariants = new Set(createSlugVariants(decodeURIComponent(id)));
let simileMatch = "";

Object.keys(typedSimileMappings).forEach((letter) => {
	Object.keys(typedSimileMappings[letter]).forEach((simile) => {
		if (matchesSlugValue(simile, slugVariants)) {
			simileMatch = simile;
		}
	});
});

if (!simileMatch) {
	return Astro.redirect("/simile");
}

return Astro.redirect(`/on/${canonicalOnSlug(simileMatch)}`, 301);
---
