---
// Static so visitors far from the function region are served from the edge.
export const prerender = true;

import { render, getEntry } from "astro:content";
import { routes } from "../../utils/routes";
import {
	ANTHOLOGY_SLUGS,
	WOTB_LEGACY_SLUG,
	WOTB_SLUG,
} from "../../utils/anthologySlugs";
import Layout from "../../layouts/Layout.astro";
import { getLastModified } from "../../utils/getLastModified";
import WordOfTheBuddhaContents from "../../components/WordOfTheBuddhaContents.astro";
import WordOfTheBuddhaSection from "../../components/WordOfTheBuddhaSection.astro";
import {
	loadWotbBook,
	resolveWotb,
	wotbChapter,
	wotbDescription,
	wotbHref,
	wotbNeighbors,
	type WotbNode,
} from "../../utils/wordOfTheBuddha";

export function getStaticPaths() {
	const ids: string[] = [...ANTHOLOGY_SLUGS];
	// Headings without passages of their own redirect to their first page.
	const walk = (node: WotbNode) => {
		ids.push(`${WOTB_SLUG}/${node.segments.join("/")}`);
		node.children.forEach(walk);
	};
	loadWotbBook().forEach(walk);
	return ids.map((id) => ({ params: { id } }));
}

const { id: rawId = "" } = Astro.params;
// The book used to live at /anthologies/word-of-the-buddha.
if (
	rawId === WOTB_LEGACY_SLUG ||
	rawId.startsWith(`${WOTB_LEGACY_SLUG}/`)
) {
	const rest = rawId.slice(WOTB_LEGACY_SLUG.length);
	return Astro.redirect(`/anthologies/${WOTB_SLUG}${rest}`, 301);
}
const wotbRest = rawId.startsWith(`${WOTB_SLUG}/`)
	? rawId.slice(`${WOTB_SLUG}/`.length)
	: "";
const wotbSegments = wotbRest.split("/").filter(Boolean);

let wotbPage: WotbNode | null = null;
if (wotbSegments.length > 0) {
	const resolved = resolveWotb(wotbSegments);
	if (!resolved) {
		return Astro.redirect(`/anthologies/${WOTB_SLUG}`);
	}
	if (resolved.redirectTo) {
		return Astro.redirect(resolved.redirectTo);
	}
	wotbPage = resolved.node;
}

const wotbBookChapter = wotbPage ? wotbChapter(wotbPage) : null;
const wotbNested = Boolean(wotbPage && wotbPage.segments.length > 1);
const wotbOutline =
	wotbPage && wotbPage.segments.length === 1 && wotbPage.children.length > 0
		? wotbPage.children
		: null;
const { prev: wotbPrev, next: wotbNext } = wotbPage
	? wotbNeighbors(wotbPage)
	: { prev: null, next: null };

const id = wotbPage ? WOTB_SLUG : rawId;
const currentIndex = wotbPage ? -1 : routes.findIndex((route) => route === id);
if (!wotbPage && currentIndex === -1) {
	return Astro.redirect(
		`/search?q=${encodeURIComponent(`anthology ${rawId}`)}`,
	);
}

const contentItem = wotbPage ? null : await getEntry("all", id);
if (!wotbPage && !contentItem) {
	return Astro.rewrite("/404");
}

const fpParts = (contentItem?.filePath ?? "").split("/");
const folder = fpParts[fpParts.length - 2] || "";
const fp = wotbPage
	? `anthologies/${WOTB_SLUG}/${wotbPage.segments.join("/")}`
	: folder
		? `${folder}/${id}`
		: id;

const rendered = contentItem ? await render(contentItem) : null;
const BookContent = rendered?.Content;

const nextIndex = currentIndex + 1;
const prevIndex = currentIndex - 1;
const next =
	!wotbPage && nextIndex < routes.length
		? await getEntry("all", routes[nextIndex])
		: null;
const prev =
	!wotbPage && prevIndex >= 0
		? await getEntry("all", routes[prevIndex])
		: null;

const lastUpdated = wotbPage
	? getLastModified(wotbBookChapter?.file ?? "")
	: contentItem?.filePath
		? getLastModified(contentItem.filePath)
		: null;

// Work-in-progress anthologies stay previewable by URL but out of search engines.
const isDraft = contentItem?.data.draft === true;

const title = wotbPage?.title ?? contentItem?.data.title ?? "";
const seoDescription = wotbPage
	? wotbDescription(wotbPage)
	: contentItem?.data.description;
---

<Layout
	fp={fp}
	title={title}
	seoDescription={seoDescription}
	prev={prev}
	next={next}
	id={id}
	lastUpdated={lastUpdated}
	showAuth={true}
	robots={isDraft ? "noindex, nofollow" : null}
>
	{
		wotbPage ? (
			<>
				<p class="not-prose mb-6 text-sm">
					<a href={`/anthologies/${WOTB_SLUG}`}>The Word of the Buddha</a>
					{wotbNested && wotbBookChapter && (
						<>
							<span aria-hidden="true"> · </span>
							<a href={wotbHref([wotbBookChapter.slug])}>
								{wotbBookChapter.title}
							</a>
						</>
					)}
				</p>
				<WordOfTheBuddhaSection blocks={wotbPage.blocks} />
				{
					wotbOutline && (
						<WordOfTheBuddhaContents
							nodes={wotbOutline}
							heading="Contents"
						/>
					)
				}
				<nav
					class="not-prose mt-12 flex items-start justify-between gap-6 text-sm"
					aria-label="Previous and next"
				>
					<div class="min-w-0 flex-1">
						{wotbPrev && (
							<a href={wotbHref(wotbPrev.segments)}>{wotbPrev.title}</a>
						)}
					</div>
					<div class="min-w-0 flex-1 text-right">
						{wotbNext && (
							<a href={wotbHref(wotbNext.segments)}>{wotbNext.title}</a>
						)}
					</div>
				</nav>
			</>
		) : (
			BookContent && <BookContent />
		)
	}
</Layout>
