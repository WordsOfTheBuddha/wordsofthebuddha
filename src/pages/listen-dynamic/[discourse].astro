---
/**
 * SSR listen-mode for excerpt URLs (`/listen/dhp2`).
 *
 * Public URL stays `/listen/{requested}`; this route is an internal rewrite
 * target so prerendered `listen/[discourse]` (file slugs only) does not 404.
 * Audio, queue, listen minutes, and mark-on-complete use the parent file
 * (`dhp1-20`), the same as `/listen/dhp1-20`. Paragraph `?pp=` excerpts still
 * do not auto-mark read.
 */
export const prerender = false;
import { getEntry } from "astro:content";
import { routes } from "../../utils/routes";
import { formatDisplayId, nextAudioSlug, prevAudioSlug } from "../../utils/listenMode";
import { findRangeParentSlug } from "../../utils/referenceSegmentParser";
import ListenLayout from "../../layouts/ListenLayout.astro";
import ListenShell from "../../components/ListenShell.astro";

const { discourse: requestedId } = Astro.params as { discourse?: string };
if (!requestedId) {
	return new Response(null, { status: 404 });
}

const fileSlug = findRangeParentSlug(requestedId, routes) ?? requestedId;
const item = await getEntry("all", fileSlug);
if (!item) {
	return Astro.redirect(`/search?q=${encodeURIComponent(requestedId)}`);
}

const title: string = item.data.title ?? fileSlug;
const description: string | undefined = item.data.description;
const displayId = formatDisplayId(fileSlug);

const nextSlug = nextAudioSlug(fileSlug);
const prevSlug = prevAudioSlug(fileSlug);

async function lookupTitle(slug: string | null): Promise<string | null> {
	if (!slug) return null;
	try {
		const e = await getEntry("all", slug);
		return (e?.data.title as string | undefined) ?? null;
	} catch {
		return null;
	}
}

async function lookupDescription(slug: string | null): Promise<string | null> {
	if (!slug) return null;
	try {
		const e = await getEntry("all", slug);
		return (e?.data.description as string | undefined) ?? null;
	} catch {
		return null;
	}
}
const nextTitle = await lookupTitle(nextSlug);
const prevTitle = await lookupTitle(prevSlug);
const nextDescription = await lookupDescription(nextSlug);
const prevDescription = await lookupDescription(prevSlug);
---

<ListenLayout title={title} description={description} displayId={displayId} slug={fileSlug}>
	<ListenShell
		slug={fileSlug}
		requestedSlug={requestedId}
		displayId={displayId}
		title={title}
		description={description}
		nextSlug={nextSlug}
		nextTitle={nextTitle}
		nextDescription={nextDescription}
		nextDisplayId={nextSlug ? formatDisplayId(nextSlug) : null}
		prevSlug={prevSlug}
		prevTitle={prevTitle}
		prevDescription={prevDescription}
		prevDisplayId={prevSlug ? formatDisplayId(prevSlug) : null}
	/>
</ListenLayout>
