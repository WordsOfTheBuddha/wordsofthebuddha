---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import DonateWidget from "../components/DonateWidget.astro";
import {
	supportAreas,
	supportAreasLede,
	supportOtherWays,
	supportOtherWaysLede,
} from "../data/support";
import { getSupportImpact } from "../data/analytics";
import { thanksPeople, thanksPlaces } from "../data/thanks";
import { loadRecentlyAddedFeed } from "../utils/loadRecentlyAddedFeed";
import { supportRecentWork } from "../utils/recentDiscourses";
import { transformId } from "../utils/transformId";

const FALLBACK_GIFT_EXCERPT =
	"There are these five kinds of gifts of a true person. What five? 1.) One gives a gift out of faith; 2.) One gives a gift respectfully; 3.) One gives a gift at a suitable time; 4.) One gives a gift unreservedly; 5.) One gives a gift without injuring oneself or another.";

const giftHref = "/an5.148";
const giftId = transformId("an5.148");
const giftExcerpt = FALLBACK_GIFT_EXCERPT;
const supportImpact = await getSupportImpact();
const recentWork = supportRecentWork(await loadRecentlyAddedFeed());
const impactLabel = [
	supportImpact.dateLine ? `Reach, ${supportImpact.dateLine}` : "Reach",
	`${recentWork.value} ${recentWork.label}`,
].join(". ");
---

<Layout
	fp="/support"
	title="Support"
	seoTitle="Support — Words of the Buddha"
	seoDescription="Support Words of the Buddha. Nothing is expected; whatever you can give helps keep the public-domain translations, audio, and study tools freely available to everyone."
	showAuth={false}
>
	<div class="support-page not-prose w-full">
		<section class="support-give" aria-labelledby="page-title">
			<div class="support-give-lead flex flex-col gap-5">
				<p class="support-intro m-0 text-[1.05rem] leading-relaxed">
					Words of the Buddha translations are in the public domain and freely
					available to everyone, along with the audio, Pāli lookup, Ask, and
					the other study tools built around them.
				</p>
				<p class="support-intro m-0 text-[1.05rem] leading-relaxed">
					Nothing is expected. Whatever you are able to give is appreciated,
					and helps keep it that way.
				</p>

				<DonateWidget />
			</div>
		</section>

		<div class="support-paths">
			<section
				class="support-areas not-prose"
				aria-labelledby="support-areas-heading"
			>
				<h2
					id="support-areas-heading"
					class="mt-0 mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100"
				>
					Where support goes
				</h2>
				<p class="support-path-lede">
					{supportAreasLede}
				</p>
				<div class="support-lined-list flex w-full flex-col border-b border-[var(--surface-border)]">
					{
						supportAreas.map((row) => (
							<div class="support-lined-row w-full border-t border-[var(--surface-border)] py-2.5">
								<div class="support-lined-item font-medium leading-snug">
									{row.item}
								</div>
								{row.note && (
									<div class="support-lined-note mt-0.5 text-sm leading-snug">
										{row.note}
									</div>
								)}
							</div>
						))
					}
				</div>
			</section>

			<section
				class="support-other not-prose"
				aria-labelledby="support-other-heading"
			>
				<h2
					id="support-other-heading"
					class="mt-0 mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100"
				>
					Other ways to support
				</h2>
				<p class="support-path-lede">
					{supportOtherWaysLede}
				</p>
				<div class="support-lined-list flex w-full flex-col border-b border-[var(--surface-border)]">
					{
						supportOtherWays.map((row) => (
							<div class="support-lined-row w-full border-t border-[var(--surface-border)] py-2.5">
								<div class="support-lined-item font-medium leading-snug">
									{row.href ? (
										<a href={row.href}>{row.item}</a>
									) : (
										row.item
									)}
								</div>
								{row.note && (
									<div class="support-lined-note mt-0.5 text-sm leading-snug">
										{row.note}
									</div>
								)}
							</div>
						))
					}
				</div>
			</section>
		</div>

		<section
			class="support-impact not-prose mt-10"
			aria-label={impactLabel}
		>
			{
				supportImpact.dateLine && (
					<p class="support-impact-dates">{supportImpact.dateLine}</p>
				)
			}
			{
				(supportImpact.stats.length > 0 || recentWork) && (
					<ul
						class:list={[
							"support-impact-stats",
							supportImpact.stats.length > 0 && "support-impact-stats--reach",
						]}
					>
						<li class="support-impact-stat support-impact-recent">
							<a
								href={recentWork.href}
								class="support-impact-recent-link"
							>
								<span class="support-impact-value">{recentWork.value}</span>
								<span class="support-impact-label">{recentWork.label}</span>
							</a>
						</li>
						{supportImpact.stats.map((stat) => (
							<li class="support-impact-stat">
								<span class="support-impact-value">{stat.value}</span>
								<span class="support-impact-label">{stat.label}</span>
							</li>
						))}
					</ul>
				)
			}
			{
				supportImpact.note && (
					<p class="support-impact-note">{supportImpact.note}</p>
				)
			}
		</section>

		<section class="support-quiet not-prose mt-14" aria-labelledby="support-thanks">
			<h2
				id="support-thanks"
				class="mt-0 mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100"
			>
				Thanks
			</h2>
			<p>
				Appreciation and thanks to these monasteries and places of seclusion
				that have been supportive in sustaining my practice of the Noble Eightfold Path.
			</p>
			{
				thanksPlaces.length > 0 && (
					<>
						<ul>
							{thanksPlaces.map((place) => (
								<li>
									<strong>{place.name}</strong>
									{place.location ? `, ${place.location}` : ""}
									{place.note ? ` — ${place.note}` : ""}
								</li>
							))}
						</ul>
					</>
				)
			}
			{
				thanksPeople.length > 0 && (
					<>
						<h3>People</h3>
						<ul>
							{thanksPeople.map((person) => (
								<li>
									<strong>{person.name}</strong>
									{person.location ? `, ${person.location}` : ""}
									{person.note ? ` — ${person.note}` : ""}
								</li>
							))}
						</ul>
					</>
				)
			}
		</section>
					<section class="support-sutta not-prose mx-auto mt-10 w-full">
				<div
					class="rounded-2xl border p-6 sm:p-8 text-center"
					style="border-color:var(--surface-border); background:var(--surface-elevated);"
				>
					<blockquote
						class="text-lg sm:text-xl leading-relaxed italic"
						style="quotes:none; border:none; margin:0; padding:0; color:var(--text-color);"
					>
						{`\u201C${giftExcerpt}\u201D`}
					</blockquote>
					<p class="mt-3 text-sm" style="color:var(--text-muted);">
						—{" "}
						<a href={giftHref} style="color:var(--link-color);">
							{giftId}
						</a>
						<span class="mx-1.5" style="opacity:0.35;">
							·
						</span>
						<a
							href={giftHref}
							class="text-sm transition-colors duration-200"
							style="color:var(--text-muted); opacity:0.7; text-decoration:none;"
						>
							Read discourse
						</a>
					</p>
				</div>
			</section>
	</div>
</Layout>

<style is:global>
	.support-page.not-prose {
		color: var(--text-color);
	}

	/* Dark theme: warmer, lighter muted grey for notes and secondary copy. */
	html.dark .support-page {
		--text-muted: #c4b8aa;
	}

	.support-page.not-prose .support-intro,
	.support-page.not-prose .support-path-lede {
		font-size: 1.05rem;
		font-weight: 400;
		line-height: 1.625;
		color: var(--text-color);
	}

	.support-page.not-prose .support-path-lede {
		margin: 0 0 0.75rem;
	}

	.support-page.not-prose .support-paths {
		display: grid;
		gap: 2.5rem;
		margin-top: 2.5rem;
		min-width: 0;
	}

	@media (min-width: 768px) {
		.support-page.not-prose .support-paths {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			grid-template-rows: auto auto auto;
			column-gap: 2.5rem;
			row-gap: 0;
			align-items: start;
		}

		.support-page.not-prose .support-paths > section {
			display: grid;
			grid-template-rows: subgrid;
			grid-row: span 3;
			min-width: 0;
		}

		.support-page.not-prose .support-paths h2 {
			margin-bottom: 0.5rem;
		}

		.support-page.not-prose .support-path-lede {
			margin-bottom: 0.75rem;
		}
	}

	.support-page.not-prose .support-impact-dates {
		margin: 0 0 0.8rem;
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.support-page.not-prose .support-impact-stats {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: max-content max-content;
		justify-content: start;
		align-items: baseline;
		column-gap: 0.55em;
		row-gap: 0.5rem;
	}

	.support-page.not-prose .support-impact-stat {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: baseline;
		margin: 0;
	}

	.support-page.not-prose .support-impact-recent-link {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: baseline;
		text-decoration: none;
		color: inherit;
	}

	.support-page.not-prose .support-impact-value {
		text-align: end;
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.3;
		font-variant-numeric: tabular-nums;
		color: var(--text-color);
	}

	.support-page.not-prose .support-impact-label {
		font-size: 0.98rem;
		font-weight: 400;
		line-height: 1.4;
		color: var(--text-muted);
		white-space: nowrap;
	}

	@media (min-width: 768px) {
		.support-page.not-prose .support-impact-stats--reach {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: 1.5rem;
			row-gap: 0.85rem;
		}

		.support-page.not-prose .support-impact-stat,
		.support-page.not-prose .support-impact-recent-link {
			display: flex;
			flex-wrap: wrap;
			gap: 0.15em 0.45em;
			grid-column: auto;
		}

		.support-page.not-prose .support-impact-value {
			text-align: start;
		}
	}

	.support-page.not-prose .support-impact-recent-link .support-impact-label {
		color: var(--link-color);
	}

	.support-page.not-prose .support-impact-recent-link:hover .support-impact-label {
		text-decoration: underline;
	}

	.support-page.not-prose .support-impact-note {
		margin: 0.75rem 0 0;
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-muted);
	}

	/* Section titles one step below Layout Title h1 (text-2xl / 1.5rem bold). */
	.support-page.not-prose .support-areas h2,
	.support-page.not-prose .support-other h2,
	.support-page.not-prose .support-quiet h2 {
		margin: 0 0 0.5rem;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.75rem;
		color: inherit;
	}

	.support-page.not-prose .support-lined-item {
		font-weight: 500;
	}

	.support-page.not-prose .support-lined-note {
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--text-muted);
	}

	.support-page.not-prose .support-other a {
		color: var(--link-color);
	}

	.support-page.not-prose .support-sutta blockquote {
		quotes: none;
		border: none;
		margin: 0;
		padding: 0;
		font-style: italic;
		color: var(--text-color);
	}

	.support-page.not-prose .support-sutta a {
		text-decoration: none;
	}

	.support-page.not-prose .support-quiet {
		margin-top: 3.5rem;
		padding-bottom: 0.25rem;
		color: var(--text-muted);
	}

	.support-page.not-prose .support-quiet h2 {
		color: var(--text-color);
	}

	.support-page.not-prose .support-quiet h3 {
		margin: 0.85rem 0 0.3rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text-color);
	}

	.support-page.not-prose .support-quiet p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.support-page.not-prose .support-quiet ul {
		margin: 0.5rem 0 0;
	}

	.support-page.not-prose .support-quiet li {
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.support-page.not-prose .support-quiet li + li {
		margin-top: 0.2rem;
	}
</style>
