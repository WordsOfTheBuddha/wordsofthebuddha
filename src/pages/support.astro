---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import DonateWidget from "../components/DonateWidget.astro";
import { supportCosts, supportCostsYear } from "../data/support";
import { getSupportImpact } from "../data/analytics";
import { thanksPeople, thanksPlaces } from "../data/thanks";
import { transformId } from "../utils/transformId";

function formatUsd(n: number): string {
	if (n === 0) return "—";
	return n % 1 === 0 ? `$${n.toFixed(0)}` : `$${n.toFixed(2)}`;
}

const FALLBACK_GIFT_EXCERPT =
	"There are these five kinds of gifts of a true person. What five? 1.) One gives a gift out of faith; 2.) One gives a gift respectfully; 3.) One gives a gift at a suitable time; 4.) One gives a gift unreservedly; 5.) One gives a gift without injuring oneself or another.";

const giftHref = "/an5.148";
const giftId = transformId("an5.148");
const giftExcerpt = FALLBACK_GIFT_EXCERPT;
const supportImpact = await getSupportImpact();
---

<Layout
	fp="/support"
	title="Support"
	seoTitle="Support — Words of the Buddha"
	seoDescription="Gifts support the free, public-domain translations on Words of the Buddha — tools, hosting, and the work of keeping the discourses available."
	showAuth={false}
>
	<div class="support-page not-prose w-full">
		<section class="support-give" aria-labelledby="page-title">
			<div class="support-give-lead flex flex-col gap-5">
				<p class="support-intro m-0 text-[1.05rem] leading-relaxed">
					Words of the Buddha translations are free and in the public domain.
				</p>

				<DonateWidget />
			</div>

			<div class="support-costs not-prose mt-10" aria-labelledby="support-costs-heading">
				<h2
					id="support-costs-heading"
					class="mt-0 mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100"
				>
					Where gifts go
				</h2>
				<p class="support-costs-lede m-0 mb-3 text-[1.05rem] font-normal leading-relaxed">
					Typical monthly costs in {supportCostsYear}. Right now, gifts go toward updating translations and making them accessible.
				</p>
				<div class="support-costs-list flex w-full flex-col border-b border-[var(--surface-border)]">
					{
						supportCosts.map((row) => (
							<div class="support-costs-row grid w-full grid-cols-[minmax(0,1fr)_4.5rem] items-start gap-x-4 border-t border-[var(--surface-border)] py-2.5">
								<div class="support-costs-copy min-w-0">
									<div class="support-costs-item font-medium leading-snug">
										{row.item}
									</div>
									{row.note && (
										<div class="support-costs-note mt-0.5 text-sm leading-snug">
											{row.note}
										</div>
									)}
								</div>
								<div class="support-costs-amount w-[4.5rem] shrink-0 pt-0.5 text-right tabular-nums whitespace-nowrap">
									{row.tentative ? "*" : formatUsd(row.monthlyUsd)}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section
			class="support-impact not-prose mt-10"
			aria-label={supportImpact.dateLine
				? `Reach, ${supportImpact.dateLine}`
				: "Reach"}
		>
			{
				supportImpact.dateLine && (
					<p class="support-impact-dates">{supportImpact.dateLine}</p>
				)
			}
			{
				supportImpact.stats.length > 0 && (
					<ul
						class:list={[
							"support-impact-stats",
							"grid",
							"grid-cols-1",
							supportImpact.stats.length >= 3 && "sm:grid-cols-3",
							supportImpact.stats.length === 2 && "sm:grid-cols-2",
						]}
					>
						{supportImpact.stats.map((stat) => (
							<li class="support-impact-stat">
								<span class="support-impact-value">{stat.value}</span>
								<span class="support-impact-label">{stat.label}</span>
							</li>
						))}
					</ul>
				)
			}
			{
				supportImpact.note && (
					<p class="support-impact-note">{supportImpact.note}</p>
				)
			}
		</section>

		<section
			class="support-other not-prose mt-14"
			aria-labelledby="support-other-heading"
		>
			<h2
				id="support-other-heading"
				class="mt-0 mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100"
			>
				Other ways to support
			</h2>
			<p class="support-other-lede m-0 text-[1.05rem] font-normal leading-relaxed">
				If you have any bright idea to improve Words of the Buddha, or would like to support with your time, expertise, or resources in any way, large or small,{" "}
				<a href="mailto:hello@wordsofthebuddha.org">
					write to us by email
				</a>.
			</p>
		</section>

		<section class="support-quiet not-prose mt-14" aria-labelledby="support-thanks">
			<h2
				id="support-thanks"
				class="mt-0 mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100"
			>
				Thanks
			</h2>
			<p>
				Appreciation and thanks to these monasteries and places of seclusion
				that have been supportive in sustaining my practice of the Noble Eightfold Path.
			</p>
			{
				thanksPlaces.length > 0 && (
					<>
						<ul>
							{thanksPlaces.map((place) => (
								<li>
									<strong>{place.name}</strong>
									{place.location ? `, ${place.location}` : ""}
									{place.note ? ` — ${place.note}` : ""}
								</li>
							))}
						</ul>
					</>
				)
			}
			{
				thanksPeople.length > 0 && (
					<>
						<h3>People</h3>
						<ul>
							{thanksPeople.map((person) => (
								<li>
									<strong>{person.name}</strong>
									{person.location ? `, ${person.location}` : ""}
									{person.note ? ` — ${person.note}` : ""}
								</li>
							))}
						</ul>
					</>
				)
			}
		</section>
					<section class="support-sutta not-prose mx-auto mt-10 w-full">
				<div
					class="rounded-2xl border p-6 sm:p-8 text-center"
					style="border-color:var(--surface-border); background:var(--surface-elevated);"
				>
					<blockquote
						class="text-lg sm:text-xl leading-relaxed italic"
						style="quotes:none; border:none; margin:0; padding:0; color:var(--text-color);"
					>
						{`\u201C${giftExcerpt}\u201D`}
					</blockquote>
					<p class="mt-3 text-sm" style="color:var(--text-muted);">
						—{" "}
						<a href={giftHref} style="color:var(--link-color);">
							{giftId}
						</a>
						<span class="mx-1.5" style="opacity:0.35;">
							·
						</span>
						<a
							href={giftHref}
							class="text-sm transition-colors duration-200"
							style="color:var(--text-muted); opacity:0.7; text-decoration:none;"
						>
							Read discourse
						</a>
					</p>
				</div>
			</section>
	</div>
</Layout>

<style is:global>
	.support-page.not-prose {
		color: var(--text-color);
	}

	/* Dark theme: warmer, lighter muted grey for notes and secondary copy. */
	html.dark .support-page {
		--text-muted: #c4b8aa;
	}

	.support-page.not-prose .support-intro,
	.support-page.not-prose .support-costs-lede,
	.support-page.not-prose .support-other-lede {
		font-size: 1.05rem;
		font-weight: 400;
		line-height: 1.625;
		color: var(--text-color);
	}

	.support-page.not-prose .support-impact-dates {
		margin: 0 0 0.8rem;
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.support-page.not-prose .support-impact-stats {
		list-style: none;
		margin: 0;
		padding: 0;
		column-gap: 1.5rem;
		row-gap: 0.85rem;
	}

	.support-page.not-prose .support-impact-stat {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35em 0.5em;
		margin: 0;
	}

	.support-page.not-prose .support-impact-value {
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.3;
		font-variant-numeric: tabular-nums;
		color: var(--text-color);
	}

	.support-page.not-prose .support-impact-label {
		font-size: 0.98rem;
		font-weight: 400;
		line-height: 1.4;
		color: var(--text-muted);
	}

	.support-page.not-prose .support-impact-note {
		margin: 0.75rem 0 0;
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-muted);
	}

	/* Section titles one step below Layout Title h1 (text-2xl / 1.5rem bold). */
	.support-page.not-prose .support-costs h2,
	.support-page.not-prose .support-other h2,
	.support-page.not-prose .support-quiet h2 {
		margin: 0 0 0.5rem;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.75rem;
		color: inherit;
	}

	.support-page.not-prose .support-costs-lede {
		margin: 0 0 0.75rem;
	}

	.support-page.not-prose .support-costs-item {
		font-weight: 500;
	}

	.support-page.not-prose .support-costs-note {
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--text-muted);
	}

	.support-page.not-prose .support-other a {
		color: var(--link-color);
	}

	.support-page.not-prose .support-costs-row {
		display: grid !important;
		grid-template-columns: minmax(0, 1fr) 4.5rem !important;
		column-gap: 1rem;
		align-items: start;
		width: 100%;
	}

	.support-page.not-prose .support-costs-amount {
		text-align: right;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.support-page.not-prose .support-sutta blockquote {
		quotes: none;
		border: none;
		margin: 0;
		padding: 0;
		font-style: italic;
		color: var(--text-color);
	}

	.support-page.not-prose .support-sutta a {
		text-decoration: none;
	}

	.support-page.not-prose .support-quiet {
		margin-top: 3.5rem;
		padding-bottom: 0.25rem;
		color: var(--text-muted);
	}

	.support-page.not-prose .support-quiet h2 {
		color: var(--text-color);
	}

	.support-page.not-prose .support-quiet h3 {
		margin: 0.85rem 0 0.3rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text-color);
	}

	.support-page.not-prose .support-quiet p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.support-page.not-prose .support-quiet ul {
		margin: 0.5rem 0 0;
	}

	.support-page.not-prose .support-quiet li {
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.support-page.not-prose .support-quiet li + li {
		margin-top: 0.2rem;
	}
</style>
