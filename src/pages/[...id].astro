---
// Catch-all stays SSR to support partial paragraph routes
export const prerender = false;
import { routes } from "../utils/routes";
import { directoryStructure } from "../data/directoryStructure";
import Layout from "../layouts/Layout.astro";
import MDContent from "../components/MDContent.astro";
import {
	resolveCatchAllDiscoursePage,
} from "../utils/catchAllDiscoursePage";
import { canonicalOnSlug, resolveOnSlugFallback } from "../utils/discover-data";
import {
	parsePostSlugFromGlobPath,
	slugIsRootPost,
} from "../utils/rootPostSlugs";

type CatchAllPostModule = { frontmatter?: { draft?: boolean } };
const rootPostModules = import.meta.glob<CatchAllPostModule>(
	"./posts/*.{md,mdx}",
	{ eager: true },
);
const rootPostEntries = Object.entries(rootPostModules).map(
	([filePath, mod]) => ({
		slug: parsePostSlugFromGlobPath(filePath),
		draft: mod?.frontmatter?.draft === true,
	}),
);

// Extract slug from params (may contain slashes because this is a rest parameter)
const { id: originalId } = Astro.params;
let id: string = originalId || "";
if ((originalId || "").replace(/\/+$/, "") === "ai") {
	const question = Astro.url.searchParams.get("q");
	const params = new URLSearchParams();
	params.set("mode", "ai");
	if (question?.trim()) params.set("q", question.trim());
	return Astro.redirect(`/search?${params.toString()}`);
}

// /ask/:slug and /shared-ask/:slug are dedicated routes (middleware rewrites the
// public URL). Never soft-404 them into discourse search.
if (
	originalId?.startsWith("ask/") ||
	originalId?.startsWith("shared-ask/")
) {
	const raw = originalId.replace(/^(?:shared-)?ask\//, "").replace(/\/+$/, "");
	if (raw && !raw.includes("/")) {
		return Astro.rewrite(`/shared-ask/${raw}`);
	}
	return Astro.redirect("/search?mode=ai");
}

// Non-prerendered /on/:slug variants miss the static /on/ page (unknown slugs,
// or spaced forms like /on/sun%20and%20shade). Canonicalize, stem-match, or
// send to search — never an empty 404 body (Chrome renders that as a broken host).
if (originalId?.startsWith("on/")) {
	const rawSlug = originalId.slice("on/".length);
	let decoded = rawSlug;
	try {
		decoded = decodeURIComponent(rawSlug);
	} catch {
		/* keep rawSlug */
	}
	const fallback = resolveOnSlugFallback(decoded);
	if (fallback.kind === "on") {
		const location = `/on/${fallback.slug}`;
		if (canonicalOnSlug(decoded) !== fallback.slug) {
			return Astro.redirect(location, 301);
		}
		return Astro.rewrite(location);
	}
	if (fallback.kind === "search") {
		return Astro.redirect(
			`/search?q=${encodeURIComponent(fallback.query)}`,
		);
	}
	return Astro.rewrite("/404");
}

// Support legacy / nested style paths like /iti/iti50-99 or /ud/ud8/ud8.2 by redirecting
// to the canonical top-level discourse slug (last segment) if it exists.
if (originalId && originalId.includes("/")) {
	const segments = originalId.split("/").filter(Boolean);
	if (segments.length > 1) {
		const candidate = segments[segments.length - 1];

		// Collect collection slugs (same logic as [collection].astro)
		const collectionSlugs: string[] = [];
		const walk = (map: Record<string, any>) => {
			for (const key of Object.keys(map)) {
				collectionSlugs.push(key);
				const child = map[key]?.children;
				if (child && typeof child === "object") walk(child);
			}
		};
		walk(directoryStructure);
		const isCollection = collectionSlugs.includes(candidate);
		const isDiscourse = routes.includes(candidate);

		if (isCollection || isDiscourse) {
			if (originalId !== candidate) {
				const location = `/${candidate}`;
				return new Response(null, {
					status: 301,
					headers: { Location: location },
				});
			}
		}
	}
}

// Filter out system/browser and asset-like requests early to avoid hijacking dev/build assets
const SYSTEM_REQUEST_PATTERNS = [
	".well-known",
	"favicon.ico",
	"robots.txt",
	"sitemap.xml",
	"apple-touch-icon",
	"chrome-extension",
	"__webpack",
	"_next",
	"@vite",
	"@fs",
];

const ASSET_EXT_REGEX =
	/\.(?:js|css|json|png|jpg|jpeg|svg|ico|gif|webp|avif|woff2?|ttf|otf|map|xml|webmanifest)$/i;

/** Real app pages. Never soft-404 these into /search?q=… if routing misses. */
const APP_TOP_LEVEL_SLUGS = new Set([
	"register",
	"signin",
	"profile",
	"review-room",
	"search",
	"discover",
	"offline",
	"privacy",
	"public-domain",
	"support",
	"success",
	"recent",
	"explorer",
	"dashboard",
	"admin",
]);

const isSystemRequest =
	!id ||
	SYSTEM_REQUEST_PATTERNS.some((pattern) => originalId?.includes(pattern)) ||
	// Typical asset requests by extension (including nested ones we did not redirect above)
	ASSET_EXT_REGEX.test(originalId ?? "");

if (isSystemRequest) {
	return new Response(null, { status: 404 });
}

if (id && !id.includes("/") && APP_TOP_LEVEL_SLUGS.has(id)) {
	return Astro.rewrite("/404");
}

// Bare quality/topic/simile/person slugs used to soft-404 into /search?q=…
// (e.g. /bad-friendship, /mluv-creeper). Send them to the canonical /on/ page
// unless an editorial post already claims the root slug (/mindfulness → post
// via [post].astro, /on/mindfulness → quality). Do not rewrite to /posts/:slug
// here — Astro omits `draft: true` page files, and prerender rewrite to
// /posts/:slug also fails under the Node/PWA adapter.
if (id && !id.includes("/")) {
	if (
		slugIsRootPost(id, rootPostEntries, {
			includeDrafts: true,
			discourseSlugs: routes,
		})
	) {
		return Astro.rewrite(new URL(`/editorial/${id}`, Astro.url));
	}
	const fallback = resolveOnSlugFallback(id);
	if (fallback.kind === "on") {
		// 302 + no-store: a 301 here is cached by browsers forever and
		// cannot later yield the URL to an editorial post (e.g. /mindfulness).
		return new Response(null, {
			status: 302,
			headers: {
				Location: `/on/${fallback.slug}`,
				"Cache-Control": "no-store",
			},
		});
	}
}

const result = await resolveCatchAllDiscoursePage(originalId, Astro.redirect);
if (result instanceof Response) return result;

const {
	suttaProps,
	mainContent,
	splitAvailable,
	refPaliOnlyContent,
	referenceFallbackPage,
	canonicalId,
} = result;
---

<Layout {...suttaProps} canonicalPath={`/${canonicalId}`}>
	<MDContent
		content={mainContent}
		splitAvailable={splitAvailable}
		refPaliOnlyContent={refPaliOnlyContent}
		referenceFallback={referenceFallbackPage}
	/>
</Layout>
