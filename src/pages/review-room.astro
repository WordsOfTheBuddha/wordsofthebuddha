---
export const prerender = false;
import { getEntry } from "astro:content";
import { db } from "../service/firebase/server";
import Layout from "../layouts/Layout.astro";
import EmailVerifyBanner from "../components/EmailVerifyBanner.astro";
import PostCard from "../components/PostCard.astro";
import "../styles/review-room.css";
import ClockSolid from "../assets/clock-solid.svg?raw";
import SaveSolid from "../assets/save-solid.svg?raw";
import HighlightIcon from "../assets/highlight.svg?raw";
import CheckSolid from "../assets/check.svg?raw";
import BeakerIcon from "../assets/beaker.svg?raw";
import OverviewIcon from "../assets/unified-view.svg?raw";
import ChevronDown from "../assets/chevron-down.svg?raw";
import type { Highlight } from "../types/notes";
import { transformId } from "../utils/transformId";
import { verifyUser } from "../middleware/auth";
import { loadUserAskHistory } from "../utils/aiAskHistoryServer";
import {
	askHistoryLaneEntries,
	formatAskRelativeTime,
	orderAskHistoryByRecent,
	pinnedAskHistoryEntries,
	type AiAskSessionEntry,
} from "../utils/aiAskSession";
import {
	openAskHistoryHref,
	openResearchHistoryHref,
	searchAskHref,
	searchResearchHref,
} from "../utils/aiAskHref";
import {
	ASK_HISTORY_ARIA,
	ASK_HISTORY_HINT_RECENT,
	ASK_HISTORY_LABEL,
	isAskResearchEnabled,
	researchHistoryStatsLabel,
	REVIEW_ROOM_ASK_EMPTY,
	REVIEW_ROOM_ASK_NEW_LABEL,
	REVIEW_ROOM_REPORT_EMPTY,
	REVIEW_ROOM_REPORT_NEW_LABEL,
} from "../utils/aiAskResearchUi";
import { getReferenceSujatoEntry } from "../utils/getContentEntry";
import {
	buildReadableCatalog,
	computeCanonCoverage,
	formatMinutesAgo,
	normalizeDiscourseSlug,
	oldestPending,
	type CanonCoverage,
} from "../utils/reviewRoomStats";
import {
	groupLearningDayStrip,
	learningDayDetailLabel,
	learningDayDotClassName,
	learningDaysFromReadMinutes,
	learningDaysStatKind,
	learningDaysStatUnit,
	mergeLearningDays,
	overviewLearningDayStrip,
	readsByDayFromReadMinutes,
	type LearningDayDot,
} from "../utils/learningActivity";
import {
	loadUserLearningActivity,
	mergeUserLearningActivity,
} from "../utils/learningActivityServer";
import { formatListenStat, type ListenStatDisplay } from "../utils/listenActivity";
import { loadUserListenActivity } from "../utils/listenActivityServer";

const PIN_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M16 12V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>`;

const sessionCookie = Astro.cookies.get("__session")?.value;
if (!sessionCookie) return Astro.redirect("/signin");

const user = await verifyUser(sessionCookie, { cookies: Astro.cookies }).catch(
	() => null
);

if (!user) {
	return Astro.redirect("/signin");
}

const userDisplayName = user.displayName || user.email || "there"; // Default display name

if (!db) {
	throw new Error("Firestore database is not initialized.");
}

let validHighlights: any[] = [];
let validReadLaterEntries: any[] = [];
let validSavedEntries: any[] = [];
let validReadEntries: any[] = [];
let askEntries: AiAskSessionEntry[] = [];
let askLaneEntries: AiAskSessionEntry[] = [];
let researchLaneEntries: AiAskSessionEntry[] = [];
let pinnedAskEntries: AiAskSessionEntry[] = [];
let pinnedResearchEntries: AiAskSessionEntry[] = [];
let showAskLanes = false;
let coverage: CanonCoverage = { rows: [], totalRead: 0, totalAvailable: 0 };
let learningDays = 0;
let learningDayStrip: LearningDayDot[] = [];
let listenTotalSeconds = 0;
let listenSecondsByDay: Record<string, number> = {};
let listenStat: ListenStatDisplay | null = null;
let readPagesMap: Record<string, number> = {};
let oldestReadLater: {
	slug: string;
	title: string;
	waiting: string;
} | null = null;

try {
	// Fetch highlights API, and the single 'pages' documents for readLater, saves, and read
	const [
		highlightsResponse,
		readLaterDoc,
		savedDoc,
		readDoc,
		askHistory,
		loadedLearningSummary,
		loadedListenSummary,
	] = await Promise.all([
		fetch(`${Astro.url.origin}/api/highlights/list`, {
			headers: {
				cookie: `__session=${Astro.cookies.get("__session")?.value || ""}`,
			},
		}),
		db
			.collection("users")
			.doc(user.uid)
			.collection("readLater")
			.doc("pages") // Fetch single doc
			.get(),
		db
			.collection("users")
			.doc(user.uid)
			.collection("saves")
			.doc("pages") // Fetch single doc
			.get(),
		db
			.collection("users")
			.doc(user.uid)
			.collection("read")
			.doc("pages")
			.get(),
		// One capped doc (max 20 entries).
		loadUserAskHistory(user).catch(() => [] as AiAskSessionEntry[]),
		// One summary doc for learning days.
		loadUserLearningActivity(user).catch(() => ({
			days: {} as Record<string, true>,
			dayCount: 0,
		})),
		// One summary doc for listen minutes.
		loadUserListenActivity(user).catch(() => ({
			bySlug: {} as Record<string, number>,
			secondsByDay: {} as Record<string, number>,
			totalSeconds: 0,
		})),
	]);
	let learningSummary = loadedLearningSummary;
	listenTotalSeconds = loadedListenSummary.totalSeconds;
	listenSecondsByDay = loadedListenSummary.secondsByDay || {};
	listenStat = formatListenStat(listenTotalSeconds);

	// Process highlights
	const { highlights: validHighlightsData } = await highlightsResponse.json();
	validHighlights = validHighlightsData;

	askEntries = orderAskHistoryByRecent(askHistory);
	askLaneEntries = askHistoryLaneEntries(askEntries, false);
	researchLaneEntries = askHistoryLaneEntries(askEntries, true);
	pinnedAskEntries = pinnedAskHistoryEntries(askLaneEntries);
	pinnedResearchEntries = pinnedAskHistoryEntries(researchLaneEntries);
	showAskLanes = isAskResearchEnabled() || researchLaneEntries.length > 0;

	// Progress through each collection — readable union (site + reference).
	readPagesMap = readDoc.exists ? readDoc.data()?.pages || {} : {};
	coverage = computeCanonCoverage(
		Object.keys(readPagesMap),
		buildReadableCatalog(),
	);

	// Backfill from mark-as-read + credit today (signed-in day counts as day 1).
	// Browser visit also reseeds with the reader's local timezone.
	const todayUtc = new Date().toISOString().slice(0, 10);
	const readDayBackfill = learningDaysFromReadMinutes(
		readPagesMap,
		(ms) => new Date(ms).toISOString().slice(0, 10),
	);
	const mergedLearningDays = mergeLearningDays(
		mergeLearningDays(learningSummary.days, readDayBackfill),
		{ [todayUtc]: true },
	);
	if (
		Object.keys(mergedLearningDays).length >
		Object.keys(learningSummary.days).length
	) {
		learningSummary = await mergeUserLearningActivity(
			user,
			mergedLearningDays,
		).catch(() => ({
			days: mergedLearningDays,
			dayCount: Object.keys(mergedLearningDays).length,
		}));
	}
	learningDays = learningSummary.dayCount;
	learningDayStrip = overviewLearningDayStrip(
		learningSummary.days,
		readsByDayFromReadMinutes(
			readPagesMap,
			(ms) => new Date(ms).toISOString().slice(0, 10),
		),
		listenSecondsByDay,
	);

	// Process readLater entries from the 'pages' document
	if (readLaterDoc.exists && readLaterDoc.data()?.pages) {
		const readLaterPages = readLaterDoc.data()?.pages || {};
		const readLaterSlugs = Object.keys(readLaterPages);

		const oldest = oldestPending(readLaterPages);
		if (oldest) {
			const slug = normalizeDiscourseSlug(oldest.slug);
			const entry =
				(await getEntry("all", slug).catch(() => null)) ||
				(await getReferenceSujatoEntry(slug).catch(() => null));
			if (entry) {
				oldestReadLater = {
					slug,
					title: entry.data.title || "",
					waiting: formatMinutesAgo(oldest.minutes),
				};
			} else {
				oldestReadLater = {
					slug,
					title: "",
					waiting: formatMinutesAgo(oldest.minutes),
				};
			}
		}

		const readLaterEntries = await Promise.all(
			readLaterSlugs.map(async (slug) => {
				try {
					const entry = await getEntry("all", slug);
					const timestampInMinutes = readLaterPages[slug];
					return entry
						? {
								...entry,
								addedAt: new Date(timestampInMinutes * 60000), // Convert minutes back to Date
								timestamp: timestampInMinutes, // Keep minutes for sorting
							}
						: null;
				} catch {
					return null;
				}
			})
		);
		validReadLaterEntries = readLaterEntries
			.filter(Boolean)
			.sort((a, b) => b.timestamp - a.timestamp); // Sort by timestamp (minutes)
	}

	// Process saved entries from the 'pages' document
	if (savedDoc.exists && savedDoc.data()?.pages) {
		const savedPages = savedDoc.data()?.pages || {};
		const savedSlugs = Object.keys(savedPages);

		const savedEntries = await Promise.all(
			savedSlugs.map(async (slug) => {
				try {
					const entry = await getEntry("all", slug);
					const timestampInMinutes = savedPages[slug];
					return entry
						? {
								...entry,
								savedAt: new Date(timestampInMinutes * 60000), // Convert minutes back to Date
								timestamp: timestampInMinutes, // Keep minutes for sorting
							}
						: null;
				} catch {
					return null;
				}
			})
		);
		validSavedEntries = savedEntries
			.filter(Boolean)
			.sort((a, b) => b.timestamp - a.timestamp); // Sort by timestamp (minutes)
	}

	// Process read entries
	if (readDoc.exists && readDoc.data()?.pages) {
		const readPages = readDoc.data()?.pages || {};
		const readSlugs = Object.keys(readPages);

		const readEntries = await Promise.all(
			readSlugs.map(async (slug) => {
				try {
					const entry = await getEntry("all", slug);
					const timestampInMinutes = readPages[slug];
					return entry
						? {
								...entry,
								readAt: new Date(timestampInMinutes * 60000), // Convert minutes back to milliseconds
								timestamp: timestampInMinutes, // Keep minutes for sorting
							}
						: null;
				} catch {
					return null;
				}
			})
		);

		validReadEntries = readEntries
			.filter(Boolean)
			.sort((a, b) => b.timestamp - a.timestamp); // Sort by timestamp (minutes)
	}
} catch (error) {
	console.error("Error fetching data concurrently:", error);
}
---

<Layout showAuth={true}>
	<div class="not-prose py-4 px-4 sm:px-6 lg:px-8">
		<div class="max-w-5xl mx-auto" id="dashboard-container">
			{
				!user.emailVerified && (
					<EmailVerifyBanner email={user.email} />
				)
			}
			<!-- Tabs: mobile keeps Overview + Asks; other sections sit in a menu -->
			<div class="py-2 mb-4">
				<div class="pills-scroll-container relative">
					<nav
						class="pills-scroll flex flex-wrap justify-center gap-2 sm:gap-3 py-1"
						aria-label="Tabs"
					>
						<a
							href="#overview"
							class="tab-pill flex-shrink-0 active"
							data-tab="overview"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={OverviewIcon} />
								Overview
							</span>
						</a>
						<a
							href="#asks"
							class="tab-pill flex-shrink-0"
							data-tab="asks"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={BeakerIcon} />
								Asks
							</span>
						</a>
						<a
							href="#readlater"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="readlater"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={ClockSolid} />
								Read Later
							</span>
						</a>
						<a
							href="#saves"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="saves"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={SaveSolid} />
								Saves
							</span>
						</a>
						<a
							href="#read"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="read"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={CheckSolid} />
								Read
							</span>
						</a>
						<a
							href="#highlights"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="highlights"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span
									class="w-4 h-4"
									set:html={HighlightIcon}
								/>
								Highlights
							</span>
						</a>
						<div class="more-menu md:hidden relative flex-shrink-0">
							<button
								type="button"
								id="more-menu-btn"
								class="tab-pill"
								aria-haspopup="menu"
								aria-expanded="false"
								aria-controls="more-menu"
								aria-label="More tabs"
							>
								<span
									id="more-menu-face"
									class="inline-flex items-center gap-1 text-sm"
								>
									<span
										id="more-menu-icon"
										class="w-4 h-4"
										set:html={ClockSolid}
									/>
									<span id="more-menu-label">Read Later</span>
								</span>
								<span
									id="more-menu-chevron"
									class="w-3.5 h-3.5 opacity-70"
									set:html={ChevronDown}
								/>
							</button>
							<div
								id="more-menu"
								class="more-menu-panel"
								role="menu"
								hidden
							>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="readlater"
									data-more-option
								>
									<span class="w-4 h-4" set:html={ClockSolid} />
									Read Later
								</button>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="saves"
									data-more-option
								>
									<span class="w-4 h-4" set:html={SaveSolid} />
									Saves
								</button>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="read"
									data-more-option
								>
									<span class="w-4 h-4" set:html={CheckSolid} />
									Read
								</button>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="highlights"
									data-more-option
								>
									<span class="w-4 h-4" set:html={HighlightIcon} />
									Highlights
								</button>
							</div>
						</div>
					</nav>
				</div>
			</div>

			<!-- Overview (default tab): greeting + reading stats -->
			<div id="overview" class="tab-content">
				<div
					id="greeting"
					class="text-xl sm:text-2xl font-light mt-6 mb-6 text-center text-gradient-accent"
				>
				</div>

				<section class="overview-stats" aria-label="Your reading">
					{
						(coverage.totalRead > 0 ||
							learningDays > 0 ||
							listenStat) && (
							<div
								class:list={[
									"overview-aggregates",
									{
										"is-single":
											(coverage.totalRead > 0 ? 1 : 0) +
												(learningDays > 0 ? 1 : 0) +
												(listenStat ? 1 : 0) ===
											1,
										"is-triple":
											(coverage.totalRead > 0 ? 1 : 0) +
												(learningDays > 0 ? 1 : 0) +
												(listenStat ? 1 : 0) >=
											3,
									},
								]}
							>
								{learningDays > 0 && (
									<div
										id="learning-days-tile"
										class="stat-tile"
									>
										<span class="stat-kind">
											{learningDaysStatKind()}
										</span>
										<span
											class="stat-value"
											id="learning-days-value"
											data-learning-days={learningDays}
										>
											{learningDays}
										</span>
										<span class="stat-unit">
											{learningDaysStatUnit()}
										</span>
									</div>
								)}
								{coverage.totalRead > 0 && (
									<div
										id="discourses-read-tile"
										class="stat-tile"
									>
										<span class="stat-kind">Read</span>
										<span
											class="stat-value"
											id="discourses-read-value"
											data-discourses-read={
												coverage.totalRead
											}
										>
											{coverage.totalRead}
										</span>
										<span class="stat-unit">
											discourses
										</span>
									</div>
								)}
								{listenStat && (
									<div
										id="listen-minutes-tile"
										class="stat-tile"
									>
										<span
											class="stat-kind"
											id="listen-minutes-kind"
										>
											{listenStat.kind}
										</span>
										<span
											class="stat-value"
											id="listen-minutes-value"
											data-listen-seconds={
												listenTotalSeconds
											}
										>
											{listenStat.value}
										</span>
										<span
											class="stat-unit"
											id="listen-minutes-unit"
											hidden={!listenStat.unit}
										>
											{listenStat.unit}
										</span>
									</div>
								)}
							</div>
						)
					}

					{
						learningDays > 0 && (
							<div
								id="learning-day-strip"
								class="learning-day-strip"
								aria-label="Days of learning"
							>
								<div class="learning-day-rows">
									{groupLearningDayStrip(learningDayStrip).map(
										(row) => (
											<div class="learning-day-row">
												{row.map((dot) => {
													const label =
														learningDayDetailLabel(
															dot,
														);
													const className =
														learningDayDotClassName(
															dot,
														);
													return label ? (
														<button
															type="button"
															class={className}
															data-day={dot.key}
															aria-label={label}
														/>
													) : (
														<span
															class={className}
															aria-hidden="true"
														/>
													);
												})}
											</div>
										),
									)}
								</div>
								<div
									class="learning-day-tip"
									role="tooltip"
									hidden
								/>
							</div>
						)
					}

					<div class="overview-card">
						<div class="overview-head">
							<h2>By collection</h2>
						</div>
						{
							coverage.rows.length > 0 ? (
								<ul class="coverage-list">
									{coverage.rows.map((row) => (
										<li>
											<a
												href={row.href}
												class="coverage-row"
												title={`${row.title}: ${row.read} of ${row.total} readable`}
											>
												<span class="coverage-id">
													<span class="coverage-label">
														{row.label}
													</span>
													<span class="coverage-name">
														{row.title}
													</span>
												</span>
												<span class="coverage-bar">
													<span
														class="coverage-fill"
														style={`width:${row.percent}%`}
													/>
												</span>
												<span class="coverage-count">
													<span class="coverage-read">
														{row.read}
													</span>
													<span class="coverage-total">
														/ {row.total}
													</span>
												</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<p class="overview-empty overview-empty-in-card">
									Mark discourses as read and your progress through
									each collection will appear here.
								</p>
							)
						}
					</div>
					{
						validReadLaterEntries.length > 0 && (
							<div class="overview-later">
								<p class="overview-line">
									<a href="#readlater" data-tab-link="readlater">
										{validReadLaterEntries.length === 1
											? "1 discourse waiting in Read Later"
											: `${validReadLaterEntries.length} discourses waiting in Read Later`}
									</a>
								</p>
								{oldestReadLater && (
									<p class="overview-line">
										Longest waiting:{" "}
										<a href={`/${oldestReadLater.slug}`}>
											{transformId(oldestReadLater.slug)}
											{oldestReadLater.title
												? ` ${oldestReadLater.title}`
												: ""}
										</a>
										{oldestReadLater.waiting
											? `, added ${oldestReadLater.waiting}.`
											: "."}
									</p>
								)}
							</div>
						)
					}
				</section>
			</div>

			<!-- Tab Content Area -->
			<div id="tab-content-area" class="px-2">
				<div id="asks" class="tab-content hidden">
					<div
						class="mt-4 ask-panel"
						data-ask-history
						data-ask-count-ask={askLaneEntries.length}
						data-ask-count-research={researchLaneEntries.length}
						data-ask-pinned-ask={pinnedAskEntries.length}
						data-ask-pinned-research={pinnedResearchEntries.length}
					>
						<div class="ask-panel-chrome">
							{
								showAskLanes && (
									<div class="ask-panel-lanes">
										<div
											class="ask-history-tabs ask-lane-tabs"
											role="tablist"
											aria-label="Ask and Research history"
										>
											<button
												type="button"
												class="ask-history-tab"
												role="tab"
												aria-selected="true"
												data-ask-history-lane="ask"
											>
												Asks
												{askLaneEntries.length > 0 && (
													<span class="ask-history-tab-count">
														{askLaneEntries.length}
													</span>
												)}
											</button>
											<button
												type="button"
												class="ask-history-tab"
												role="tab"
												aria-selected="false"
												data-ask-history-lane="research"
											>
												Research
												{researchLaneEntries.length > 0 && (
													<span class="ask-history-tab-count">
														{researchLaneEntries.length}
													</span>
												)}
											</button>
										</div>
									</div>
								)
							}
							<div class="ask-panel-bar">
								<a
									href={searchAskHref()}
									class="ask-new-btn"
									data-ask-new
									data-ask-new-ask={searchAskHref()}
									data-ask-new-research={searchResearchHref()}
									data-ask-new-ask-label={
										REVIEW_ROOM_ASK_NEW_LABEL
									}
									data-ask-new-research-label={
										REVIEW_ROOM_REPORT_NEW_LABEL
									}
								>
									{REVIEW_ROOM_ASK_NEW_LABEL}
								</a>
								<div
									class="ask-panel-meta"
									data-ask-history-meta
									hidden={askLaneEntries.length === 0}
								>
									<div
										class="ask-history-tabs"
										role="tablist"
										aria-label={ASK_HISTORY_ARIA}
										data-ask-pin-tabs
										hidden={pinnedAskEntries.length === 0}
									>
										<button
											type="button"
											class="ask-history-tab"
											role="tab"
											aria-selected="true"
											data-ask-history-tab="recent"
										>
											Recent
										</button>
										<button
											type="button"
											class="ask-history-tab"
											role="tab"
											aria-selected="false"
											data-ask-history-tab="pinned"
										>
											Pinned
											<span
												class="ask-history-tab-count"
												data-ask-pin-count
											>
												{pinnedAskEntries.length}
											</span>
										</button>
									</div>
									<p
										class="ask-history-label"
										data-ask-history-label
										hidden={pinnedAskEntries.length > 0}
									>
										{ASK_HISTORY_LABEL}
									</p>
									<p
										class="ask-history-hint"
										data-ask-history-hint
									>
										{ASK_HISTORY_HINT_RECENT}
									</p>
								</div>
							</div>
						</div>
						<p
							class="ask-empty"
							data-ask-empty="ask"
							hidden={askLaneEntries.length > 0}
						>
							{REVIEW_ROOM_ASK_EMPTY}
						</p>
						{
							showAskLanes && (
								<p
									class="ask-empty"
									data-ask-empty="research"
									hidden
								>
									{REVIEW_ROOM_REPORT_EMPTY}
								</p>
							)
						}
						{
							askLaneEntries.length > 0 && (
								<div
									class="ask-history-list"
									data-ask-lane-list="ask"
								>
									{askLaneEntries.map((entry) => (
										<a
											href={openAskHistoryHref(
												entry.question,
											)}
											class:list={[
												"ask-row",
												{ "is-pinned": entry.saved },
											]}
											data-ask-lane="ask"
											data-ask-pinned={
												entry.saved ? "1" : "0"
											}
										>
											<div class="ask-row-head">
												<p class="ask-row-q">
													{entry.question}
												</p>
												<span class="ask-row-meta">
													{entry.saved && (
														<span
															class="ask-row-pin"
															title="Pinned"
															aria-label="Pinned"
															set:html={
																PIN_ICON_SVG
															}
														/>
													)}
													<span class="ask-row-when">
														{formatAskRelativeTime(
															entry.at,
														)}
													</span>
												</span>
											</div>
											{entry.summary && (
												<p class="ask-row-summary">
													{entry.summary}
												</p>
											)}
											<p class="ask-row-results">
												{entry.results
													.slice(0, 6)
													.map((hit) =>
														transformId(hit.slug),
													)
													.join(" · ")}
											</p>
										</a>
									))}
								</div>
							)
						}
						{
							showAskLanes &&
								researchLaneEntries.length > 0 && (
									<div
										class="ask-history-list"
										data-ask-lane-list="research"
										hidden
									>
										{researchLaneEntries.map((entry) => {
											const stats =
												researchHistoryStatsLabel(
													entry.report,
													entry.results,
												);
											const status =
												entry.researchPending
													? "Researching…"
													: entry.researchUnread
														? "Research ready"
														: "";
											return (
												<a
													href={openResearchHistoryHref(
														entry.question,
													)}
													class:list={[
														"ask-row",
														"is-report",
														{
															"is-pinned":
																entry.saved,
															"is-unread":
																entry.researchUnread,
															"is-pending":
																entry.researchPending,
														},
													]}
													data-ask-lane="research"
													data-ask-pinned={
														entry.saved ? "1" : "0"
													}
												>
													<div class="ask-row-head">
														<p class="ask-row-q">
															{entry.question}
														</p>
														<span class="ask-row-meta">
															{entry.researchUnread && (
																<span
																	class="ask-row-unread"
																	title="Unread"
																	aria-label="Unread"
																/>
															)}
															{entry.saved && (
																<span
																	class="ask-row-pin"
																	title="Pinned"
																	aria-label="Pinned"
																	set:html={
																		PIN_ICON_SVG
																	}
																/>
															)}
															<span class="ask-row-when">
																{formatAskRelativeTime(
																	entry.at,
																)}
															</span>
														</span>
													</div>
													{status && (
														<p
															class:list={[
																"ask-row-status",
																{
																	"is-pending":
																		entry.researchPending,
																	"is-ready":
																		entry.researchUnread,
																},
															]}
														>
															{status}
														</p>
													)}
													{stats && (
														<p class="ask-row-results">
															{stats}
														</p>
													)}
												</a>
											);
										})}
									</div>
								)
						}
					</div>
				</div>

				<div id="highlights" class="tab-content hidden">
					<div class="mt-4 space-y-4">
						{
							validHighlights.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>No highlights found.</p>
								</div>
							) : (
								validHighlights.map((highlight: Highlight) => (
									<div class="highlight-page">
										<div class="flex items-start">
											<div class="min-w-0 pr-4">
												<h2 class="text-base sm:text-lg font-semibold mb-2">
													<a
														href={highlight.slug}
														class="text-gray-500 hover:text-link-color"
													>
														{transformId(
															highlight.slug
																?.replace(
																	/^\//,
																	""
																)
																.split(
																	"?"
																)[0] || ""
														)}
														{highlight.title}
													</a>
												</h2>
												{highlight.description && (
													<p class="text-text line-clamp-2 text-sm">
														{highlight.description}
													</p>
												)}
											</div>
										</div>
										<div class="highlight-content">
											{Object.values(
												highlight.highlightSegments
											)
												.sort(
													(a, b) => a.order - b.order
												)
												.map((segment) => {
													// Remove style attribute from p elements, handling any style content
													const cleanedHTML =
														segment.containerHTML?.replace(
															/<p([^>]*?)style="[^"]*"([^>]*?)>/g,
															"<p$1$2>"
														);
													return (
														<Fragment
															set:html={
																cleanedHTML
															}
														/>
													);
												})}
										</div>
										<p class="text-gray-500 text-xs my-0 text-right">
											Highlighted on{" "}
											{highlight.formattedDate}
										</p>
									</div>
								))
							)
						}
					</div>
				</div>

				<div id="readlater" class="tab-content hidden">
					<div class="mt-4">
						{
							validReadLaterEntries.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>
										No discourses added for later reading.
									</p>
								</div>
							) : (
								<div class="space-y-4">
									{validReadLaterEntries.map((entry) => (
										<PostCard
											id={entry.data.slug}
											title={entry.data.title}
											description={entry.data.description}
											lastUpdated={entry.addedAt}
											dateLabel="Added on"
										/>
									))}
								</div>
							)
						}
					</div>
				</div>

				<div id="saves" class="tab-content hidden">
					<div class="mt-4">
						{
							validSavedEntries.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>No discourses saved yet.</p>
								</div>
							) : (
								<div class="space-y-4">
									{validSavedEntries.map((entry) => (
										<PostCard
											id={entry.data.slug}
											title={entry.data.title}
											description={entry.data.description}
											lastUpdated={entry.savedAt}
											dateLabel="Saved on"
										/>
									))}
								</div>
							)
						}
					</div>
				</div>

				<div id="read" class="tab-content hidden">
					<div class="mt-4">
						{
							validReadEntries.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>No read discourses yet.</p>
								</div>
							) : (
								<div class="space-y-4">
									{validReadEntries.map((entry) => (
										<PostCard
											id={entry.data.slug}
											title={entry.data.title}
											description={entry.data.description}
											lastUpdated={entry.readAt}
											dateLabel="Read on"
										/>
									))}
								</div>
							)
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script
	type="application/json"
	id="review-room-data"
	set:html={JSON.stringify({
		userDisplayName,
		readPagesMap,
		listenTotalSeconds,
		listenSecondsByDay,
		askCount: askEntries.length,
		askKeys: askEntries.map((entry) =>
			entry.question.replace(/\s+/g, " ").trim().toLowerCase(),
		),
	}).replace(/</g, "\\u003c")}
/>

<script>
	import { syncLearningDaysFromReadPages } from "../utils/learningActivityClient";
	import {
		groupLearningDayStrip,
		learningDayDetailLabel,
		learningDayDotClassName,
		learningDaysStatKind,
		learningDaysStatUnit,
		overviewLearningDayStrip,
		readsByDayFromReadMinutes,
		type LearningDayDot,
	} from "../utils/learningActivity";
	import {
		formatListenStat,
		mergeListenSecondsByDay,
	} from "../utils/listenActivity";
	import {
		flushListenActivity,
		flushOfflineReadPages,
		readListenActivityBuffer,
	} from "../utils/listenActivityClient";
	import {
		normalizeAskQuestionKey,
		readAiAskSession,
		sanitizeAskHistoryEntries,
		writeAiAskSession,
	} from "../utils/aiAskSession";
	import {
		reviewRoomAsksHashId,
		reviewRoomHistoryLaneFromHash,
	} from "../utils/aiAskHref";
	import {
		reviewRoomAskHistoryView,
		reviewRoomHistoryRowHidden,
	} from "../utils/reviewRoomAskHistory";

	const DEFAULT_TAB = "overview";
	/** Tabs that collapse into the mobile More menu. */
	const MORE_TABS = new Set(["readlater", "saves", "read", "highlights"]);
	const DEFAULT_MORE_TAB = "readlater";
	const MORE_LABELS = {
		readlater: "Read Later",
		saves: "Saves",
		read: "Read",
		highlights: "Highlights",
	};
	const ASK_SYNC_FLAG = "review-room-ask-history-synced";
	let latestLearningDays: Record<string, true> | null = null;

	function escapeAttr(value: string): string {
		return value
			.replace(/&/g, "&amp;")
			.replace(/"/g, "&quot;")
			.replace(/</g, "&lt;");
	}

	function currentListenSecondsByDay(): Record<string, number> {
		return mergeListenSecondsByDay(
			boot.listenSecondsByDay,
			readListenActivityBuffer().secondsByDay,
		);
	}

	function currentReadsByDay(): Record<string, number> {
		return readsByDayFromReadMinutes(boot.readPagesMap);
	}

	function learningDotMarkup(dot: LearningDayDot): string {
		const className = learningDayDotClassName(dot);
		const label = learningDayDetailLabel(dot);
		if (!label) {
			return `<span class="${className}" aria-hidden="true"></span>`;
		}
		return `<button type="button" class="${className}" data-day="${escapeAttr(dot.key)}" aria-label="${escapeAttr(label)}"></button>`;
	}

	function placeOverviewNode(
		section: Element,
		node: HTMLElement,
		kind: "aggregates" | "strip",
	): void {
		const card = section.querySelector(".overview-card");
		if (kind === "aggregates") {
			const strip = document.getElementById("learning-day-strip");
			const before = strip || card;
			if (before) section.insertBefore(node, before);
			else section.prepend(node);
			return;
		}
		if (card) section.insertBefore(node, card);
		else section.appendChild(node);
	}

	function bindLearningDayStrip(container: HTMLElement): void {
		if (container.dataset.bound === "1") return;
		container.dataset.bound = "1";
		let sticky = false;

		const tip = (): HTMLElement | null =>
			container.querySelector(".learning-day-tip");

		const hideTip = () => {
			const el = tip();
			if (!el) return;
			el.hidden = true;
			el.textContent = "";
			delete el.dataset.day;
		};

		const showTipFor = (cell: HTMLElement) => {
			const el = tip();
			const label = cell.getAttribute("aria-label");
			if (!el || !label) return;
			el.textContent = label;
			el.hidden = false;
			el.dataset.day = cell.dataset.day || "";
			const stripRect = container.getBoundingClientRect();
			const cellRect = cell.getBoundingClientRect();
			const desired =
				cellRect.left - stripRect.left + cellRect.width / 2;
			const tipWidth = el.offsetWidth || 160;
			const min = tipWidth / 2 + 8;
			const max = Math.max(min, stripRect.width - tipWidth / 2 - 8);
			el.style.left = `${Math.min(max, Math.max(min, desired))}px`;
			const showBelow = cellRect.top < el.offsetHeight + 12;
			el.classList.toggle("is-below", showBelow);
			el.style.top = showBelow
				? `${cellRect.bottom - stripRect.top}px`
				: `${cellRect.top - stripRect.top}px`;
		};

		container.addEventListener("pointerover", (event) => {
			if (event.pointerType === "touch") return;
			const cell = (event.target as HTMLElement | null)?.closest?.(
				"button.learning-day-dot",
			);
			if (cell instanceof HTMLElement && container.contains(cell)) {
				showTipFor(cell);
			}
		});
		container.addEventListener("pointerout", (event) => {
			if (event.pointerType === "touch" || sticky) return;
			const next = event.relatedTarget as Node | null;
			if (next && container.contains(next)) {
				const stillOnCell =
					next instanceof Element &&
					next.closest("button.learning-day-dot");
				if (stillOnCell) return;
			}
			hideTip();
		});
		container.addEventListener("click", (event) => {
			const cell = (event.target as HTMLElement | null)?.closest?.(
				"button.learning-day-dot",
			);
			if (!(cell instanceof HTMLElement) || !container.contains(cell)) {
				sticky = false;
				hideTip();
				return;
			}
			const el = tip();
			if (el && !el.hidden && el.dataset.day === cell.dataset.day) {
				sticky = false;
				hideTip();
				return;
			}
			sticky = true;
			showTipFor(cell);
		});
		container.addEventListener("focusin", (event) => {
			const cell = (event.target as HTMLElement | null)?.closest?.(
				"button.learning-day-dot",
			);
			if (cell instanceof HTMLElement) showTipFor(cell);
		});
		container.addEventListener("focusout", () => {
			if (!sticky) hideTip();
		});
		document.addEventListener("click", (event) => {
			if (!container.contains(event.target as Node)) {
				sticky = false;
				hideTip();
			}
		});
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			sticky = false;
			hideTip();
		});
	}

	function ensureLearningDayStrip(): HTMLElement | null {
		const existing = document.getElementById("learning-day-strip");
		if (existing) {
			bindLearningDayStrip(existing);
			return existing;
		}
		const section = document.querySelector(".overview-stats");
		if (!section) return null;
		const wrap = document.createElement("div");
		wrap.id = "learning-day-strip";
		wrap.className = "learning-day-strip";
		wrap.setAttribute("aria-label", "Days of learning");
		wrap.innerHTML = `<div class="learning-day-rows"></div><div class="learning-day-tip" role="tooltip" hidden></div>`;
		placeOverviewNode(section, wrap, "strip");
		bindLearningDayStrip(wrap);
		return wrap;
	}

	function renderLearningDayStrip(
		days: Record<string, true> | null | undefined,
	): void {
		if (days) latestLearningDays = days;
		const useDays = days || latestLearningDays;
		if (!useDays) return;
		const container = ensureLearningDayStrip();
		if (!container) return;
		const rows = container.querySelector(".learning-day-rows");
		if (!rows) return;
		const strip = overviewLearningDayStrip(
			useDays,
			currentReadsByDay(),
			currentListenSecondsByDay(),
		);
		rows.innerHTML = groupLearningDayStrip(strip)
			.map(
				(row) =>
					`<div class="learning-day-row">${row
						.map((dot) => learningDotMarkup(dot))
						.join("")}</div>`,
			)
			.join("");
	}

	const rawData = document.getElementById("review-room-data")?.textContent;
	let boot: {
		userDisplayName: string;
		readPagesMap: Record<string, unknown>;
		listenTotalSeconds: number;
		listenSecondsByDay: Record<string, number>;
		askCount: number;
		askKeys: string[];
	} = {
		userDisplayName: "there",
		readPagesMap: {},
		listenTotalSeconds: 0,
		listenSecondsByDay: {},
		askCount: 0,
		askKeys: [],
	};
	try {
		if (rawData) {
			boot = {
				askCount: 0,
				askKeys: [],
				listenTotalSeconds: 0,
				listenSecondsByDay: {},
				...JSON.parse(rawData),
			};
		}
	} catch {
		/* keep defaults */
	}

	const ssrStrip = document.getElementById("learning-day-strip");
	if (ssrStrip) bindLearningDayStrip(ssrStrip);

	function syncOverviewAggregateLayout(): void {
		const aggregates = document.querySelector(".overview-aggregates");
		if (!aggregates) return;
		const count = aggregates.querySelectorAll(".stat-tile").length;
		aggregates.classList.toggle("is-single", count === 1);
		aggregates.classList.toggle("is-triple", count >= 3);
	}

	function listenStatMarkup(
		totalSeconds: number,
		display: { kind: string; value: string; unit: string },
	): string {
		const unitHidden = display.unit ? "" : " hidden";
		return `<span class="stat-kind" id="listen-minutes-kind">${display.kind}</span><span class="stat-value" id="listen-minutes-value" data-listen-seconds="${totalSeconds}">${display.value}</span><span class="stat-unit" id="listen-minutes-unit"${unitHidden}>${display.unit}</span>`;
	}

	function learningDaysStatMarkup(dayCount: number): string {
		return `<span class="stat-kind">${learningDaysStatKind()}</span><span class="stat-value" id="learning-days-value" data-learning-days="${dayCount}">${dayCount}</span><span class="stat-unit">${learningDaysStatUnit()}</span>`;
	}

	function renderListenStatTile(totalSeconds: number): void {
		const display = formatListenStat(totalSeconds);
		if (!display) return;
		const valueEl = document.getElementById("listen-minutes-value");
		const kindEl = document.getElementById("listen-minutes-kind");
		const unitEl = document.getElementById("listen-minutes-unit");
		if (valueEl && kindEl && unitEl) {
			valueEl.textContent = display.value;
			valueEl.dataset.listenSeconds = String(totalSeconds);
			kindEl.textContent = display.kind;
			unitEl.textContent = display.unit;
			unitEl.hidden = !display.unit;
			syncOverviewAggregateLayout();
			return;
		}
		const section = document.querySelector(".overview-stats");
		if (!section) return;
		let aggregates = section.querySelector(".overview-aggregates");
		if (!aggregates) {
			aggregates = document.createElement("div");
			aggregates.className = "overview-aggregates";
			placeOverviewNode(section, aggregates as HTMLElement, "aggregates");
		}
		const tile = document.createElement("div");
		tile.id = "listen-minutes-tile";
		tile.className = "stat-tile";
		tile.innerHTML = listenStatMarkup(totalSeconds, display);
		aggregates.appendChild(tile);
		syncOverviewAggregateLayout();
	}

	// Merge anonymous / offline listen minutes + any listen-completed reads.
	void Promise.all([flushListenActivity(), flushOfflineReadPages()]).then(
		([result]) => {
			const seconds = Math.max(
				boot.listenTotalSeconds || 0,
				result?.totalSeconds || 0,
			);
			renderListenStatTile(seconds);
			if (latestLearningDays || document.getElementById("learning-day-strip")) {
				renderLearningDayStrip(latestLearningDays);
			}
		},
	);

	// Backfill from mark-as-read timestamps in the reader's local timezone,
	// then merge any anonymous / offline learning days into the account.
	void syncLearningDaysFromReadPages(boot.readPagesMap).then((result) => {
		if (!result?.signedIn || result.dayCount <= 0) return;
		const valueEl = document.getElementById("learning-days-value");
		if (valueEl) {
			valueEl.textContent = String(result.dayCount);
			valueEl.dataset.learningDays = String(result.dayCount);
			renderLearningDayStrip(result.days);
			return;
		}
		// First paint had 0 days — insert the days tile now that sign-in day counted.
		const section = document.querySelector(".overview-stats");
		if (!section) return;
		let aggregates = section.querySelector(".overview-aggregates");
		if (!aggregates) {
			aggregates = document.createElement("div");
			aggregates.className = "overview-aggregates is-single";
			placeOverviewNode(section, aggregates as HTMLElement, "aggregates");
		}
		const tile = document.createElement("div");
		tile.id = "learning-days-tile";
		tile.className = "stat-tile";
		tile.innerHTML = learningDaysStatMarkup(result.dayCount);
		// Days reading leads; insert before discourses read / listen when present.
		const readTile = document.getElementById("discourses-read-tile");
		const listenTile = document.getElementById("listen-minutes-tile");
		if (readTile) aggregates.insertBefore(tile, readTile);
		else if (listenTile) aggregates.insertBefore(tile, listenTile);
		else aggregates.appendChild(tile);
		renderLearningDayStrip(result.days);
		syncOverviewAggregateLayout();
	});

	// Ask history lives in localStorage and Firestore. Review Room only SSR-reads
	// Firestore, so merge local Asks into the account when the tab looks empty
	// or behind (common after a quick ask, or switching Gmail-dot accounts).
	void (async () => {
		try {
			if (sessionStorage.getItem(ASK_SYNC_FLAG) === "1") return;
			const local = readAiAskSession();
			if (local.length === 0) return;
			const response = await fetch("/api/ai/history", {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ action: "sync", entries: local }),
			});
			const data = (await response.json()) as {
				success?: boolean;
				entries?: unknown[];
			};
			if (!response.ok || !data.success || !Array.isArray(data.entries)) {
				return;
			}
			const merged = sanitizeAskHistoryEntries(data.entries);
			writeAiAskSession(merged);
			sessionStorage.setItem(ASK_SYNC_FLAG, "1");
			const known = new Set(boot.askKeys);
			const missingOnPage = merged.some(
				(entry) => !known.has(normalizeAskQuestionKey(entry.question)),
			);
			if (missingOnPage || merged.length !== boot.askCount) {
				window.location.reload();
			}
		} catch {
			/* keep SSR asks */
		}
	})();

	const greetingEl = document.getElementById("greeting");
	if (greetingEl) {
		const hour = new Date().getHours();
		let timeOfDayGreeting;
		if (hour >= 5 && hour < 12) {
			timeOfDayGreeting = "Good morning";
		} else if (hour >= 12 && hour < 18) {
			timeOfDayGreeting = "Good afternoon";
		} else {
			timeOfDayGreeting = "Good evening";
		}
		greetingEl.textContent = `${timeOfDayGreeting}, ${boot.userDisplayName || "there"}.`;
	}

	const tabLinks = document.querySelectorAll(".tab-pill[data-tab]");
	const tabContents = document.querySelectorAll(".tab-content");
	const moreMenuBtn = document.getElementById("more-menu-btn");
	const moreMenu = document.getElementById("more-menu");
	const moreMenuLabel = document.getElementById("more-menu-label");
	const moreMenuIcon = document.getElementById("more-menu-icon");
	const moreOptions = document.querySelectorAll("[data-more-option]");
	const moreIconHtml = {
		readlater: "",
		saves: "",
		read: "",
		highlights: "",
	};
	moreOptions.forEach((option) => {
		const tabId = option.getAttribute("data-tab");
		const icon = option.querySelector(".w-4");
		if (tabId && icon && tabId in moreIconHtml) {
			moreIconHtml[tabId] = icon.innerHTML;
		}
	});

	function closeMoreMenu() {
		if (!moreMenu || !moreMenuBtn) return;
		moreMenu.hidden = true;
		moreMenuBtn.setAttribute("aria-expanded", "false");
	}

	function openMoreMenu() {
		if (!moreMenu || !moreMenuBtn) return;
		moreMenu.hidden = false;
		moreMenuBtn.setAttribute("aria-expanded", "true");
	}

	function syncMoreMenu(activeTabId) {
		const isMore = MORE_TABS.has(activeTabId);
		const faceTab = isMore ? activeTabId : DEFAULT_MORE_TAB;
		moreMenuBtn?.classList.toggle("active", isMore);
		if (moreMenuLabel) {
			moreMenuLabel.textContent =
				MORE_LABELS[faceTab] || MORE_LABELS[DEFAULT_MORE_TAB];
		}
		if (moreMenuIcon && moreIconHtml[faceTab]) {
			moreMenuIcon.innerHTML = moreIconHtml[faceTab];
		}
		moreOptions.forEach((option) => {
			option.classList.toggle(
				"active",
				option.getAttribute("data-tab") === activeTabId,
			);
		});
	}

	let askLaneIsResearch = false;
	/** Set by bindAskHistoryPanel — no-op until the Asks chrome exists. */
	let showAskHistoryLane = (_lane, _options) => {};

	function asksTabHashId() {
		return reviewRoomAsksHashId(askLaneIsResearch);
	}

	function showTabContent(tabId) {
		const nextTab = tabId && document.getElementById(tabId) ? tabId : DEFAULT_TAB;
		const targetContent = document.getElementById(nextTab);
		const targetLink = document.querySelector(
			`.tab-pill[data-tab="${nextTab}"]`,
		);
		if (!targetContent || !targetLink) return;

		tabContents.forEach((content) => content.classList.add("hidden"));
		tabLinks.forEach((link) => link.classList.remove("active"));
		targetContent.classList.remove("hidden");
		targetLink.classList.add("active");
		syncMoreMenu(nextTab);
		closeMoreMenu();

		const hashId = nextTab === "asks" ? asksTabHashId() : nextTab;
		const url =
			nextTab === DEFAULT_TAB
				? window.location.pathname + window.location.search
				: `#${hashId}`;
		history.replaceState(null, "", url);
	}

	tabLinks.forEach((link) => {
		link.addEventListener("click", (e) => {
			e.preventDefault();
			const tabId = link.getAttribute("data-tab");
			if (link.classList.contains("active")) {
				// Already here — Overview is the way home; no toggle-off.
				closeMoreMenu();
				return;
			}
			showTabContent(tabId);
		});
	});

	moreMenuBtn?.addEventListener("click", (e) => {
		e.preventDefault();
		e.stopPropagation();
		if (!moreMenu) return;
		if (moreMenu.hidden) openMoreMenu();
		else closeMoreMenu();
	});

	moreOptions.forEach((option) => {
		option.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();
			const tabId = option.getAttribute("data-tab");
			const pill = document.querySelector(`.tab-pill[data-tab="${tabId}"]`);
			if (pill?.classList.contains("active")) {
				closeMoreMenu();
				return;
			}
			showTabContent(tabId);
		});
	});

	document.addEventListener("click", (e) => {
		const menuRoot = document.querySelector(".more-menu");
		if (!menuRoot || !(e.target instanceof Node)) return;
		if (!menuRoot.contains(e.target)) closeMoreMenu();
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") closeMoreMenu();
	});

	document.querySelectorAll("[data-tab-link]").forEach((link) => {
		link.addEventListener("click", (e) => {
			e.preventDefault();
			showTabContent(link.getAttribute("data-tab-link"));
		});
	});

	function bindAskHistoryPanel() {
		const panel = document.querySelector("[data-ask-history]");
		if (!panel) return;
		const laneTabs = [
			...panel.querySelectorAll("[data-ask-history-lane]"),
		];
		const pinTabs = [...panel.querySelectorAll("[data-ask-history-tab]")];
		const newBtn = panel.querySelector("[data-ask-new]");
		const meta = panel.querySelector("[data-ask-history-meta]");
		const hint = panel.querySelector("[data-ask-history-hint]");
		const label = panel.querySelector("[data-ask-history-label]");
		const pinTablist = panel.querySelector("[data-ask-pin-tabs]");
		const pinCountEl = panel.querySelector("[data-ask-pin-count]");
		const counts = {
			ask: Number(panel.getAttribute("data-ask-count-ask") || "0"),
			research: Number(panel.getAttribute("data-ask-count-research") || "0"),
			pinnedAsk: Number(panel.getAttribute("data-ask-pinned-ask") || "0"),
			pinnedResearch: Number(
				panel.getAttribute("data-ask-pinned-research") || "0",
			),
		};
		const pinTabByLane = { ask: "recent", research: "recent" };

		function currentView() {
			const lane = askLaneIsResearch ? "research" : "ask";
			return reviewRoomAskHistoryView(lane, pinTabByLane[lane], counts);
		}

		function applyPinFilter() {
			const view = currentView();
			pinTabByLane[view.lane] = view.pinTab;
			pinTabs.forEach((button) => {
				button.setAttribute(
					"aria-selected",
					button.getAttribute("data-ask-history-tab") === view.pinTab
						? "true"
						: "false",
				);
			});
			panel.querySelectorAll(".ask-row").forEach((row) => {
				row.hidden = reviewRoomHistoryRowHidden(
					row.getAttribute("data-ask-lane"),
					row.getAttribute("data-ask-pinned") === "1",
					view.lane,
					view.pinTab,
				);
			});
			if (hint) hint.textContent = view.hint;
		}

		showAskHistoryLane = (lane, options) => {
			if (lane !== "ask" && lane !== "research") return;
			if (laneTabs.length === 0 && lane === "research") return;
			askLaneIsResearch = lane === "research";
			const view = currentView();
			laneTabs.forEach((button) => {
				button.setAttribute(
					"aria-selected",
					button.getAttribute("data-ask-history-lane") === lane
						? "true"
						: "false",
				);
			});
			panel.querySelectorAll("[data-ask-lane-list]").forEach((list) => {
				list.hidden =
					list.getAttribute("data-ask-lane-list") !== lane;
			});
			panel.querySelectorAll("[data-ask-empty]").forEach((empty) => {
				empty.hidden =
					empty.getAttribute("data-ask-empty") !== view.empty;
			});
			if (newBtn instanceof HTMLAnchorElement) {
				const href = askLaneIsResearch
					? newBtn.getAttribute("data-ask-new-research")
					: newBtn.getAttribute("data-ask-new-ask");
				const text = askLaneIsResearch
					? newBtn.getAttribute("data-ask-new-research-label")
					: newBtn.getAttribute("data-ask-new-ask-label");
				if (href) newBtn.setAttribute("href", href);
				if (text) newBtn.textContent = text;
			}
			if (meta) meta.hidden = !view.showMeta;
			if (pinTablist) {
				pinTablist.hidden = !view.showPinTabs;
				pinTablist.setAttribute("aria-label", view.pinAria);
			}
			if (label) {
				label.hidden = !view.showLabel;
				label.textContent = view.label;
			}
			if (pinCountEl) {
				pinCountEl.textContent = String(
					askLaneIsResearch
						? counts.pinnedResearch
						: counts.pinnedAsk,
				);
			}
			applyPinFilter();
			if (!options?.skipHash) {
				const asksEl = document.getElementById("asks");
				if (asksEl && !asksEl.classList.contains("hidden")) {
					history.replaceState(null, "", `#${view.hashId}`);
				}
			}
		};

		laneTabs.forEach((button) => {
			button.addEventListener("click", () => {
				showAskHistoryLane(
					button.getAttribute("data-ask-history-lane"),
				);
			});
		});
		pinTabs.forEach((button) => {
			button.addEventListener("click", () => {
				const tab = button.getAttribute("data-ask-history-tab");
				if (tab !== "recent" && tab !== "pinned") return;
				pinTabByLane[askLaneIsResearch ? "research" : "ask"] = tab;
				applyPinFilter();
			});
		});
	}

	function handleInitialLoad() {
		const hash = window.location.hash.slice(1);
		const lane = reviewRoomHistoryLaneFromHash(hash);
		if (lane) {
			showAskHistoryLane(lane, { skipHash: true });
			showTabContent("asks");
			return;
		}
		if (hash && hash !== DEFAULT_TAB && document.getElementById(hash)) {
			showTabContent(hash);
		} else {
			showTabContent(DEFAULT_TAB);
		}
	}

	bindAskHistoryPanel();
	window.addEventListener("popstate", handleInitialLoad);
	handleInitialLoad();
</script>
