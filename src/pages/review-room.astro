---
export const prerender = false;
import { getEntry } from "astro:content";
import { db } from "../service/firebase/server";
import Layout from "../layouts/Layout.astro";
import EmailVerifyBanner from "../components/EmailVerifyBanner.astro";
import PostCard from "../components/PostCard.astro";
import "../styles/review-room.css";
import ClockSolid from "../assets/clock-solid.svg?raw";
import SaveSolid from "../assets/save-solid.svg?raw";
import HighlightIcon from "../assets/highlight.svg?raw";
import CheckSolid from "../assets/check.svg?raw";
import QuestionIcon from "../assets/question-mark-circle.svg?raw";
import OverviewIcon from "../assets/unified-view.svg?raw";
import ChevronDown from "../assets/chevron-down.svg?raw";
import type { Highlight } from "../types/notes";
import { transformId } from "../utils/transformId";
import { verifyUser } from "../middleware/auth";
import { loadUserAskHistory } from "../utils/aiAskHistoryServer";
import {
	formatAskRelativeTime,
	type AiAskSessionEntry,
} from "../utils/aiAskSession";
import { openAskHistoryHref, searchAskHref } from "../utils/aiAskHref";
import { getReferenceSujatoEntry } from "../utils/getContentEntry";
import {
	buildReadableCatalog,
	computeCanonCoverage,
	formatMinutesAgo,
	normalizeDiscourseSlug,
	oldestPending,
	orderAsksForReview,
	type CanonCoverage,
} from "../utils/reviewRoomStats";
import {
	learningDaysFromReadMinutes,
	mergeLearningDays,
	recentLearningDayStrip,
	type LearningDayDot,
} from "../utils/learningActivity";
import {
	loadUserLearningActivity,
	mergeUserLearningActivity,
} from "../utils/learningActivityServer";
import { formatListenStat } from "../utils/listenActivity";
import { loadUserListenActivity } from "../utils/listenActivityServer";

const PIN_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M16 12V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>`;

const sessionCookie = Astro.cookies.get("__session")?.value;
if (!sessionCookie) return Astro.redirect("/signin");

const user = await verifyUser(sessionCookie, { cookies: Astro.cookies }).catch(
	() => null
);

if (!user) {
	return Astro.redirect("/signin");
}

const userDisplayName = user.displayName || user.email || "there"; // Default display name

if (!db) {
	throw new Error("Firestore database is not initialized.");
}

let validHighlights: any[] = [];
let validReadLaterEntries: any[] = [];
let validSavedEntries: any[] = [];
let validReadEntries: any[] = [];
let askEntries: AiAskSessionEntry[] = [];
let coverage: CanonCoverage = { rows: [], totalRead: 0, totalAvailable: 0 };
let learningDays = 0;
let learningDayStrip: LearningDayDot[] = [];
let listenTotalSeconds = 0;
let listenStat: { value: string; label: string } | null = null;
let readPagesMap: Record<string, number> = {};
let oldestReadLater: {
	slug: string;
	title: string;
	waiting: string;
} | null = null;

try {
	// Fetch highlights API, and the single 'pages' documents for readLater, saves, and read
	const [
		highlightsResponse,
		readLaterDoc,
		savedDoc,
		readDoc,
		askHistory,
		loadedLearningSummary,
		loadedListenSummary,
	] = await Promise.all([
		fetch(`${Astro.url.origin}/api/highlights/list`, {
			headers: {
				cookie: `__session=${Astro.cookies.get("__session")?.value || ""}`,
			},
		}),
		db
			.collection("users")
			.doc(user.uid)
			.collection("readLater")
			.doc("pages") // Fetch single doc
			.get(),
		db
			.collection("users")
			.doc(user.uid)
			.collection("saves")
			.doc("pages") // Fetch single doc
			.get(),
		db
			.collection("users")
			.doc(user.uid)
			.collection("read")
			.doc("pages")
			.get(),
		// One capped doc (max 20 entries).
		loadUserAskHistory(user).catch(() => [] as AiAskSessionEntry[]),
		// One summary doc for learning days.
		loadUserLearningActivity(user).catch(() => ({
			days: {} as Record<string, true>,
			dayCount: 0,
		})),
		// One summary doc for listen minutes.
		loadUserListenActivity(user).catch(() => ({
			bySlug: {} as Record<string, number>,
			totalSeconds: 0,
		})),
	]);
	let learningSummary = loadedLearningSummary;
	listenTotalSeconds = loadedListenSummary.totalSeconds;
	listenStat = formatListenStat(listenTotalSeconds);

	// Process highlights
	const { highlights: validHighlightsData } = await highlightsResponse.json();
	validHighlights = validHighlightsData;

	askEntries = orderAsksForReview(askHistory);

	// Progress through each collection — readable union (site + reference).
	readPagesMap = readDoc.exists ? readDoc.data()?.pages || {} : {};
	coverage = computeCanonCoverage(
		Object.keys(readPagesMap),
		buildReadableCatalog(),
	);

	// Backfill from mark-as-read + credit today (signed-in day counts as day 1).
	// Browser visit also reseeds with the reader's local timezone.
	const todayUtc = new Date().toISOString().slice(0, 10);
	const readDayBackfill = learningDaysFromReadMinutes(
		readPagesMap,
		(ms) => new Date(ms).toISOString().slice(0, 10),
	);
	const mergedLearningDays = mergeLearningDays(
		mergeLearningDays(learningSummary.days, readDayBackfill),
		{ [todayUtc]: true },
	);
	if (
		Object.keys(mergedLearningDays).length >
		Object.keys(learningSummary.days).length
	) {
		learningSummary = await mergeUserLearningActivity(
			user,
			mergedLearningDays,
		).catch(() => ({
			days: mergedLearningDays,
			dayCount: Object.keys(mergedLearningDays).length,
		}));
	}
	learningDays = learningSummary.dayCount;
	learningDayStrip = recentLearningDayStrip(learningSummary.days, 28);

	// Process readLater entries from the 'pages' document
	if (readLaterDoc.exists && readLaterDoc.data()?.pages) {
		const readLaterPages = readLaterDoc.data()?.pages || {};
		const readLaterSlugs = Object.keys(readLaterPages);

		const oldest = oldestPending(readLaterPages);
		if (oldest) {
			const slug = normalizeDiscourseSlug(oldest.slug);
			const entry =
				(await getEntry("all", slug).catch(() => null)) ||
				(await getReferenceSujatoEntry(slug).catch(() => null));
			if (entry) {
				oldestReadLater = {
					slug,
					title: entry.data.title || "",
					waiting: formatMinutesAgo(oldest.minutes),
				};
			} else {
				oldestReadLater = {
					slug,
					title: "",
					waiting: formatMinutesAgo(oldest.minutes),
				};
			}
		}

		const readLaterEntries = await Promise.all(
			readLaterSlugs.map(async (slug) => {
				try {
					const entry = await getEntry("all", slug);
					const timestampInMinutes = readLaterPages[slug];
					return entry
						? {
								...entry,
								addedAt: new Date(timestampInMinutes * 60000), // Convert minutes back to Date
								timestamp: timestampInMinutes, // Keep minutes for sorting
							}
						: null;
				} catch {
					return null;
				}
			})
		);
		validReadLaterEntries = readLaterEntries
			.filter(Boolean)
			.sort((a, b) => b.timestamp - a.timestamp); // Sort by timestamp (minutes)
	}

	// Process saved entries from the 'pages' document
	if (savedDoc.exists && savedDoc.data()?.pages) {
		const savedPages = savedDoc.data()?.pages || {};
		const savedSlugs = Object.keys(savedPages);

		const savedEntries = await Promise.all(
			savedSlugs.map(async (slug) => {
				try {
					const entry = await getEntry("all", slug);
					const timestampInMinutes = savedPages[slug];
					return entry
						? {
								...entry,
								savedAt: new Date(timestampInMinutes * 60000), // Convert minutes back to Date
								timestamp: timestampInMinutes, // Keep minutes for sorting
							}
						: null;
				} catch {
					return null;
				}
			})
		);
		validSavedEntries = savedEntries
			.filter(Boolean)
			.sort((a, b) => b.timestamp - a.timestamp); // Sort by timestamp (minutes)
	}

	// Process read entries
	if (readDoc.exists && readDoc.data()?.pages) {
		const readPages = readDoc.data()?.pages || {};
		const readSlugs = Object.keys(readPages);

		const readEntries = await Promise.all(
			readSlugs.map(async (slug) => {
				try {
					const entry = await getEntry("all", slug);
					const timestampInMinutes = readPages[slug];
					return entry
						? {
								...entry,
								readAt: new Date(timestampInMinutes * 60000), // Convert minutes back to milliseconds
								timestamp: timestampInMinutes, // Keep minutes for sorting
							}
						: null;
				} catch {
					return null;
				}
			})
		);

		validReadEntries = readEntries
			.filter(Boolean)
			.sort((a, b) => b.timestamp - a.timestamp); // Sort by timestamp (minutes)
	}
} catch (error) {
	console.error("Error fetching data concurrently:", error);
}
---

<Layout showAuth={true}>
	<div class="not-prose py-4 px-4 sm:px-6 lg:px-8">
		<div class="max-w-5xl mx-auto" id="dashboard-container">
			{
				!user.emailVerified && (
					<EmailVerifyBanner email={user.email} />
				)
			}
			<!-- Tabs: mobile keeps Overview + Asks; other sections sit in a menu -->
			<div
				class="sticky top-0 z-10 py-2 mb-4"
			>
				<div class="pills-scroll-container relative">
					<nav
						class="pills-scroll flex flex-wrap justify-center gap-2 sm:gap-3 py-1"
						aria-label="Tabs"
					>
						<a
							href="#overview"
							class="tab-pill flex-shrink-0 active"
							data-tab="overview"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={OverviewIcon} />
								Overview
							</span>
						</a>
						<a
							href="#asks"
							class="tab-pill flex-shrink-0"
							data-tab="asks"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={QuestionIcon} />
								Asks
							</span>
						</a>
						<a
							href="#readlater"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="readlater"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={ClockSolid} />
								Read Later
							</span>
						</a>
						<a
							href="#saves"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="saves"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={SaveSolid} />
								Saves
							</span>
						</a>
						<a
							href="#read"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="read"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span class="w-4 h-4" set:html={CheckSolid} />
								Read
							</span>
						</a>
						<a
							href="#highlights"
							class="tab-pill flex-shrink-0 menu-pill"
							data-tab="highlights"
						>
							<span
								class="inline-flex items-center gap-1 sm:gap-2 text-sm sm:text-base"
							>
								<span
									class="w-4 h-4"
									set:html={HighlightIcon}
								/>
								Highlights
							</span>
						</a>
						<div class="more-menu md:hidden relative flex-shrink-0">
							<button
								type="button"
								id="more-menu-btn"
								class="tab-pill"
								aria-haspopup="menu"
								aria-expanded="false"
								aria-controls="more-menu"
								aria-label="More tabs"
							>
								<span
									id="more-menu-face"
									class="inline-flex items-center gap-1 text-sm"
								>
									<span
										id="more-menu-icon"
										class="w-4 h-4"
										set:html={ClockSolid}
									/>
									<span id="more-menu-label">Read Later</span>
								</span>
								<span
									id="more-menu-chevron"
									class="w-3.5 h-3.5 opacity-70"
									set:html={ChevronDown}
								/>
							</button>
							<div
								id="more-menu"
								class="more-menu-panel"
								role="menu"
								hidden
							>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="readlater"
									data-more-option
								>
									<span class="w-4 h-4" set:html={ClockSolid} />
									Read Later
								</button>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="saves"
									data-more-option
								>
									<span class="w-4 h-4" set:html={SaveSolid} />
									Saves
								</button>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="read"
									data-more-option
								>
									<span class="w-4 h-4" set:html={CheckSolid} />
									Read
								</button>
								<button
									type="button"
									role="menuitem"
									class="more-menu-item"
									data-tab="highlights"
									data-more-option
								>
									<span class="w-4 h-4" set:html={HighlightIcon} />
									Highlights
								</button>
							</div>
						</div>
					</nav>
				</div>
			</div>

			<!-- Overview (default tab): greeting + reading stats -->
			<div id="overview" class="tab-content">
				<div
					id="greeting"
					class="text-xl sm:text-2xl font-light mt-6 mb-6 text-center text-gradient-accent"
				>
				</div>

				<section class="overview-stats" aria-label="Your reading">
					{
						(coverage.totalRead > 0 ||
							learningDays > 0 ||
							listenStat) && (
							<div
								class:list={[
									"overview-aggregates",
									{
										"is-single":
											(coverage.totalRead > 0 ? 1 : 0) +
												(learningDays > 0 ? 1 : 0) +
												(listenStat ? 1 : 0) ===
											1,
										"is-triple":
											(coverage.totalRead > 0 ? 1 : 0) +
												(learningDays > 0 ? 1 : 0) +
												(listenStat ? 1 : 0) >=
											3,
									},
								]}
							>
								{learningDays > 0 && (
									<div
										id="learning-days-tile"
										class="stat-tile"
									>
										<span
											class="stat-value"
											id="learning-days-value"
											data-learning-days={learningDays}
										>
											{learningDays}
										</span>
										<span class="stat-label">
											days reading
										</span>
										<div
											id="learning-day-strip"
											class="learning-day-strip"
											aria-label="Reading activity over the last 28 days"
											title="Filled days are days you read"
										>
											{learningDayStrip.map((dot) => (
												<span
													class:list={[
														"learning-day-dot",
														{ active: dot.active },
													]}
													title={dot.key}
													aria-hidden="true"
												>
												</span>
											))}
										</div>
									</div>
								)}
								{coverage.totalRead > 0 && (
									<div
										id="discourses-read-tile"
										class="stat-tile"
									>
										<span
											class="stat-value"
											id="discourses-read-value"
											data-discourses-read={
												coverage.totalRead
											}
										>
											{coverage.totalRead}
										</span>
										<span class="stat-label">
											discourses read
										</span>
									</div>
								)}
								{listenStat && (
									<div
										id="listen-minutes-tile"
										class="stat-tile"
									>
										<span
											class="stat-value"
											id="listen-minutes-value"
											data-listen-seconds={
												listenTotalSeconds
											}
										>
											{listenStat.value}
										</span>
										<span
											class="stat-label"
											id="listen-minutes-label"
										>
											{listenStat.label}
										</span>
									</div>
								)}
							</div>
						)
					}

					<div class="overview-card">
						<div class="overview-head">
							<h2>By collection</h2>
						</div>
						{
							coverage.rows.length > 0 ? (
								<ul class="coverage-list">
									{coverage.rows.map((row) => (
										<li>
											<a
												href={row.href}
												class="coverage-row"
												title={`${row.title}: ${row.read} of ${row.total} readable`}
											>
												<span class="coverage-id">
													<span class="coverage-label">
														{row.label}
													</span>
													<span class="coverage-name">
														{row.title}
													</span>
												</span>
												<span class="coverage-bar">
													<span
														class="coverage-fill"
														style={`width:${row.percent}%`}
													/>
												</span>
												<span class="coverage-count">
													{row.read}
													<span class="coverage-total">
														{" "}
														/ {row.total}
													</span>
												</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<p class="overview-empty overview-empty-in-card">
									Mark discourses as read and your progress through
									each collection will appear here.
								</p>
							)
						}
					</div>
					{
						validReadLaterEntries.length > 0 && (
							<div class="overview-later">
								<p class="overview-line">
									<a href="#readlater" data-tab-link="readlater">
										{validReadLaterEntries.length === 1
											? "1 discourse waiting in Read Later"
											: `${validReadLaterEntries.length} discourses waiting in Read Later`}
									</a>
								</p>
								{oldestReadLater && (
									<p class="overview-line">
										Longest waiting:{" "}
										<a href={`/${oldestReadLater.slug}`}>
											{transformId(oldestReadLater.slug)}
											{oldestReadLater.title
												? ` ${oldestReadLater.title}`
												: ""}
										</a>
										{oldestReadLater.waiting
											? `, added ${oldestReadLater.waiting}.`
											: "."}
									</p>
								)}
							</div>
						)
					}
				</section>
			</div>

			<!-- Tab Content Area -->
			<div id="tab-content-area" class="px-2">
				<div id="asks" class="tab-content hidden">
					<div class="mt-4 ask-panel">
						<a href={searchAskHref()} class="ask-new-btn">
							Ask a new question
						</a>
						{
							askEntries.length === 0 ? (
								<p class="ask-empty">No asks yet.</p>
							) : (
								<>
									<div class="ask-history-heading">
										<p class="ask-history-label">Recent Asks</p>
										<p class="ask-history-hint">
											Older ones drop off · pin to keep
										</p>
									</div>
									<div class="ask-history-list">
										{askEntries.map((entry) => (
											<a
												href={openAskHistoryHref(
													entry.question
												)}
												class:list={[
													"ask-row",
													{ "is-pinned": entry.saved },
												]}
											>
												<div class="ask-row-head">
													<p class="ask-row-q">
														{entry.question}
													</p>
													<span class="ask-row-meta">
														{entry.saved && (
															<span
																class="ask-row-pin"
																title="Pinned"
																aria-label="Pinned"
																set:html={
																	PIN_ICON_SVG
																}
															/>
														)}
														<span class="ask-row-when">
															{formatAskRelativeTime(
																entry.at
															)}
														</span>
													</span>
												</div>
												{entry.summary && (
													<p class="ask-row-summary">
														{entry.summary}
													</p>
												)}
												<p class="ask-row-results">
													{entry.results
														.slice(0, 6)
														.map((hit) =>
															transformId(hit.slug)
														)
														.join(" · ")}
												</p>
											</a>
										))}
									</div>
								</>
							)
						}
					</div>
				</div>

				<div id="highlights" class="tab-content hidden">
					<div class="mt-4 space-y-4">
						{
							validHighlights.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>No highlights found.</p>
								</div>
							) : (
								validHighlights.map((highlight: Highlight) => (
									<div class="highlight-page">
										<div class="flex items-start">
											<div class="min-w-0 pr-4">
												<h2 class="text-base sm:text-lg font-semibold mb-2">
													<a
														href={highlight.slug}
														class="text-gray-500 hover:text-link-color"
													>
														{transformId(
															highlight.slug
																?.replace(
																	/^\//,
																	""
																)
																.split(
																	"?"
																)[0] || ""
														)}
														{highlight.title}
													</a>
												</h2>
												{highlight.description && (
													<p class="text-text line-clamp-2 text-sm">
														{highlight.description}
													</p>
												)}
											</div>
										</div>
										<div class="highlight-content">
											{Object.values(
												highlight.highlightSegments
											)
												.sort(
													(a, b) => a.order - b.order
												)
												.map((segment) => {
													// Remove style attribute from p elements, handling any style content
													const cleanedHTML =
														segment.containerHTML?.replace(
															/<p([^>]*?)style="[^"]*"([^>]*?)>/g,
															"<p$1$2>"
														);
													return (
														<Fragment
															set:html={
																cleanedHTML
															}
														/>
													);
												})}
										</div>
										<p class="text-gray-500 text-xs my-0 text-right">
											Highlighted on{" "}
											{highlight.formattedDate}
										</p>
									</div>
								))
							)
						}
					</div>
				</div>

				<div id="readlater" class="tab-content hidden">
					<div class="mt-4">
						{
							validReadLaterEntries.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>
										No discourses added for later reading.
									</p>
								</div>
							) : (
								<div class="space-y-4">
									{validReadLaterEntries.map((entry) => (
										<PostCard
											id={entry.data.slug}
											title={entry.data.title}
											description={entry.data.description}
											lastUpdated={entry.addedAt}
											dateLabel="Added on"
										/>
									))}
								</div>
							)
						}
					</div>
				</div>

				<div id="saves" class="tab-content hidden">
					<div class="mt-4">
						{
							validSavedEntries.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>No discourses saved yet.</p>
								</div>
							) : (
								<div class="space-y-4">
									{validSavedEntries.map((entry) => (
										<PostCard
											id={entry.data.slug}
											title={entry.data.title}
											description={entry.data.description}
											lastUpdated={entry.savedAt}
											dateLabel="Saved on"
										/>
									))}
								</div>
							)
						}
					</div>
				</div>

				<div id="read" class="tab-content hidden">
					<div class="mt-4">
						{
							validReadEntries.length === 0 ? (
								<div class="text-center py-8 text-gray-500">
									<p>No read discourses yet.</p>
								</div>
							) : (
								<div class="space-y-4">
									{validReadEntries.map((entry) => (
										<PostCard
											id={entry.data.slug}
											title={entry.data.title}
											description={entry.data.description}
											lastUpdated={entry.readAt}
											dateLabel="Read on"
										/>
									))}
								</div>
							)
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script
	type="application/json"
	id="review-room-data"
	set:html={JSON.stringify({
		userDisplayName,
		readPagesMap,
		listenTotalSeconds,
		askCount: askEntries.length,
		askKeys: askEntries.map((entry) =>
			entry.question.replace(/\s+/g, " ").trim().toLowerCase(),
		),
	}).replace(/</g, "\\u003c")}
/>

<script>
	import { syncLearningDaysFromReadPages } from "../utils/learningActivityClient";
	import { recentLearningDayStrip } from "../utils/learningActivity";
	import { formatListenStat } from "../utils/listenActivity";
	import {
		flushListenActivity,
		flushOfflineReadPages,
	} from "../utils/listenActivityClient";
	import {
		normalizeAskQuestionKey,
		readAiAskSession,
		sanitizeAskHistoryEntries,
		writeAiAskSession,
	} from "../utils/aiAskSession";

	const DEFAULT_TAB = "overview";
	/** Tabs that collapse into the mobile More menu. */
	const MORE_TABS = new Set(["readlater", "saves", "read", "highlights"]);
	const DEFAULT_MORE_TAB = "readlater";
	const MORE_LABELS = {
		readlater: "Read Later",
		saves: "Saves",
		read: "Read",
		highlights: "Highlights",
	};
	const ASK_SYNC_FLAG = "review-room-ask-history-synced";

	function renderLearningDayStrip(
		container: HTMLElement | null,
		days: Record<string, true> | null | undefined,
	): void {
		if (!container) return;
		const strip = recentLearningDayStrip(days || {}, 28);
		container.innerHTML = strip
			.map(
				(dot) =>
					`<span class="learning-day-dot${dot.active ? " active" : ""}" title="${dot.key}" aria-hidden="true"></span>`,
			)
			.join("");
	}

	const rawData = document.getElementById("review-room-data")?.textContent;
	let boot: {
		userDisplayName: string;
		readPagesMap: Record<string, unknown>;
		listenTotalSeconds: number;
		askCount: number;
		askKeys: string[];
	} = {
		userDisplayName: "there",
		readPagesMap: {},
		listenTotalSeconds: 0,
		askCount: 0,
		askKeys: [],
	};
	try {
		if (rawData) {
			boot = {
				askCount: 0,
				askKeys: [],
				listenTotalSeconds: 0,
				...JSON.parse(rawData),
			};
		}
	} catch {
		/* keep defaults */
	}

	function syncOverviewAggregateLayout(): void {
		const aggregates = document.querySelector(".overview-aggregates");
		if (!aggregates) return;
		const count = aggregates.querySelectorAll(".stat-tile").length;
		aggregates.classList.toggle("is-single", count === 1);
		aggregates.classList.toggle("is-triple", count >= 3);
	}

	function renderListenStatTile(totalSeconds: number): void {
		const display = formatListenStat(totalSeconds);
		if (!display) return;
		const valueEl = document.getElementById("listen-minutes-value");
		const labelEl = document.getElementById("listen-minutes-label");
		if (valueEl && labelEl) {
			valueEl.textContent = display.value;
			valueEl.dataset.listenSeconds = String(totalSeconds);
			labelEl.textContent = display.label;
			syncOverviewAggregateLayout();
			return;
		}
		const section = document.querySelector(".overview-stats");
		if (!section) return;
		let aggregates = section.querySelector(".overview-aggregates");
		if (!aggregates) {
			aggregates = document.createElement("div");
			aggregates.className = "overview-aggregates";
			const byCollection = section.querySelector(".overview-card");
			if (byCollection) section.insertBefore(aggregates, byCollection);
			else section.prepend(aggregates);
		}
		const tile = document.createElement("div");
		tile.id = "listen-minutes-tile";
		tile.className = "stat-tile";
		tile.innerHTML = `<span class="stat-value" id="listen-minutes-value" data-listen-seconds="${totalSeconds}">${display.value}</span><span class="stat-label" id="listen-minutes-label">${display.label}</span>`;
		aggregates.appendChild(tile);
		syncOverviewAggregateLayout();
	}

	// Merge anonymous / offline listen minutes + any listen-completed reads.
	void Promise.all([flushListenActivity(), flushOfflineReadPages()]).then(
		([result]) => {
			const seconds = Math.max(
				boot.listenTotalSeconds || 0,
				result?.totalSeconds || 0,
			);
			renderListenStatTile(seconds);
		},
	);

	// Backfill from mark-as-read timestamps in the reader's local timezone,
	// then merge any anonymous / offline learning days into the account.
	void syncLearningDaysFromReadPages(boot.readPagesMap).then((result) => {
		if (!result?.signedIn || result.dayCount <= 0) return;
		const valueEl = document.getElementById("learning-days-value");
		if (valueEl) {
			valueEl.textContent = String(result.dayCount);
			valueEl.dataset.learningDays = String(result.dayCount);
			renderLearningDayStrip(
				document.getElementById("learning-day-strip"),
				result.days,
			);
			return;
		}
		// First paint had 0 days — insert the days tile now that sign-in day counted.
		const section = document.querySelector(".overview-stats");
		if (!section) return;
		let aggregates = section.querySelector(".overview-aggregates");
		if (!aggregates) {
			aggregates = document.createElement("div");
			aggregates.className = "overview-aggregates is-single";
			const byCollection = section.querySelector(".overview-card");
			if (byCollection) section.insertBefore(aggregates, byCollection);
			else section.prepend(aggregates);
		}
		const tile = document.createElement("div");
		tile.id = "learning-days-tile";
		tile.className = "stat-tile";
		tile.innerHTML = `<span class="stat-value" id="learning-days-value" data-learning-days="${result.dayCount}">${result.dayCount}</span><span class="stat-label">days reading</span><div id="learning-day-strip" class="learning-day-strip" aria-label="Reading activity over the last 28 days" title="Filled days are days you read"></div>`;
		// Days reading leads; insert before discourses read / listen when present.
		const readTile = document.getElementById("discourses-read-tile");
		const listenTile = document.getElementById("listen-minutes-tile");
		if (readTile) aggregates.insertBefore(tile, readTile);
		else if (listenTile) aggregates.insertBefore(tile, listenTile);
		else aggregates.appendChild(tile);
		renderLearningDayStrip(
			document.getElementById("learning-day-strip"),
			result.days,
		);
		syncOverviewAggregateLayout();
	});

	// Ask history lives in localStorage and Firestore. Review Room only SSR-reads
	// Firestore, so merge local Asks into the account when the tab looks empty
	// or behind (common after a quick ask, or switching Gmail-dot accounts).
	void (async () => {
		try {
			if (sessionStorage.getItem(ASK_SYNC_FLAG) === "1") return;
			const local = readAiAskSession();
			if (local.length === 0) return;
			const response = await fetch("/api/ai/history", {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ action: "sync", entries: local }),
			});
			const data = (await response.json()) as {
				success?: boolean;
				entries?: unknown[];
			};
			if (!response.ok || !data.success || !Array.isArray(data.entries)) {
				return;
			}
			const merged = sanitizeAskHistoryEntries(data.entries);
			writeAiAskSession(merged);
			sessionStorage.setItem(ASK_SYNC_FLAG, "1");
			const known = new Set(boot.askKeys);
			const missingOnPage = merged.some(
				(entry) => !known.has(normalizeAskQuestionKey(entry.question)),
			);
			if (missingOnPage || merged.length !== boot.askCount) {
				window.location.reload();
			}
		} catch {
			/* keep SSR asks */
		}
	})();

	const greetingEl = document.getElementById("greeting");
	if (greetingEl) {
		const hour = new Date().getHours();
		let timeOfDayGreeting;
		if (hour >= 5 && hour < 12) {
			timeOfDayGreeting = "Good morning";
		} else if (hour >= 12 && hour < 18) {
			timeOfDayGreeting = "Good afternoon";
		} else {
			timeOfDayGreeting = "Good evening";
		}
		greetingEl.textContent = `${timeOfDayGreeting}, ${boot.userDisplayName || "there"}.`;
	}

	const tabLinks = document.querySelectorAll(".tab-pill[data-tab]");
	const tabContents = document.querySelectorAll(".tab-content");
	const moreMenuBtn = document.getElementById("more-menu-btn");
	const moreMenu = document.getElementById("more-menu");
	const moreMenuLabel = document.getElementById("more-menu-label");
	const moreMenuIcon = document.getElementById("more-menu-icon");
	const moreOptions = document.querySelectorAll("[data-more-option]");
	const moreIconHtml = {
		readlater: "",
		saves: "",
		read: "",
		highlights: "",
	};
	moreOptions.forEach((option) => {
		const tabId = option.getAttribute("data-tab");
		const icon = option.querySelector(".w-4");
		if (tabId && icon && tabId in moreIconHtml) {
			moreIconHtml[tabId] = icon.innerHTML;
		}
	});

	function closeMoreMenu() {
		if (!moreMenu || !moreMenuBtn) return;
		moreMenu.hidden = true;
		moreMenuBtn.setAttribute("aria-expanded", "false");
	}

	function openMoreMenu() {
		if (!moreMenu || !moreMenuBtn) return;
		moreMenu.hidden = false;
		moreMenuBtn.setAttribute("aria-expanded", "true");
	}

	function syncMoreMenu(activeTabId) {
		const isMore = MORE_TABS.has(activeTabId);
		const faceTab = isMore ? activeTabId : DEFAULT_MORE_TAB;
		moreMenuBtn?.classList.toggle("active", isMore);
		if (moreMenuLabel) {
			moreMenuLabel.textContent =
				MORE_LABELS[faceTab] || MORE_LABELS[DEFAULT_MORE_TAB];
		}
		if (moreMenuIcon && moreIconHtml[faceTab]) {
			moreMenuIcon.innerHTML = moreIconHtml[faceTab];
		}
		moreOptions.forEach((option) => {
			option.classList.toggle(
				"active",
				option.getAttribute("data-tab") === activeTabId,
			);
		});
	}

	function showTabContent(tabId) {
		const nextTab = tabId && document.getElementById(tabId) ? tabId : DEFAULT_TAB;
		const targetContent = document.getElementById(nextTab);
		const targetLink = document.querySelector(
			`.tab-pill[data-tab="${nextTab}"]`,
		);
		if (!targetContent || !targetLink) return;

		tabContents.forEach((content) => content.classList.add("hidden"));
		tabLinks.forEach((link) => link.classList.remove("active"));
		targetContent.classList.remove("hidden");
		targetLink.classList.add("active");
		syncMoreMenu(nextTab);
		closeMoreMenu();

		const url =
			nextTab === DEFAULT_TAB
				? window.location.pathname + window.location.search
				: `#${nextTab}`;
		history.replaceState(null, "", url);
	}

	tabLinks.forEach((link) => {
		link.addEventListener("click", (e) => {
			e.preventDefault();
			const tabId = link.getAttribute("data-tab");
			if (link.classList.contains("active")) {
				// Already here — Overview is the way home; no toggle-off.
				closeMoreMenu();
				return;
			}
			showTabContent(tabId);
		});
	});

	moreMenuBtn?.addEventListener("click", (e) => {
		e.preventDefault();
		e.stopPropagation();
		if (!moreMenu) return;
		if (moreMenu.hidden) openMoreMenu();
		else closeMoreMenu();
	});

	moreOptions.forEach((option) => {
		option.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();
			const tabId = option.getAttribute("data-tab");
			const pill = document.querySelector(`.tab-pill[data-tab="${tabId}"]`);
			if (pill?.classList.contains("active")) {
				closeMoreMenu();
				return;
			}
			showTabContent(tabId);
		});
	});

	document.addEventListener("click", (e) => {
		const menuRoot = document.querySelector(".more-menu");
		if (!menuRoot || !(e.target instanceof Node)) return;
		if (!menuRoot.contains(e.target)) closeMoreMenu();
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") closeMoreMenu();
	});

	document.querySelectorAll("[data-tab-link]").forEach((link) => {
		link.addEventListener("click", (e) => {
			e.preventDefault();
			showTabContent(link.getAttribute("data-tab-link"));
		});
	});

	function handleInitialLoad() {
		const hash = window.location.hash.slice(1);
		if (hash && hash !== DEFAULT_TAB && document.getElementById(hash)) {
			showTabContent(hash);
		} else {
			showTabContent(DEFAULT_TAB);
		}
	}

	window.addEventListener("popstate", handleInitialLoad);
	handleInitialLoad();
</script>
