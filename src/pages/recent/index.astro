---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { loadRecentlyAddedFeed } from "../../utils/loadRecentlyAddedFeed";
import {
	collectionChipLabel,
	filterRecentDiscourses,
	parseRecentFilters,
	recentSummary,
	RECENT_COLLECTIONS,
	type RecentDiscourseItem,
} from "../../utils/recentDiscourses";

const feed = await loadRecentlyAddedFeed();
const initialFilters = parseRecentFilters(Astro.url.searchParams);
const initialItems = filterRecentDiscourses(feed, initialFilters);
const initialVisible = new Set(initialItems.map((item) => item.slug));
const collectionsInFeed = RECENT_COLLECTIONS.filter((collection) =>
	feed.some((item) => item.collection === collection),
);
const initialSummary = recentSummary(initialItems.length, initialFilters);

function cardDate(item: RecentDiscourseItem): string {
	return item.added;
}
---

<Layout
	seoTitle="Recently Added Discourses - Words of the Buddha"
	seoDescription="Newly translated English suttas added to the site, with filters by collection and recency."
	showAuth={false}
>
	<main class="container mx-auto px-3 sm:px-4 pt-8 pb-16">
		<section class="max-w-4xl mx-auto px-1 mb-8">
			<h1
				class="text-2xl sm:text-4xl font-bold tracking-tight mb-3 text-gradient-accent"
				style="font-family:'Spectral', serif;"
			>
				Recently added
			</h1>
			<p class="text-base sm:text-lg mb-0" style="color:var(--text-muted);">
				New English translations as they are added to the site.
			</p>
		</section>

		<section
			class="max-w-4xl mx-auto px-1"
			id="recent-feed"
			data-filters={JSON.stringify(initialFilters)}
		>
			<div class="recent-toolbar" role="search">
				<div class="recent-filter-row">
					<p class="recent-filter-label" id="recent-range-label">When</p>
					<div
						class="recent-chips"
						role="group"
						aria-labelledby="recent-range-label"
					>
						<button
							type="button"
							class="recent-chip"
							data-filter="range"
							data-value="20"
							aria-pressed={initialFilters.range === "20"}
						>
							Last 20
						</button>
						<button
							type="button"
							class="recent-chip"
							data-filter="range"
							data-value="30d"
							aria-pressed={initialFilters.range === "30d"}
						>
							30 days
						</button>
						<button
							type="button"
							class="recent-chip"
							data-filter="range"
							data-value="90d"
							aria-pressed={initialFilters.range === "90d"}
						>
							90 days
						</button>
					</div>
				</div>
				<div class="recent-filter-row">
					<p class="recent-filter-label" id="recent-col-label">
						Collection
					</p>
					<div
						class="recent-chips recent-chips--wrap"
						role="group"
						aria-labelledby="recent-col-label"
					>
						<button
							type="button"
							class="recent-chip"
							data-filter="collection"
							data-value="all"
							aria-pressed={initialFilters.collection === "all"}
						>
							All
						</button>
						{
							collectionsInFeed.map((collection) => (
								<button
									type="button"
									class="recent-chip"
									data-filter="collection"
									data-value={collection}
									aria-pressed={
										initialFilters.collection === collection
									}
								>
									{collectionChipLabel(collection)}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<p class="recent-summary" id="recent-summary" aria-live="polite">
				{initialSummary}
			</p>

			<div id="recent-list">
				{
					feed.map((item) => (
						<div
							class="recent-card-wrap"
							data-recent-item
							data-collection={item.collection}
							data-added={item.added}
							data-slug={item.slug}
							hidden={!initialVisible.has(item.slug)}
						>
							<PostCard
								title={item.title}
								description={item.description}
								id={item.slug}
								volpage={item.volpage}
								lastUpdated={cardDate(item)}
								badge="new"
							/>
						</div>
					))
				}
			</div>

			<p
				class="recent-empty"
				id="recent-empty"
				hidden={initialItems.length > 0}
			>
				No discourses match these filters.
			</p>
		</section>
	</main>
</Layout>

<script>
	import {
		DEFAULT_RECENT_FILTERS,
		filterRecentDiscourses,
		parseRecentFilters,
		recentSummary,
		type RecentDiscourseItem,
		type RecentFilters,
	} from "../../utils/recentDiscourses";

	function applyFilters(root: HTMLElement, filters: RecentFilters) {
		const cards = [
			...root.querySelectorAll<HTMLElement>("[data-recent-item]"),
		];
		const items: RecentDiscourseItem[] = cards.map((card) => ({
			slug: card.dataset.slug ?? "",
			title: "",
			description: "",
			collection: card.dataset.collection ?? "",
			added: card.dataset.added ?? "",
		}));
		const visible = filterRecentDiscourses(items, filters);
		const visibleSlugs = new Set(visible.map((item) => item.slug));
		const list = root.querySelector("#recent-list");
		for (const card of cards) {
			card.hidden = !visibleSlugs.has(card.dataset.slug ?? "");
		}
		if (list) {
			for (const item of visible) {
				const card = cards.find((el) => el.dataset.slug === item.slug);
				if (card) list.appendChild(card);
			}
		}
		const summary = root.querySelector("#recent-summary");
		if (summary) summary.textContent = recentSummary(visible.length, filters);
		const empty = root.querySelector("#recent-empty");
		if (empty) empty.toggleAttribute("hidden", visible.length > 0);

		root.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach(
			(button) => {
				const key = button.dataset.filter as keyof RecentFilters | undefined;
				if (!key) return;
				button.setAttribute(
					"aria-pressed",
					String(filters[key] === button.dataset.value),
				);
			},
		);
		root.dataset.filters = JSON.stringify(filters);
	}

	function writeUrl(filters: RecentFilters) {
		const params = new URLSearchParams();
		if (filters.range !== DEFAULT_RECENT_FILTERS.range)
			params.set("range", filters.range);
		if (filters.collection !== DEFAULT_RECENT_FILTERS.collection)
			params.set("col", filters.collection);
		const qs = params.toString();
		const next = qs
			? `${window.location.pathname}?${qs}`
			: window.location.pathname;
		window.history.replaceState({}, "", next);
	}

	function init() {
		const root = document.getElementById("recent-feed");
		if (!root) return;
		const filters = parseRecentFilters(
			new URL(window.location.href).searchParams,
		);
		applyFilters(root, filters);
		if (root.dataset.bound === "1") return;
		root.dataset.bound = "1";

		root.addEventListener("click", (event) => {
			const button = (event.target as HTMLElement | null)?.closest(
				"[data-filter]",
			) as HTMLButtonElement | null;
			if (!button || !root.contains(button)) return;
			const key = button.dataset.filter as keyof RecentFilters | undefined;
			const value = button.dataset.value;
			if (!key || !value) return;
			const next = {
				...parseRecentFilters(new URL(window.location.href).searchParams),
				[key]: value,
			} as RecentFilters;
			writeUrl(next);
			applyFilters(root, next);
		});
	}

	document.addEventListener("DOMContentLoaded", init);
	document.addEventListener("astro:page-load", init);
</script>

<style>
	.recent-toolbar {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
	}
	.recent-filter-row {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	@media (min-width: 640px) {
		.recent-filter-row {
			flex-direction: row;
			align-items: center;
			gap: 0.85rem;
		}
	}
	.recent-filter-label {
		margin: 0;
		min-width: 6.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.recent-chips {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.45rem;
		overflow-x: auto;
		padding-bottom: 0.15rem;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.recent-chips::-webkit-scrollbar {
		display: none;
	}
	.recent-chips--wrap {
		flex-wrap: wrap;
		overflow: visible;
	}
	.recent-chip {
		flex: 0 0 auto;
		padding: 0.35rem 0.8rem;
		border-radius: 9999px;
		border: 1px solid var(--surface-border);
		background: transparent;
		color: var(--surface-ink);
		font-size: 0.875rem;
		line-height: 1.3;
		cursor: pointer;
	}
	.recent-chip:hover {
		background: color-mix(in srgb, var(--surface-ink) 6%, transparent);
	}
	.recent-chip[aria-pressed="true"] {
		background: var(--primary-color);
		border-color: transparent;
		color: #fff;
	}
	.recent-summary {
		margin: 0 0 0.25rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.recent-empty {
		margin-top: 2rem;
		color: var(--text-muted);
	}
	.recent-card-wrap[hidden] {
		display: none;
	}
</style>
