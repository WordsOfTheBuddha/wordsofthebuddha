---
import DailyQuote from "../components/DailyQuote.astro";
import Layout from "../layouts/Layout.astro";

const layoutProps = {
	seoTitle: "Buddha Quotes — Daily Passages from the Suttas",
	seoDescription:
		"Buddha quotes drawn from the early suttas, one passage a day, in English with the Pāli beside it.",
	showAuth: false,
	showPali: false,
	showReadLater: false,
	showSave: false,
	showRead: false,
	showFilter: false,
};
---

<Layout {...layoutProps}>
	<DailyQuote variant="full" />
</Layout>
