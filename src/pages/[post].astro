---
// Root-level post URLs (/fire, /mindfulness, etc.) rendered from src/pages/posts/*.
// A post claims /:slug even when a quality/topic uses the same name; the
// catalog page stays at /on/:slug. Direct Astro.rewrite to /posts/:slug fails
// under the Node/PWA adapter during prerender ("unable to find a component
// instance"), so we render the MD/MDX module here instead.
export const prerender = true;

import PostLayout from "../layouts/PostLayout.astro";
import { routes } from "../utils/routes";

type PostModule = {
	default?: any;
	Content?: any;
	frontmatter?: Record<string, unknown> & { draft?: boolean };
};

export async function getStaticPaths() {
	// Astro extracts getStaticPaths into an isolated module — keep all logic
	// self-contained (no outer helper refs). Mirror rootPostSlugs.ts:
	// -draft/-testcases filenames are excluded; frontmatter draft is not
	// (PostLayout shows a Draft badge; sitemap still omits unpublished posts).
	const postModules = import.meta.glob<PostModule>("./posts/*.{md,mdx}", {
		eager: true,
	});
	const discourseSet = new Set(routes);
	const paths: { params: { post: string }; props: { filePath: string } }[] =
		[];
	for (const [filePath] of Object.entries(postModules)) {
		const slug = filePath.replace("./posts/", "").replace(/\.mdx?$/, "");
		if (/-draft$/.test(slug) || /-testcases$/.test(slug)) continue;
		if (discourseSet.has(slug)) continue;
		paths.push({ params: { post: slug }, props: { filePath } });
	}
	return paths;
}

const { post } = Astro.params;
const { filePath } = Astro.props as { filePath?: string };
if (!post || !filePath) {
	return new Response(null, { status: 404 });
}

const loaders = import.meta.glob<PostModule>("./posts/*.{md,mdx}");
const loader = loaders[filePath];
if (!loader) {
	return new Response(null, { status: 404 });
}
const mod = await loader();
if (/-draft$/.test(post) || /-testcases$/.test(post)) {
	return new Response(null, { status: 404 });
}

const Content = mod.Content ?? mod.default;
const { layout, ...frontmatter } = mod.frontmatter || {};
// MDX `layout:` already wraps Content in PostLayout. Re-wrapping here doubles
// the chrome (navbar, title, image) — which is what broke /fire locally.
const alreadyWrapped = typeof layout === "string" && layout.length > 0;
---

{
	alreadyWrapped ? (
		<Content />
	) : (
		<PostLayout {...frontmatter}>
			<Content />
		</PostLayout>
	)
}
