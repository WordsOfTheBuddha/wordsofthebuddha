---
export const prerender = false;
import {
	getAllTopics,
	findTopicByRedirect,
	loadTopic,
} from "../../utils/loadTopics";

const { slug } = Astro.params;
if (!slug || Array.isArray(slug)) {
	return Astro.redirect("/topic");
}

let actualSlug = slug;
const allTopics = getAllTopics();
let topic = allTopics[slug] ? loadTopic(slug) : null;

if (!topic) {
	const topicSlug = findTopicByRedirect(slug);
	if (topicSlug) {
		actualSlug = topicSlug;
		topic = loadTopic(topicSlug);
	}
}

if (!topic) {
	return Astro.redirect("/topic");
}

return Astro.redirect(`/on/${actualSlug}`, 301);
---
