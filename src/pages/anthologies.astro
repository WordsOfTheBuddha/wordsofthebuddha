---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import BookCard from "../components/BookCard.astro";
import { getPublishedAnthologies } from "../utils/anthologies";

const sortedPosts = await getPublishedAnthologies();
---

<Layout seoTitle="Anthologies" description="A curated collection of discourses from the Pāli Canon" showAuth={true}>
	<main class="container">
		<div class="posts-grid">
			{
				sortedPosts.map((post: (typeof sortedPosts)[0]) => (
					<BookCard
						title={post.data.title}
						description={post.data.description}
						summary={post.data.summary}
						imagePath={post.data.imagePath}
						author={post.data.author}
						slug={post.data.slug}
					/>
				))
			}
		</div>
	</main>
</Layout>
