---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { verifyUser } from "../../middleware/auth";
import { db, isFirebaseInitialized } from "../../service/firebase/server";
import { isAskAdminEmail } from "../../utils/aiAskAdmin";
import {
	askAdminHref,
	filterAskAdminRows,
	filterAskUserReviewRows,
	loadAskTelemetryInbox,
	parseAskAdminQuery,
	summarizeAskAdminRows,
	type AskAdminQuery,
	type AskAdminRow,
	type AskAdminUserReviewRow,
} from "../../utils/aiAskTelemetryQuery";
import { formatDiscourseTitle } from "../../utils/discourseSort";
import { readIndexFromDisk } from "../../utils/loadSearchIndexData.server";

const session = Astro.cookies.get("__session")?.value;
const user = await verifyUser(session, { cookies: Astro.cookies });
const email = user?.email || null;

if (!user || !isAskAdminEmail(email)) {
	if (!user) {
		return Astro.redirect(`/signin?returnTo=${encodeURIComponent("/admin/ask")}`);
	}
	return new Response("Forbidden", { status: 403, statusText: "Forbidden" });
}

const query = parseAskAdminQuery(Astro.url.searchParams);
let rows: AskAdminRow[] = [];
let userReviews: AskAdminUserReviewRow[] = [];
let loadError = "";
if (!isFirebaseInitialized || !db) {
	loadError = "Firebase Admin is not configured, so Ask telemetry cannot be loaded.";
} else {
	try {
		const inbox = await loadAskTelemetryInbox(db, 400);
		rows = inbox.rows;
		userReviews = inbox.userReviews;
	} catch (error) {
		console.error("[admin/ask]", error);
		loadError =
			"Could not load askTelemetry. If this is the first time, wait for a few Asks, or create a Firestore index on createdAt.";
	}
}

const summary = summarizeAskAdminRows(rows, userReviews);
const visible = filterAskAdminRows(rows, query);
const visibleNotes = filterAskUserReviewRows(userReviews, query.since);

type DiscourseMeta = { title: string; description: string };
const discourseMeta = new Map<string, DiscourseMeta>();
try {
	const metaDocs = (await readIndexFromDisk("search-meta.json")) || [];
	for (const doc of metaDocs) {
		if (!doc?.slug) continue;
		discourseMeta.set(doc.slug, {
			title: typeof doc.title === "string" ? doc.title : "",
			description: typeof doc.description === "string" ? doc.description : "",
		});
	}
} catch (error) {
	console.warn("[admin/ask] search-meta lookup unavailable", error);
}

function relativeTime(iso: string | null): string {
	if (!iso) return "—";
	const ms = Date.now() - new Date(iso).getTime();
	if (!Number.isFinite(ms) || ms < 0) return iso.slice(0, 16).replace("T", " ");
	const mins = Math.round(ms / 60000);
	if (mins < 1) return "just now";
	if (mins < 60) return `${mins}m ago`;
	const hours = Math.round(mins / 60);
	if (hours < 48) return `${hours}h ago`;
	const days = Math.round(hours / 24);
	return `${days}d ago`;
}

function shortModel(model: string): string {
	if (!model) return "";
	const base = model.replace(/:free$/i, "");
	const leaf = base.split("/").pop() || base;
	return leaf.length > 36 ? `${leaf.slice(0, 34)}…` : leaf;
}

function hrefFor(patch: Partial<AskAdminQuery>): string {
	return askAdminHref({ ...query, ...patch });
}

function discourseFor(slug: string): { id: string; title: string; description: string } {
	const meta = discourseMeta.get(slug);
	return {
		id: formatDiscourseTitle(slug),
		title: meta?.title || formatDiscourseTitle(slug),
		description: meta?.description || "",
	};
}
---

<Layout
	title=""
	seoTitle="Ask inbox"
	robots="noindex, nofollow"
	showAuth={true}
	showSearch={false}
>
	<main
		class="admin-ask container mx-auto px-3 sm:px-4 py-6 max-w-3xl"
		data-admin-ask
		data-status={query.status}
		data-view={query.view}
	>
		<header class="admin-ask-header">
			<div class="admin-ask-heading">
				<h1 class="admin-ask-title">Ask inbox</h1>
				{
					email && (
						<p class="admin-ask-meta" title={`Signed in as ${email}`}>
							{email}
						</p>
					)
				}
			</div>
			<p class="admin-ask-lead">
				Mark reviewed to clear the default inbox. Written notes are +5 Ask feedback.
			</p>
		</header>

		{
			loadError ? (
				<p class="admin-ask-error">{loadError}</p>
			) : (
				<>
					<section class="admin-ask-stats" aria-label="Summary">
						<div class="admin-ask-stat">
							<strong data-stat="needsReview">{summary.needsReview}</strong>
							<span>Needs review</span>
						</div>
						<div class="admin-ask-stat">
							<strong data-stat="down">{summary.down}</strong>
							<span>Not helpful</span>
						</div>
						<div class="admin-ask-stat">
							<strong data-stat="up">{summary.up}</strong>
							<span>Helpful</span>
						</div>
						<div class="admin-ask-stat">
							<strong data-stat="totalAsks">{summary.totalAsks}</strong>
							<span>Loaded asks</span>
						</div>
						<div class="admin-ask-stat">
							<strong data-stat="userReviews">{summary.userReviews}</strong>
							<span>Written notes</span>
						</div>
					</section>

					<section class="admin-ask-toolbar" aria-label="Filters">
						<div class="admin-ask-toolbar-row">
							<nav class="admin-ask-filters" aria-label="Inbox view">
								<a
									class:list={["admin-ask-filter", query.view === "asks" && "is-active"]}
									href={hrefFor({ view: "asks" })}
								>
									Asks
								</a>
								<a
									class:list={["admin-ask-filter", query.view === "notes" && "is-active"]}
									href={hrefFor({ view: "notes" })}
								>
									Written notes
								</a>
							</nav>
							<label class="admin-ask-select">
								<span class="sr-only">Date range</span>
								<select data-admin-nav aria-label="Date range">
									<option value={hrefFor({ since: "24h" })} selected={query.since === "24h"}>
										Last 24 hours
									</option>
									<option value={hrefFor({ since: "7d" })} selected={query.since === "7d"}>
										Last 7 days
									</option>
									<option value={hrefFor({ since: "30d" })} selected={query.since === "30d"}>
										Last 30 days
									</option>
									<option value={hrefFor({ since: "all" })} selected={query.since === "all"}>
										All time
									</option>
								</select>
							</label>
						</div>
						{
							query.view === "asks" && (
								<div class="admin-ask-toolbar-row">
									<label class="admin-ask-select">
										<span class="sr-only">Review status</span>
										<select data-admin-nav aria-label="Review status">
											<option
												value={hrefFor({ status: "needs" })}
												selected={query.status === "needs"}
											>
												Needs review
											</option>
											<option
												value={hrefFor({ status: "reviewed" })}
												selected={query.status === "reviewed"}
											>
												Reviewed
											</option>
											<option
												value={hrefFor({ status: "all" })}
												selected={query.status === "all"}
											>
												All status
											</option>
										</select>
									</label>
									<label class="admin-ask-select">
										<span class="sr-only">Rating</span>
										<select data-admin-nav aria-label="Rating">
											<option
												value={hrefFor({ rating: "all" })}
												selected={query.rating === "all"}
											>
												Any rating
											</option>
											<option
												value={hrefFor({ rating: "down" })}
												selected={query.rating === "down"}
											>
												Not helpful
											</option>
											<option
												value={hrefFor({ rating: "up" })}
												selected={query.rating === "up"}
											>
												Helpful
											</option>
											<option
												value={hrefFor({ rating: "none" })}
												selected={query.rating === "none"}
											>
												No rating
											</option>
										</select>
									</label>
								</div>
							)
						}
					</section>

					<p class="admin-ask-count" data-admin-count>
						<span data-shown-count>
							{query.view === "notes" ? visibleNotes.length : visible.length}
						</span>{" "}
						shown
						{query.view === "asks" && query.status === "needs" ? " · inbox" : ""}
						{query.view === "notes" ? " · written notes" : ""}
						{query.since !== "all" ? ` · ${query.since}` : ""}
					</p>

					{
						query.view === "notes" ? (
							visibleNotes.length === 0 ? (
								<p class="admin-ask-empty">
									No written notes in this range. Notes appear when a signed-in user
									submits the halfway “Help us improve Ask” prompt.
								</p>
							) : (
								<ul class="admin-ask-list">
									{visibleNotes.map((note) => (
										<li class="admin-ask-card">
											<div class="admin-ask-card-top">
												<p class="admin-ask-question">
													{note.email || "Signed-in user"}
												</p>
												<div class="admin-ask-badges">
													<span class="admin-ask-badge is-reviewed">+5 Asks</span>
													<span class="admin-ask-when" title={note.createdAt || ""}>
														{relativeTime(note.createdAt)}
													</span>
												</div>
											</div>
											<p class="admin-ask-summary">{note.text}</p>
											<p class="admin-ask-foot">
												{note.day ? `Day ${note.day}` : ""}
												{note.uid ? ` · ${note.uid.slice(0, 8)}…` : ""}
											</p>
										</li>
									))}
								</ul>
							)
						) : visible.length === 0 ? (
							<p class="admin-ask-empty">
								Nothing in this view. Try All status, widen the date range, or wait for new Asks.
							</p>
						) : (
							<ul class="admin-ask-list">
								{visible.map((row) => (
									<li class="admin-ask-card" data-request-id={row.requestId}>
										<div class="admin-ask-card-top">
											<p class="admin-ask-question">{row.question || "(empty question)"}</p>
											<div class="admin-ask-badges">
												{
													row.rating === "up" ? (
														<span class="admin-ask-badge is-up">👍</span>
													) : row.rating === "down" ? (
														<span class="admin-ask-badge is-down">👎</span>
													) : (
														<span class="admin-ask-badge">Unrated</span>
													)
												}
												{
													row.reviewed ? (
														<span class="admin-ask-badge is-reviewed">Reviewed</span>
													) : (
														<span class="admin-ask-badge is-needs">Needs review</span>
													)
												}
												<span class="admin-ask-when" title={row.askedAt || ""}>
													{relativeTime(row.askedAt)}
												</span>
											</div>
										</div>
										{
											row.lookingFor && (
												<p class="admin-ask-looking">{row.lookingFor}</p>
											)
										}
										{
											row.summary && (
												<p class="admin-ask-summary">{row.summary}</p>
											)
										}
										{
											row.model && (
												<p class="admin-ask-model" title={row.model}>
													{shortModel(row.model)}
												</p>
											)
										}
										{
											row.reasoning && (
												<details class="admin-ask-reasoning">
													<summary>Model thinking</summary>
													<pre>{row.reasoning}</pre>
												</details>
											)
										}
										{
											row.queries.length > 0 && (
												<div class="admin-ask-chips">
													{row.queries.map((q) => (
														<a class="admin-ask-chip" href={`/search?q=${encodeURIComponent(q)}`}>
															{q}
														</a>
													))}
												</div>
											)
										}
										{
											row.fallbackQueries.length > 0 && (
												<div class="admin-ask-chips is-fallback">
													<span class="admin-ask-fallback-label">Also tried</span>
													{row.fallbackQueries.map((q) => (
														<a class="admin-ask-chip" href={`/search?q=${encodeURIComponent(q)}`}>
															{q}
														</a>
													))}
												</div>
											)
										}
										{
											row.resultSlugs.length > 0 ? (
												<ul class="admin-ask-results">
													{row.resultSlugs.map((slug) => {
														const discourse = discourseFor(slug);
														return (
															<li>
																<a
																	class="admin-ask-result"
																	href={`/${slug}`}
																	aria-label={`${discourse.id}: ${discourse.title}`}
																>
																	<span class="admin-ask-result-id">{discourse.id}</span>
																	<span class="admin-ask-result-popover" role="tooltip">
																		<strong>{discourse.title}</strong>
																		{discourse.description && (
																			<span>{discourse.description}</span>
																		)}
																	</span>
																</a>
															</li>
														);
													})}
												</ul>
											) : (
												<p class="admin-ask-empty-results">No discourse results</p>
											)
										}
										<div class="admin-ask-card-actions">
											<p class="admin-ask-foot" data-admin-foot>
												{row.resultCount} result{row.resultCount === 1 ? "" : "s"}
												{row.ms ? ` · ${Math.round(row.ms / 100) / 10}s` : ""}
												{row.offTopic ? " · off-topic" : ""}
												{row.reviewed && row.reviewedBy
													? ` · reviewed by ${row.reviewedBy}`
													: ""}
											</p>
											<button
												type="button"
												class="admin-ask-review-btn"
												data-admin-review
												data-reviewed={row.reviewed ? "1" : "0"}
												data-request-id={row.requestId}
											>
												{row.reviewed ? "Back to inbox" : "Mark reviewed"}
											</button>
										</div>
									</li>
								))}
							</ul>
						)
					}
				</>
			)
		}
	</main>
</Layout>

<script>
	const root = document.querySelector("[data-admin-ask]");
	if (root) {
		const statusFilter = root.getAttribute("data-status") || "needs";

		root.querySelectorAll("[data-admin-nav]").forEach((select) => {
			select.addEventListener("change", () => {
				const el = select as HTMLSelectElement;
				if (el.value) window.location.assign(el.value);
			});
		});

		function readStat(name: string): number {
			const el = root.querySelector(`[data-stat="${name}"]`);
			const n = Number(el?.textContent || "0");
			return Number.isFinite(n) ? n : 0;
		}

		function writeStat(name: string, value: number): void {
			const el = root.querySelector(`[data-stat="${name}"]`);
			if (el) el.textContent = String(Math.max(0, value));
		}

		function adjustShown(delta: number): void {
			const el = root.querySelector("[data-shown-count]");
			if (!el) return;
			const next = Math.max(0, Number(el.textContent || "0") + delta);
			el.textContent = String(next);
		}

		function setCardReviewed(card: Element, reviewed: boolean): void {
			const badge = card.querySelector(".admin-ask-badge.is-needs, .admin-ask-badge.is-reviewed");
			if (badge) {
				badge.classList.toggle("is-needs", !reviewed);
				badge.classList.toggle("is-reviewed", reviewed);
				badge.textContent = reviewed ? "Reviewed" : "Needs review";
			}
			const button = card.querySelector("[data-admin-review]") as HTMLButtonElement | null;
			if (button) {
				button.setAttribute("data-reviewed", reviewed ? "1" : "0");
				button.textContent = reviewed ? "Back to inbox" : "Mark reviewed";
				button.disabled = false;
			}
		}

		root.querySelectorAll("[data-admin-review]").forEach((button) => {
			button.addEventListener("click", async () => {
				const el = button as HTMLButtonElement;
				const requestId = el.getAttribute("data-request-id") || "";
				const currentlyReviewed = el.getAttribute("data-reviewed") === "1";
				const nextReviewed = !currentlyReviewed;
				if (!requestId || el.disabled) return;
				el.disabled = true;
				try {
					const response = await fetch("/api/ai/admin/review", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							requestId,
							reviewed: nextReviewed,
						}),
					});
					if (!response.ok) {
						el.disabled = false;
						return;
					}
					const card = el.closest(".admin-ask-card");
					writeStat(
						"needsReview",
						readStat("needsReview") + (nextReviewed ? -1 : 1),
					);

					const leaveInbox = statusFilter === "needs" && nextReviewed;
					const leaveReviewed = statusFilter === "reviewed" && !nextReviewed;
					if ((leaveInbox || leaveReviewed) && card) {
						card.remove();
						adjustShown(-1);
						return;
					}
					if (card) setCardReviewed(card, nextReviewed);
					else el.disabled = false;
				} catch {
					el.disabled = false;
				}
			});
		});
	}
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.admin-ask-header {
		margin-bottom: 1rem;
	}
	.admin-ask-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.admin-ask-title {
		font-family: Spectral, serif;
		font-size: clamp(1.6rem, 3vw, 2rem);
		font-weight: 700;
		margin: 0;
	}
	.admin-ask-lead,
	.admin-ask-meta,
	.admin-ask-error,
	.admin-ask-empty,
	.admin-ask-looking,
	.admin-ask-empty-results,
	.admin-ask-foot,
	.admin-ask-count,
	.admin-ask-model {
		color: var(--text-muted);
		margin: 0.25rem 0 0;
	}
	.admin-ask-lead {
		margin-top: 0.35rem;
		font-size: 0.92rem;
		line-height: 1.4;
		max-width: 36rem;
	}
	.admin-ask-meta {
		margin: 0;
		font-size: 0.75rem;
		opacity: 0.75;
		max-width: 16rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.admin-ask-summary {
		margin: 0.55rem 0 0;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--surface-border);
		border-radius: 0.65rem;
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--text-color);
	}
	.admin-ask-count {
		font-size: 0.85rem;
		margin: 0 0 0.85rem;
	}
	.admin-ask-error {
		color: var(--warning-heading, #b45309);
		margin-top: 1rem;
	}
	.admin-ask-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(5.6rem, 1fr));
		gap: 0.6rem;
		margin: 1rem 0;
	}
	.admin-ask-stat {
		border: 1px solid var(--surface-border);
		background: var(--surface-elevated);
		border-radius: 0.75rem;
		padding: 0.75rem 0.65rem;
		text-align: center;
	}
	.admin-ask-stat strong {
		display: block;
		font-size: 1.25rem;
	}
	.admin-ask-stat span {
		color: var(--text-muted);
		font-size: 0.75rem;
	}
	.admin-ask-toolbar {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	.admin-ask-toolbar-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		justify-content: space-between;
	}
	.admin-ask-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.admin-ask-filter {
		text-decoration: none;
		color: var(--text-muted);
		border: 1px solid var(--surface-border);
		border-radius: 999px;
		padding: 0.3rem 0.75rem;
		font-size: 0.85rem;
		background: var(--surface-elevated);
	}
	.admin-ask-filter.is-active {
		color: var(--text-color);
		border-color: var(--primary-color);
		font-weight: 600;
	}
	.admin-ask-select {
		display: inline-flex;
		min-width: 9.5rem;
	}
	.admin-ask-select select {
		width: 100%;
		appearance: none;
		border: 1px solid var(--surface-border);
		border-radius: 999px;
		padding: 0.3rem 1.8rem 0.3rem 0.75rem;
		font-size: 0.85rem;
		color: var(--text-color);
		background:
			linear-gradient(45deg, transparent 50%, var(--text-muted) 50%) calc(100% - 14px) calc(50% - 2px) / 5px 5px no-repeat,
			linear-gradient(135deg, var(--text-muted) 50%, transparent 50%) calc(100% - 9px) calc(50% - 2px) / 5px 5px no-repeat,
			var(--surface-elevated);
		cursor: pointer;
	}
	.admin-ask-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.85rem;
	}
	.admin-ask-card {
		border: 1px solid var(--surface-border);
		background: var(--surface-elevated);
		border-radius: 0.9rem;
		padding: 1rem 1.05rem;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
		overflow: visible;
	}
	.admin-ask-card-top {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		align-items: flex-start;
	}
	.admin-ask-question {
		font-family: Spectral, serif;
		font-size: 1.15rem;
		font-weight: 600;
		margin: 0;
		line-height: 1.35;
	}
	.admin-ask-badges {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.3rem;
		flex-shrink: 0;
	}
	.admin-ask-badge {
		font-size: 0.75rem;
