---
/**
 * Public /ask/:slug entry. Middleware also rewrites here → /shared-ask/:slug so
 * styles load even when the catch-all would otherwise win.
 */
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import AskShareView from "../../components/AskShareView.astro";
import { loadAskShare } from "../../utils/aiAskShareServer";
import { askShareSeo, normalizeAskShareSlug } from "../../utils/aiAskShare";
import "../../styles/global.css";
import "../../styles/ai-mode.css";
import "../../styles/content.css";

const rawSlug = Astro.params.slug || "";
const slug = normalizeAskShareSlug(rawSlug);
const share = slug ? await loadAskShare(slug) : null;

if (!share) {
	return Astro.redirect("/search?mode=ask");
}

const seo = askShareSeo(share);
const seoTitle = seo.title;
const seoDescription = seo.description;
---

<Layout
	title=""
	seoTitle={seoTitle}
	seoDescription={seoDescription}
	showAuth={true}
	showSearch={false}
>
	<AskShareView share={share} />
</Layout>
